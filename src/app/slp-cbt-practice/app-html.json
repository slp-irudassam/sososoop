"<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>언어재활사 CBT 연습</title>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css\">\n<style>\n:root{\n  /* 새 팔레트 · 민트 + 코발트 · 소프트 뉴브루탈리즘(얇은 검정 테두리 · 각진 모서리 · 그림자 없음) */\n  --mint:#12B5A5; --mint-soft:#e1f6f2; --mint-d:#0e9488;\n  --pop:#3B5BDB;  --pop-soft:#e5e9fb; --pop-d:#2f49b0;\n  --ink:#1a1a1a;  --gray:#6b7280;\n  --red:#e0342a;  --amber:#e8931c;\n  --bg:#e9e9e4;   --paper:#fff;\n  --bd:1.5px solid var(--ink);\n  /* ── 레거시 변수명 호환(인라인 스타일 대비) ── */\n  --navy:#1a1a1a; --navy-d:#000; --navy-btn:#3B5BDB;\n  --blue:#3B5BDB; --blue-l:#e5e9fb; --teal:#12B5A5;\n  --line:#1a1a1a; --omr:#12B5A5; --canvas:#fff; --pearl:#f4f4ef;\n  --ink-muted:#6b7280;\n}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{height:100%;}\nbody{font-family:\"Pretendard Variable\",Pretendard,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif;background:var(--paper);color:var(--ink);overflow:hidden;}\nbutton{font-family:inherit;cursor:pointer;}\n.hidden{display:none!important;}\n\n/* ───── 시작(로그인) 화면 ───── */\n#startScreen{height:100vh;display:flex;flex-direction:column;overflow:auto;background:var(--bg);}\n.start-top{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:12px 22px;min-height:64px;border-bottom:var(--bd);flex-shrink:0;}\n.start-top .clockbox{text-align:right;font-size:13px;line-height:1.5;font-weight:600;}\n.login-wrap{max-width:900px;margin:26px auto;background:#fff;border:var(--bd);overflow:hidden;width:94%;flex-shrink:0;}\n.login-title{background:var(--mint);color:#fff;text-align:center;font-size:24px;font-weight:900;padding:15px;border-bottom:var(--bd);}\n.login-body{padding:24px 30px;}\n.login-notice{background:var(--mint-soft);border:var(--bd);text-align:center;padding:15px;font-weight:800;margin-bottom:20px;color:var(--ink);}\n.login-table{display:flex;gap:0;border:var(--bd);}\n.photo-col{width:170px;border-right:var(--bd);display:flex;flex-direction:column;}\n.photo{flex:1;display:flex;align-items:center;justify-content:center;background:#f4f4ef;font-size:60px;color:#b6c0ae;min-height:160px;}\n.seat{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;border-top:var(--bd);}\n.seat-circle{width:82px;height:82px;background:var(--mint);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:900;border:var(--bd);}\n.seat-circle small{font-size:11px;font-weight:700;}\n.seat-circle span{font-size:28px;line-height:1;}\n.info-col{flex:1;}\n.info-row{display:flex;border-bottom:var(--bd);min-height:50px;}\n.info-row:last-child{border-bottom:none;}\n.info-row .th{width:150px;background:#f4f4ef;color:var(--ink);font-weight:800;display:flex;align-items:center;padding-left:16px;border-right:var(--bd);}\n.info-row .td{flex:1;display:flex;align-items:center;padding-left:14px;gap:8px;flex-wrap:wrap;}\n.info-row input[type=text]{border:var(--bd);padding:8px 10px;font-size:15px;width:220px;background:#fff;}\n.info-row input[type=text]::placeholder{color:var(--gray);opacity:.55;}\n.info-row-name{min-height:78px;}\n.info-row-name .td{flex-direction:column;align-items:flex-start;justify-content:center;gap:6px;padding-top:10px;padding-bottom:10px;}\n.name-hint{font-size:12px;color:var(--gray);width:100%;}\n.sess-btn{border:var(--bd);background:#fff;padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.sess-btn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.login-foot{background:#f4f4ef;padding:18px;text-align:center;border-top:var(--bd);}\n.login-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);font-size:19px;font-weight:900;padding:13px 64px;}\n.login-btn:hover{background:var(--pop-d);}\n.start-hint{font-size:12.5px;color:var(--gray);margin-top:10px;line-height:1.6;}\n.disclaimer{font-size:11.5px;color:#9aa08f;margin-top:14px;padding-top:12px;border-top:1px dashed #c9c9bf;line-height:1.6;}\n\n/* ───── 시험 화면 레이아웃 ───── */\n#examScreen{height:100vh;display:flex;flex-direction:column;}\n.exam-header{background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:62px;flex:0 0 62px;border-bottom:var(--bd);}\n.eh-left{display:flex;align-items:center;gap:10px;}\n.seat-mini{width:40px;height:40px;background:var(--mint);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:900;border:var(--bd);}\n.eh-left .who{font-size:12.5px;line-height:1.5;}\n.eh-title{font-size:18px;font-weight:900;position:absolute;left:50%;transform:translateX(-50%);white-space:nowrap;}\n.eh-right{display:flex;align-items:center;gap:12px;}\n.util-label{font-size:11px;text-align:center;line-height:1.2;color:var(--gray);font-weight:700;}\n.font-btns,.layout-btns{display:flex;gap:5px;align-items:flex-end;}\n.fbtn{width:42px;border:var(--bd);background:#fff;color:var(--ink);padding:6px 0 3px;display:flex;flex-direction:column;align-items:center;font-weight:800;}\n.fbtn small{font-size:9px;color:var(--gray);}\n.fbtn.f80{font-size:13px;} .fbtn.f100{font-size:16px;} .fbtn.f125{font-size:19px;}\n.fbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.fbtn.active small{color:#fff;}\n.lbtn{width:38px;height:38px;border:var(--bd);background:#fff;padding:5px;display:flex;gap:3px;}\n.lbtn div{flex:1;background:var(--mint);}\n.lbtn.active{background:var(--pop);border-color:var(--pop);} .lbtn.active div{background:#fff;}\n.divider{width:1.5px;height:36px;background:var(--ink);}\n.timerbox{display:flex;align-items:center;gap:8px;}\n.clock-ic{width:36px;height:36px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;border:var(--bd);}\n.timerbox .txt{font-size:12.5px;line-height:1.5;font-weight:600;}\n.timerbox .remain{color:var(--ink);font-weight:800;}\n.timerbox .remain b{background:var(--red);color:#fff;padding:0 5px;font-size:14px;}\n\n.exam-main{flex:1;display:flex;min-height:0;}\n/* 왼쪽 세로 툴바 */\n.leftbar{flex:0 0 auto;width:158px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;gap:12px;padding:12px 8px;overflow-y:auto;}\n.toolv{border:var(--bd);background:#fff;color:var(--ink);font-weight:800;font-size:13px;padding:10px 4px;display:flex;flex-direction:column;align-items:center;gap:4px;}\n.toolv .tv-ic{font-size:18px;line-height:1;}\n.toolv:hover{background:var(--mint-soft);}\n.toolgroup{border:var(--bd);background:#fff;padding:8px;display:flex;flex-direction:column;gap:6px;align-items:center;}\n.toollabel{font-size:11px;font-weight:800;color:var(--gray);}\n.leftbar .font-btns{gap:4px;} .leftbar .fbtn{width:38px;}\n/* 문제 컬럼 + 상단 진행바 */\n.paper-col{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;}\n.progline{flex:0 0 auto;display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:var(--bd);background:#fff;}\n.prognum{font-weight:800;font-size:13px;white-space:nowrap;color:var(--ink);}\n.progwrap{flex:1;height:12px;border:var(--bd);background:#fff;overflow:hidden;}\n.progbar{height:100%;width:0%;background:var(--pop);transition:width .2s;}\n.paper{flex:1;background:#fff;overflow-y:auto;padding:18px 20px;min-width:0;}\n.paper-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;}\n.paper-grid.one{grid-template-columns:1fr;max-width:820px;margin:0 auto;}\n.qcol{border-right:none;padding-right:0;}\n.paper-grid.one .qcol,.qcol:last-child{border-right:none;padding-right:0;}\n\n.qcard{background:#fff;border:var(--bd);padding:16px 18px 20px;margin-bottom:16px;}\n.qtools{display:flex;flex-direction:column;align-items:flex-end;gap:4px;margin-bottom:6px;}\n.qtools-row{display:flex;gap:6px;}\n.tool-btn{border:var(--bd);background:#fff;color:var(--ink);font-size:12px;padding:4px 10px;font-weight:700;display:flex;align-items:center;gap:4px;}\n.tool-btn.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n.tool-btn.memo-on{background:var(--amber);color:#fff;border-color:var(--amber);}\n.tool-btn.pen-on{background:#e8a400;color:#fff;border-color:#e8a400;}\n.qhead{font-weight:800;font-size:1.05em;display:flex;gap:8px;margin-bottom:10px;line-height:1.55;}\n.qhead .subj{color:#fff;font-size:.78em;font-weight:800;background:var(--mint);padding:3px 10px;align-self:flex-start;margin-top:2px;white-space:nowrap;}\n.stem{border:var(--bd);padding:12px 14px;margin:0 0 12px;line-height:1.7;background:var(--mint-soft);white-space:pre-wrap;}\n.qimg-wrap{margin:0 0 12px;}\n.qimg{max-width:100%;height:auto;border:var(--bd);display:block;}\n.choices{list-style:none;}\n.choices li{display:flex;align-items:flex-start;gap:9px;padding:9px 11px;line-height:1.6;border:var(--bd);margin-bottom:7px;background:#fff;}\n.choices li .num{flex:0 0 auto;width:1.6em;height:1.6em;border:var(--bd);display:flex;align-items:center;justify-content:center;font-size:.85em;font-weight:800;margin-top:.05em;}\n.choices li .ctext{flex:1;cursor:pointer;}\n.choices li:hover{background:#f7f7f2;}\n.choices li.sel{background:var(--pop-soft);border-color:var(--pop);}\n.choices li.sel .num{background:var(--pop);color:#fff;border-color:var(--pop);}\n.choices li.sel .ctext{font-weight:800;}\n.choices li.strike .ctext{color:#b0b0b0;text-decoration:line-through;}\n.choices li.strike .num{border-color:#b0b0b0;color:#b0b0b0;}\n.strike-btn{flex:0 0 auto;border:var(--bd);background:#fff;color:var(--gray);font-size:11px;padding:2px 7px;margin-top:2px;}\n.strike-btn.on{background:var(--ink);color:#fff;border-color:var(--ink);}\n\n/* OMR */\n.omr{flex:0 0 208px;background:#fafafa;border-right:var(--bd);display:flex;flex-direction:column;}\n.omr-tools{display:flex;gap:6px;padding:8px 8px 0;}\n.omr-tools button{flex:1;border:var(--bd);background:#fff;padding:6px 0;font-size:12px;font-weight:800;color:var(--ink);}\n.omr-tools button:hover{background:var(--mint-soft);}\n.omr-title{background:var(--mint);color:#fff;text-align:center;font-weight:900;padding:10px;font-size:15px;flex:0 0 auto;border-bottom:var(--bd);}\n.omr-list{flex:1;overflow-y:auto;padding-bottom:10px;}\n.omr-row{display:flex;align-items:center;padding:4px 6px 4px 4px;}\n.omr-row.sep{border-bottom:1px dashed var(--mint);}\n.omr-row .flags{width:26px;display:flex;flex-direction:column;font-size:10px;line-height:1;gap:1px;align-items:center;color:var(--amber);}\n.omr-row .flags .chk{color:var(--red);}\n.omr-row .no{width:26px;text-align:center;color:var(--ink);font-weight:800;font-size:13px;background:#fff;border:var(--bd);padding:3px 0;margin-right:5px;cursor:pointer;}\n.omr-row.cur .no{background:var(--pop);color:#fff;border-color:var(--pop);}\n.omr-row .bubbles{display:flex;gap:4px;}\n.bub{width:22px;height:22px;border:var(--bd);color:var(--ink);background:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;padding:0;}\n.bub.mark{background:var(--pop);border-color:var(--pop);color:#fff;}\n\n/* 하단바 */\n.exam-footer{background:#f4f4ef;border-top:var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 12px;height:60px;flex:0 0 60px;gap:8px;}\n.ef-group{display:flex;align-items:center;gap:8px;}\n.wbtn{background:#fff;border:var(--bd);padding:9px 15px;font-size:13.5px;font-weight:700;color:var(--ink);}\n.wbtn:hover{background:var(--mint-soft);}\n.wbtn.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.pager{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:800;}\n.pager .pbtn{background:#fff;border:var(--bd);padding:9px 16px;font-size:14px;font-weight:800;color:var(--ink);}\n.pager .pbtn:hover{background:var(--mint-soft);}\n.submit-btn{background:var(--pop);color:#fff;border:var(--bd);border-color:var(--pop);padding:11px 20px;font-size:14px;font-weight:800;}\n.submit-btn:hover{background:var(--pop-d);}\n\n/* 모달 */\n.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:50;}\n.modal{background:#fff;border:var(--bd);min-width:340px;max-width:560px;overflow:hidden;}\n.modal-head{background:var(--red);color:#fff;font-weight:900;text-align:center;padding:12px;position:relative;font-size:16px;border-bottom:var(--bd);}\n.modal-head.blue{background:var(--pop);}\n.modal-head .x{position:absolute;right:10px;top:8px;background:none;border:none;color:#fff;font-size:20px;}\n.modal-body{padding:24px 28px;text-align:center;font-size:15.5px;line-height:1.7;}\n.modal-body .big-clock{width:54px;height:54px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 14px;border:var(--bd);}\n.modal-foot{padding:0 0 20px;text-align:center;display:flex;gap:10px;justify-content:center;}\n.m-btn{border:var(--bd);padding:10px 24px;font-size:14px;font-weight:800;color:#fff;background:var(--red);border-color:var(--red);}\n.m-btn.gray{background:var(--gray);border-color:var(--gray);}\n.m-btn.blue{background:var(--pop);border-color:var(--pop);}\n\n/* 메모/계산기/그림판 */\n.float-win{position:fixed;z-index:60;background:#fff;border:var(--bd);overflow:hidden;}\n.fw-head{background:var(--mint);color:#fff;padding:9px 12px;font-weight:800;cursor:move;display:flex;justify-content:space-between;align-items:center;font-size:14px;border-bottom:var(--bd);}\n.fw-head button{background:none;border:none;color:#fff;font-size:17px;}\n#memoText{width:320px;height:180px;border:none;outline:none;padding:12px;font-size:14px;resize:none;font-family:inherit;}\n.calc-body{padding:10px;width:230px;}\n#calcDisp{width:100%;border:var(--bd);text-align:right;font-size:22px;padding:8px;margin-bottom:8px;font-family:inherit;}\n.calc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;}\n.calc-grid button{padding:11px 0;font-size:16px;border:var(--bd);background:#fff;font-weight:700;}\n.calc-grid button.op{background:var(--mint-soft);font-weight:800;}\n.calc-grid button.eq{background:var(--pop);color:#fff;border-color:var(--pop);grid-column:span 2;}\n#padCanvas{display:block;background:#fff;cursor:crosshair;}\n.pad-tools{display:flex;gap:6px;padding:8px;background:var(--mint-soft);border-bottom:var(--bd);}\n.pad-tools button{border:var(--bd);background:#fff;padding:5px 12px;font-size:13px;font-weight:700;}\n.pad-tools button.on{background:var(--pop);color:#fff;border-color:var(--pop);}\n\n/* 결과 화면 */\n#resultScreen{height:100vh;overflow-y:auto;background:var(--bg);}\n.res-wrap{max-width:860px;margin:26px auto 60px;width:94%;}\n.res-card{background:#fff;border:var(--bd);overflow:hidden;margin-bottom:20px;}\n.res-title{background:var(--mint);color:#fff;font-size:21px;font-weight:900;text-align:center;padding:15px;border-bottom:var(--bd);}\n.res-body{padding:26px 30px;}\n.verdict{text-align:center;font-size:30px;font-weight:900;margin-bottom:6px;}\n.verdict.pass{color:var(--mint-d);} .verdict.fail{color:var(--red);}\n.verdict-sub{text-align:center;color:var(--gray);margin-bottom:20px;font-size:13.5px;line-height:1.6;}\ntable.score{width:100%;border-collapse:collapse;font-size:14.5px;}\ntable.score th,table.score td{border:var(--bd);padding:10px;text-align:center;}\ntable.score th{background:var(--mint-soft);color:var(--ink);font-weight:800;}\ntable.score td.bad{color:var(--red);font-weight:800;}\ntable.score tr.total td{font-weight:900;background:#f4f4ef;}\n.res-actions{display:flex;gap:10px;justify-content:center;margin-top:24px;flex-wrap:wrap;}\n.review-filter{display:flex;gap:8px;justify-content:center;margin-bottom:18px;}\n.rv-card{background:#fff;border:var(--bd);padding:20px 22px;margin-bottom:14px;}\n.rv-card .rv-head{font-weight:800;margin-bottom:8px;line-height:1.6;}\n.rv-badge{display:inline-block;font-size:12px;font-weight:800;padding:2px 8px;margin-right:6px;color:#fff;border:var(--bd);}\n.rv-badge.ok{background:var(--mint-d);border-color:var(--mint-d);} .rv-badge.no{background:var(--red);border-color:var(--red);} .rv-badge.skip{background:var(--gray);border-color:var(--gray);}\n.rv-stem{border:var(--bd);padding:10px 12px;margin-bottom:10px;line-height:1.6;font-size:14px;background:var(--mint-soft);white-space:pre-wrap;}\n.rv-choices{list-style:none;font-size:14.5px;line-height:1.8;margin-bottom:10px;}\n.rv-choices li.correct{color:var(--mint-d);font-weight:800;}\n.rv-choices li.mine{text-decoration:underline;}\n.rv-choices li.mine.wrong{color:var(--red);font-weight:800;}\n.rv-explain{background:var(--mint-soft);border:var(--bd);border-left:5px solid var(--mint);padding:10px 14px;font-size:14px;line-height:1.7;}\n\n/* 문제 보기 모달 */\n.viewer{background:#fff;border:var(--bd);width:95vw;max-width:1120px;height:92vh;display:flex;flex-direction:column;overflow:hidden;}\n.viewer-head{background:var(--mint);color:#fff;font-size:19px;font-weight:900;text-align:center;padding:14px;position:relative;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-head .x{position:absolute;right:14px;top:10px;background:rgba(255,255,255,.25);border:1.5px solid #fff;color:#fff;font-size:18px;width:30px;height:30px;line-height:1;}\n.viewer-guide{padding:9px 20px;font-size:12.5px;color:var(--ink);background:var(--mint-soft);line-height:1.6;flex:0 0 auto;border-bottom:var(--bd);}\n.viewer-tabs{display:flex;flex:0 0 auto;}\n.v-tab{flex:1;padding:12px;font-size:15px;font-weight:800;border:var(--bd);border-top:none;background:#fff;color:var(--ink);}\n.v-tab.active{background:var(--pop);color:#fff;border-color:var(--pop);}\n.viewer-body{flex:1;overflow-y:auto;padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;background:var(--bg);}\n.v-card{border:var(--bd);padding:13px 15px;cursor:pointer;background:#fff;}\n.v-card:hover{outline:2px solid var(--pop);border-color:var(--pop);}\n.v-head{display:flex;gap:8px;font-weight:800;margin-bottom:8px;line-height:1.55;font-size:14.5px;}\n.v-no{flex:0 0 auto;background:var(--pop);color:#fff;min-width:1.7em;height:1.7em;padding:0 .3em;display:flex;align-items:center;justify-content:center;font-size:.9em;border:var(--bd);}\n.v-stem{border:var(--bd);padding:8px 10px;margin-bottom:8px;font-size:12.5px;line-height:1.6;white-space:pre-wrap;background:var(--mint-soft);}\n.v-choices{list-style:none;font-size:13.5px;line-height:1.7;}\n.v-choices li.sel{font-weight:800;color:var(--pop);}\n\n/* 형광펜 */\nmark.hl{background:#ffe94d;color:inherit;padding:0;}\n.wbtn.pen-active{background:#e8a400;color:#fff;border-color:#e8a400;}\n.paper.pen-on .stem,.paper.pen-on .ctext,.paper.pen-on .qhead>span{cursor:text;}\n.paper.pen-on mark.hl{cursor:pointer;}\n@media (max-width:900px){ .eh-title{display:none;} .omr{flex-basis:190px;} }\n@media (max-width:760px){ .viewer-body{grid-template-columns:1fr;} }\n\n/* 인쇄(PDF 저장)용 — 결과 화면의 점수표 + 오답풀이만 출력 */\n#printHeader{display:none;}\n@media print{\n  @page{ margin:14mm; }\n  html,body{ height:auto!important; overflow:visible!important; background:#fff!important; }\n  body *{ visibility:hidden; }\n  #resultScreen, #resultScreen *{ visibility:visible; }\n  #resultScreen{ position:static!important; height:auto!important; overflow:visible!important; background:#fff!important; }\n  .res-wrap{ max-width:100%!important; margin:0!important; width:100%!important; }\n  .res-card, .rv-card{ border:1px solid #444; break-inside:avoid; }\n  .res-actions{ display:none!important; }\n  #printHeader{ display:block; text-align:center; margin-bottom:14px; }\n  #printHeader h1{ font-size:19px; color:#0e9488; }\n  #printHeader .sub{ font-size:12px; color:#555; margin-top:4px; }\n  .rv-card{ page-break-inside:avoid; }\n  .res-title{ background:#12B5A5!important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }\n  .rv-badge, .v-no, table.score th, .omr-title{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }\n}\n/* ── 로그인 게이트 ── */\n#authGate{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:var(--bg);padding:20px;}\n#authGate.hidden{display:none;}\n.ag-card{width:100%;max-width:380px;background:#fff;border:var(--bd);padding:34px 28px 24px;text-align:center;}\n.ag-logo{font-size:38px;line-height:1;}\n.ag-title{font-size:21px;font-weight:900;color:var(--ink);margin-top:10px;}\n.ag-sub{font-size:13px;color:var(--gray);margin-top:6px;line-height:1.5;}\n.ag-form{margin-top:22px;text-align:left;}\n.ag-label{display:block;font-size:12.5px;font-weight:800;color:var(--ink);margin:14px 2px 6px;}\n.ag-form input{width:100%;box-sizing:border-box;padding:12px 13px;border:var(--bd);font-size:15px;background:#fff;outline:none;}\n.ag-form input:focus{border-color:var(--pop);}\n.ag-err{min-height:18px;font-size:12.5px;color:var(--red);margin:10px 2px 0;line-height:1.4;}\n.ag-btn{width:100%;margin-top:8px;padding:13px;border:var(--bd);border-color:var(--mint);background:var(--mint);color:#fff;font-size:16px;font-weight:900;cursor:pointer;}\n.ag-btn:hover{background:var(--mint-d);}\n.ag-btn:disabled{opacity:.6;cursor:default;}\n.ag-note{margin-top:20px;font-size:11.5px;color:var(--gray);line-height:1.6;border-top:var(--bd);padding-top:15px;}\n.logout-btn{border:var(--bd);background:#fff;color:var(--ink);padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;}\n.logout-btn:hover{background:var(--mint-soft);}\n\n</style>\n</head>\n<body>\n\n<!-- ═════════ 시작(로그인) 화면 ═════════ -->\n<!-- ═════════ 로그인 게이트 (베타) ═════════ -->\n<div id=\"authGate\">\n  <div class=\"ag-card\">\n    <div class=\"ag-title\">언어재활사 CBT 연습</div>\n    <div class=\"ag-sub\">베타 테스트 · 발급받은 계정으로 로그인해 주세요</div>\n    <div class=\"ag-form\">\n      <label class=\"ag-label\">아이디</label>\n      <input type=\"text\" id=\"agId\" autocomplete=\"username\" placeholder=\"예: slp01\" spellcheck=\"false\" autocapitalize=\"off\">\n      <label class=\"ag-label\">비밀번호</label>\n      <input type=\"password\" id=\"agPw\" autocomplete=\"current-password\" placeholder=\"비밀번호\" onkeydown=\"if(event.key==='Enter')doLogin()\">\n      <div id=\"agErr\" class=\"ag-err\"></div>\n      <button class=\"ag-btn\" id=\"agBtn\" onclick=\"doLogin()\">로그인</button>\n    </div>\n    <div class=\"ag-note\">※ 계정은 <b>최초 로그인한 기기 1대</b>에서만 사용할 수 있습니다.<br>기기 변경·문의는 관리자에게 연락해 주세요.</div>\n  </div>\n</div>\n\n<div id=\"startScreen\" class=\"hidden\">\n  <div class=\"start-top\">\n    <div style=\"width:140px;\"></div>\n    <div style=\"font-weight:700;font-size:20px;\">언어재활사 CBT 연습</div>\n    <div style=\"display:flex;align-items:center;gap:12px;\">\n      <button id=\"logoutBtn\" class=\"logout-btn\" onclick=\"doLogout()\" title=\"로그아웃\">로그아웃</button>\n    </div>\n  </div>\n  <div class=\"login-wrap\">\n    <div class=\"login-title\">응시 정보 입력</div>\n    <div class=\"login-body\">\n      <div class=\"login-notice\">오늘도 차분하게, 실전처럼 연습해 봐요!</div>\n      <div class=\"login-table\">\n        <div class=\"info-col\">\n          <div class=\"info-row\"><div class=\"th\">시험명</div><div class=\"td\" id=\"stTitle\"></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험일</div><div class=\"td\" id=\"stDate\"></div></div>\n          <div class=\"info-row\" id=\"gradeRow\" style=\"display:none;\"><div class=\"th\">급수</div>\n            <div class=\"td\" id=\"gradeBtns\"></div>\n          </div>\n          <div class=\"info-row\" id=\"setRow\" style=\"display:none;\"><div class=\"th\">회차</div>\n            <div class=\"td\" id=\"setBtns\"></div>\n          </div>\n          <div class=\"info-row\"><div class=\"th\">교시</div>\n            <div class=\"td\" id=\"sessBtns\"></div>\n          </div>\n          <div class=\"info-row info-row-name\"><div class=\"th\">성명</div><div class=\"td\"><input type=\"text\" id=\"inName\" placeholder=\"이루다쌤\"><div class=\"name-hint\">※ 본인의 성명을 입력해 주세요.</div></div></div>\n          <div class=\"info-row\"><div class=\"th\">시험시간</div><div class=\"td\" id=\"stTime\"></div></div>\n        </div>\n      </div>\n      <div class=\"start-hint\">※ 교시를 선택하고 입장하기를 눌러 연습을 시작하세요.<br>※ 14회(2025) 1급 시험의 과목 구성·문항 유형을 따른 창작 연습 문항입니다(실제 기출 아님). 시험시간도 실제와 동일합니다.</div>\n      <div class=\"disclaimer\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n    </div>\n    <div class=\"login-foot\">\n      <button class=\"login-btn\" onclick=\"startExam()\">입장하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 시험 화면 ═════════ -->\n<div id=\"examScreen\" class=\"hidden\">\n  <div class=\"exam-header\" style=\"position:relative;\">\n    <div class=\"eh-left\">\n      <div class=\"eh-title\" id=\"exTitle\" style=\"position:static;transform:none;font-size:18px;\"></div>\n    </div>\n    <div class=\"timerbox\" style=\"position:absolute;left:50%;transform:translateX(-50%);\">\n      <div class=\"clock-ic\">&#128337;</div>\n      <div class=\"txt\">제한시간 : <span id=\"limitMin\"></span>분<br><span class=\"remain\">남은시간 : <b id=\"remainTxt\">--:--</b></span></div>\n    </div>\n    <div class=\"eh-right\">\n      <div class=\"who\" style=\"text-align:right;\">성명 : <span id=\"exName\"></span></div>\n    </div>\n  </div>\n\n  <div class=\"exam-main\">\n    <div class=\"leftbar\">\n      <button class=\"toolv\" onclick=\"toggleCalc()\"><span class=\"tv-ic\">&#128425;</span>계산기</button>\n      <button class=\"toolv\" onclick=\"togglePad()\"><span class=\"tv-ic\">&#9998;</span>그림판</button>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">글자 크기</div>\n        <div class=\"font-btns\">\n          <button class=\"fbtn f80\" data-fs=\"0.85\">가<small>80%</small></button>\n          <button class=\"fbtn f100 active\" data-fs=\"1\">가<small>100%</small></button>\n          <button class=\"fbtn f125\" data-fs=\"1.22\">가<small>125%</small></button>\n        </div>\n      </div>\n      <div class=\"toolgroup\">\n        <div class=\"toollabel\">화면 배치</div>\n        <div class=\"layout-btns\">\n          <button class=\"lbtn active\" id=\"lay1\" title=\"1단 보기\"><div></div></button>\n          <button class=\"lbtn\" id=\"lay2\" title=\"2단 보기\"><div></div><div></div></button>\n        </div>\n      </div>\n    </div>\n    <div class=\"paper-col\">\n      <div class=\"progline\">\n        <span class=\"prognum\" id=\"progText\">0 / 0 문항 풀이</span>\n        <div class=\"progwrap\"><div class=\"progbar\" id=\"progBar\"></div></div>\n      </div>\n      <div class=\"paper\" id=\"paper\">\n        <div class=\"paper-grid\" id=\"paperGrid\"></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"exam-footer\">\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" onclick=\"goHome()\">&#8617; 처음으로</button>\n    </div>\n    <div class=\"pager\">\n      <button class=\"pbtn\" onclick=\"movePage(-1)\">&#9664; 이전</button>\n      <span id=\"pageInfo\">1/1</span>\n      <button class=\"pbtn\" onclick=\"movePage(1)\">다음 &#9654;</button>\n    </div>\n    <div class=\"ef-group\">\n      <button class=\"wbtn\" id=\"fAll\" onclick=\"openProblemViewer('all')\">전체 문제 (<span id=\"cntAll\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fChk\" onclick=\"openProblemViewer('chk')\">체크 문제 (<span id=\"cntChk\">0</span>)</button>\n      <button class=\"wbtn\" id=\"fUn\" onclick=\"openProblemViewer('un')\">안푼 문제 (<span id=\"cntUn\">0</span>)</button>\n      <button class=\"submit-btn\" onclick=\"askSubmit()\">&#128229; 제출하기</button>\n    </div>\n  </div>\n</div>\n\n<!-- ═════════ 결과 화면 ═════════ -->\n<div id=\"resultScreen\" class=\"hidden\">\n  <div class=\"res-wrap\">\n    <div id=\"printHeader\">\n      <h1>언어재활사 CBT 연습 — 오답풀이</h1>\n      <div class=\"sub\" id=\"printMeta\"></div>\n    </div>\n    <div class=\"res-card\">\n      <div class=\"res-title\">시험 결과</div>\n      <div class=\"res-body\">\n        <div class=\"verdict\" id=\"verdict\"></div>\n        <div class=\"verdict-sub\">합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)</div>\n        <table class=\"score\" id=\"scoreTable\"></table>\n        <div class=\"res-actions\">\n          <button class=\"wbtn\" onclick=\"setReviewFilter('wrong')\">틀린 문제만 보기</button>\n          <button class=\"wbtn\" onclick=\"setReviewFilter('all')\">전체 해설 보기</button>\n          <button class=\"wbtn\" onclick=\"savePDF('wrong')\">&#128190; 오답풀이 PDF</button>\n          <button class=\"wbtn\" onclick=\"savePDF('all')\">&#128190; 전체 해설 PDF</button>\n          <button class=\"submit-btn\" onclick=\"location.reload()\">처음으로 (다시 풀기)</button>\n        </div>\n      </div>\n    </div>\n    <div id=\"reviewArea\"></div>\n    <div class=\"disclaimer\" style=\"text-align:center;border-top:none;\">본 서비스는 한국보건의료인국가시험원(국시원)과 무관한 개인 학습용 연습 도구이며, 실제 기출문제가 아닌 창작 문항으로 구성되어 있습니다.</div>\n  </div>\n</div>\n\n<!-- ═════════ 모달들 ═════════ -->\n<div class=\"overlay hidden\" id=\"warnOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료 알림 <button class=\"x\" onclick=\"hide('warnOverlay')\">&times;</button></div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div>시험 종료 전<br><b style=\"color:var(--red)\">5분</b> 남았습니다.</div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" onclick=\"hide('warnOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"submitOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">답안 제출 <button class=\"x\" onclick=\"hide('submitOverlay')\">&times;</button></div>\n    <div class=\"modal-body\" id=\"submitMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"hide('submitOverlay')\">돌아가기</button>\n      <button class=\"m-btn blue\" onclick=\"doSubmit()\">제출하기</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"overlay hidden\" id=\"timeoverOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">&#9888; 시험종료</div>\n    <div class=\"modal-body\"><div class=\"big-clock\">&#128337;</div><span id=\"timeoverMsg\">시험 시간이 종료되어<br>답안이 자동 제출되었습니다.</span></div>\n    <div class=\"modal-foot\"><button class=\"m-btn\" id=\"timeoverBtn\" onclick=\"hide('timeoverOverlay');finishSession();\">결과 확인</button></div>\n  </div>\n</div>\n\n<!-- 교시 전환 안내 -->\n<div class=\"overlay hidden\" id=\"nextSessOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">교시 전환</div>\n    <div class=\"modal-body\" id=\"nextSessMsg\"></div>\n    <div class=\"modal-foot\">\n      <button class=\"m-btn gray\" onclick=\"resultNow()\">결과 보기</button>\n      <button class=\"m-btn blue\" onclick=\"startNextSession()\">다음 교시 시작</button>\n    </div>\n  </div>\n</div>\n\n<!-- 이용 기간 연장 안내 -->\n<div class=\"overlay hidden\" id=\"extendOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head blue\">&#127807; 이용 기간 연장 안내 <button class=\"x\" onclick=\"hide('extendOverlay')\">&times;</button></div>\n    <div class=\"modal-body\">\n      베타 피드백 설문에 참여해 주셔서 감사합니다.<br>\n      감사의 마음을 담아 이용 기간을<br>\n      <b style=\"color:var(--pop)\"><span id=\"extendUntilText\"></span>까지</b> 연장해 드렸어요.<br>\n      남은 기간 실전처럼 활용해 보세요! &#127807;\n    </div>\n    <div class=\"modal-foot\"><button class=\"m-btn blue\" onclick=\"hide('extendOverlay')\">확인</button></div>\n  </div>\n</div>\n\n<!-- 문제 보기 (전체/체크/안푼) -->\n<div class=\"overlay hidden\" id=\"viewerOverlay\">\n  <div class=\"viewer\">\n    <div class=\"viewer-head\">문제 모아보기 <button class=\"x\" onclick=\"hide('viewerOverlay')\">&times;</button></div>\n    <div class=\"viewer-guide\">※ 전체 / 체크 / 안 푼 문제 탭을 클릭하여 해당 문제를 확인할 수 있습니다.<br>※ 문제를 더블클릭하면 해당 문제로 이동하여 답안을 수정할 수 있습니다.</div>\n    <div class=\"viewer-tabs\">\n      <button class=\"v-tab active\" id=\"vtAll\" onclick=\"switchViewerTab('all')\">전체문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtChk\" onclick=\"switchViewerTab('chk')\">체크문제 (0)</button>\n      <button class=\"v-tab\" id=\"vtUn\" onclick=\"switchViewerTab('un')\">안푼문제 (0)</button>\n    </div>\n    <div class=\"viewer-body\" id=\"viewerBody\"></div>\n  </div>\n</div>\n\n<!-- 메모 -->\n<div class=\"float-win hidden\" id=\"memoWin\" style=\"top:120px;right:250px;\">\n  <div class=\"fw-head\" data-drag=\"memoWin\"><span id=\"memoTitle\">메모</span><button onclick=\"closeMemo()\">&times;</button></div>\n  <textarea id=\"memoText\" placeholder=\"이 문제에 대한 메모를 입력하세요.\"></textarea>\n</div>\n\n<!-- 계산기 -->\n<div class=\"float-win hidden\" id=\"calcWin\" style=\"bottom:90px;left:20px;\">\n  <div class=\"fw-head\" data-drag=\"calcWin\"><span>계산기</span><button onclick=\"hide('calcWin')\">&times;</button></div>\n  <div class=\"calc-body\">\n    <input id=\"calcDisp\" readonly value=\"0\">\n    <div class=\"calc-grid\">\n      <button onclick=\"calcClear()\">C</button><button onclick=\"calcBack()\">&larr;</button><button class=\"op\" onclick=\"calcIn('/')\">&divide;</button><button class=\"op\" onclick=\"calcIn('*')\">&times;</button>\n      <button onclick=\"calcIn('7')\">7</button><button onclick=\"calcIn('8')\">8</button><button onclick=\"calcIn('9')\">9</button><button class=\"op\" onclick=\"calcIn('-')\">&minus;</button>\n      <button onclick=\"calcIn('4')\">4</button><button onclick=\"calcIn('5')\">5</button><button onclick=\"calcIn('6')\">6</button><button class=\"op\" onclick=\"calcIn('+')\">+</button>\n      <button onclick=\"calcIn('1')\">1</button><button onclick=\"calcIn('2')\">2</button><button onclick=\"calcIn('3')\">3</button><button onclick=\"calcIn('.')\">.</button>\n      <button onclick=\"calcIn('0')\">0</button><button class=\"eq\" onclick=\"calcEq()\">=</button><button onclick=\"calcIn('00')\">00</button>\n    </div>\n  </div>\n</div>\n\n<!-- 그림판 -->\n<div class=\"float-win hidden\" id=\"padWin\" style=\"bottom:90px;left:280px;\">\n  <div class=\"fw-head\" data-drag=\"padWin\"><span>그림판</span><button onclick=\"hide('padWin')\">&times;</button></div>\n  <div class=\"pad-tools\">\n    <button id=\"penBtn\" class=\"on\" onclick=\"setPadMode('pen')\">펜</button>\n    <button id=\"eraserBtn\" onclick=\"setPadMode('eraser')\">지우개</button>\n    <button onclick=\"clearPad()\">전체 지우기</button>\n  </div>\n  <canvas id=\"padCanvas\" width=\"420\" height=\"280\"></canvas>\n</div>\n\n<script>\nwindow.EXAM_TITLE = \"1급 언어재활사 모의 CBT\";\nwindow.HIDDEN_SETS = [];\nwindow.QUESTIONS = [{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 전두엽 하부 손상\\n• 느리고 노력이 많이 드는 비유창한 발화\\n• 조사·어미 등 문법형태소를 자주 생략하는 전보식 발화\\n• 단순한 지시의 청각적 이해는 비교적 양호하나 통사적으로 복잡한 문장의 이해에는 어려움을 보임\\n• 따라말하기도 손상됨\",\"q\":\"위 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"연결피질운동실어증\",\"브로카실어증\",\"전도실어증\",\"명칭실어증\"],\"answer\":3,\"explain\":\"느리고 노력성인 비유창 발화, 실문법증(문법형태소 생략)의 전보식 발화, 손상된 따라말하기, 단순 지시 이해는 비교적 양호하나 통사적으로 복잡한 문장 이해에는 어려움을 보이는 것은 브로카실어증이다. 따라말하기가 유창성에 비해 보존되면 연결피질운동실어증으로 감별한다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R) 결과\\n• 스스로 말하기: 8/20점 (비유창)\\n• 알아듣기: 170/200점\\n• 따라말하기: 88/100점\\n• 이름대기 및 낱말 찾기: 40/100점\",\"q\":\"다음 결과를 보이는 환자의 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"브로카실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"발화는 비유창하지만 청각적 이해력이 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존된 양상은 연결피질운동실어증의 특징이다. 브로카실어증은 따라말하기도 손상되고, 전도실어증은 따라말하기가 선택적으로 손상된다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"좌뇌 손상 환자의 낱말 읽기 검사 결과\\n• 실제 낱말을 의미적으로 관련된 다른 낱말로 대치함(예: '버스'→'기차', '사과'→'포도')\\n• 비단어('무핀', '두랍') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"위 환자의 실독증 유형으로 가장 적절한 것은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"순수실독증\",\"심층실독증\",\"무시실독증\"],\"answer\":4,\"explain\":\"실제 낱말을 의미적으로 관련된 낱말로 대치하는 의미착어(예: '버스'→'기차'), 비단어 읽기의 심한 손상, 추상어보다 구체어를 잘 읽는 심상성(imageability) 효과는 심층실독증의 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 기저핵 회로의 퇴행성 병변\\n• 단조로운 음도와 감소된 강도\\n• 말속도가 점점 빨라지며 음절이 뭉개짐\\n• 안정 시 떨림 동반\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"경직형\",\"실조형\",\"과다운동형\"],\"answer\":2,\"explain\":\"기저핵 병변(파킨슨병)과 단조로운 음도·강도, 말속도 가속, 안정 떨림은 과소운동형 마비말장애의 전형적인 특징이다. 실조형은 소뇌 손상으로 불규칙한 조음 붕괴와 과도한 강세 변동을 보인다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 근력 저하 없이 말소리를 탐색하는 듯한 입술·혀의 모색행동\\n• 같은 낱말에서도 매번 다른 조음 오류\\n• 발화 길이가 길어질수록 오류 증가\\n• 자동구어(숫자세기)는 비교적 유창함\",\"q\":\"다음 특징을 보이는 환자에게 적절한 치료 활동은?\",\"choices\":[\"보완대체의사소통 도구를 즉시 도입한다\",\"빨대 불기 등 구강 근력 강화 훈련을 실시한다\",\"청각적 이해력 훈련을 우선 실시한다\",\"느린 속도로 조음점 전환을 반복 연습하며 운동학습 원리를 적용한다\",\"호흡 지구력 훈련으로 발화 길이를 늘린다\"],\"answer\":4,\"explain\":\"비일관적 오류, 모색행동, 자동구어의 상대적 보존은 말실행증의 특징이다. 말실행증은 근력의 문제가 아니라 말운동 프로그래밍의 손상이므로 집중적·반복적인 말산출 연습과 운동학습 원리(느린 속도, 점진적 난이도)를 적용한 치료가 적절하다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"비디오투시조영삼킴검사(VFSS) 소견\\n• 삼킴 반사가 유발되기 전에 음식물이 조기에 인두로 흘러내림\\n• 음식물이 후두 전정을 지나 진성대 아래로 내려감\\n• 이때 기침 반응이 나타나지 않음\",\"q\":\"다음 소견에 해당하는 삼킴장애 증상은?\",\"choices\":[\"구강 잔여물\",\"삼킴 중 침습\",\"삼킴 후 흡인\",\"삼킴 전 무증상 흡인\",\"비강 역류\"],\"answer\":4,\"explain\":\"삼킴 반사가 유발되기 전(삼킴 전)에 음식물이 진성대 아래로 내려갔으므로 흡인이며, 기침 등 방어 반응이 없으므로 무증상(silent) 흡인이다. 침습은 진성대 위까지만 들어간 경우를 말한다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 65세 남성, 발화는 유창하고 문법적으로 완전함\\n• '가위'를 보여주면 이름을 대지 못하고 용도도 설명하지 못함\\n• 단어의 의미를 묻는 과제에서 점진적인 어려움 심화\\n• 불규칙 낱말을 규칙적으로 읽는 오류 동반\\n• 일상생활 기억력과 시공간 능력은 비교적 보존됨\",\"q\":\"다음 양상을 보이는 환자에게 의심되는 진단명은?\",\"choices\":[\"알츠하이머성 치매\",\"의미치매\",\"원발성 진행성 실어증 비유창형\",\"혈관성 치매\",\"루이소체 치매\"],\"answer\":2,\"explain\":\"유창한 발화가 유지되면서 단어 의미 지식이 점진적으로 상실되고(이름대기·의미 이해 저하) 표층실독증 양상이 동반되며 일상 기억이 비교적 보존되는 것은 의미치매(의미변이형 원발성 진행성 실어증)의 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"외상성 뇌손상 환자의 주의력 유형과 평가 과제가 적절하게 연결된 것은?\",\"choices\":[\"선택적 주의력 – 조용한 방에서 숫자 따라 외우기\",\"지속적 주의력 – 일정 시간 동안 목표 소리가 들릴 때마다 버튼 누르기\",\"초점적 주의력 – 두 가지 규칙을 번갈아 적용하기\",\"분리적 주의력 – 두 과제 중 하나만 골라 수행하기\",\"교대적 주의력 – 소음 속에서 이야기 듣고 질문에 답하기\"],\"answer\":2,\"explain\":\"지속적 주의력은 일정 시간 동안 주의를 유지하는 능력으로, 지속 수행 과제(목표 자극에 반응하기)로 평가한다. 소음 속 과제는 선택적 주의력, 규칙 전환 과제는 교대적 주의력, 이중과제는 분리(배분)적 주의력 평가에 해당한다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 광범위한 좌반구 병소\\n• 구어 표현이 몇 개의 상동어에 제한됨\\n• 청각적 이해력도 심하게 손상됨\\n• 몸짓 모방은 부분적으로 가능함\",\"q\":\"다음 환자에게 우선적으로 적용할 수 있는 치료법은?\",\"choices\":[\"멜로디억양치료\",\"지연청각피드백\",\"문장산출프로그램\",\"의미자질분석\",\"시각동작치료\"],\"answer\":5,\"explain\":\"시각동작치료(VAT)는 구어를 사용하지 않고 몸짓 상징을 훈련하는 접근으로, 표현과 이해가 모두 심하게 손상된 전반실어증 환자에게 적용할 수 있다. 멜로디억양치료는 이해력이 양호한 비유창 실어증 환자에게 적합하다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)에서 실어증지수(AQ) 산출에 포함되지 않는 영역은?\",\"choices\":[\"스스로 말하기\",\"따라말하기\",\"읽기\",\"이름대기 및 낱말 찾기\",\"알아듣기\"],\"answer\":3,\"explain\":\"실어증지수(AQ)는 스스로 말하기, 알아듣기, 따라말하기, 이름대기의 구어 영역 점수로 산출한다. 읽기와 쓰기는 언어지수(LQ) 산출에 포함된다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"아 내: \\\"남편이 말을 잘 못 알아들어서 답답해요. 제가 길게 설명하면 멍하니 있어요.\\\"\\n환자: 중등도 실어증으로 외래 언어치료 중\",\"q\":\"다음 보호자에게 제공할 의사소통 교육 내용으로 옳은 것은?\",\"choices\":[\"짧고 단순한 문장으로 말하고 반응할 시간을 충분히 준다\",\"환자가 틀리게 말할 때마다 즉시 교정해 준다\",\"환자가 말하기 전에 미리 대신 말해 준다\",\"의사소통 실패를 줄이기 위해 대화 기회를 최소화한다\",\"빠른 속도로 여러 번 반복해서 말해 준다\"],\"answer\":1,\"explain\":\"실어증 환자와의 의사소통에서는 짧고 단순한 문장, 느린 말속도, 충분한 반응 시간 제공, 제스처 등 다중 양식 활용이 권장된다. 잦은 교정이나 대신 말하기는 의사소통 의욕을 저하시킨다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"성문위삼킴법(supraglottic swallow)의 일차적인 목적은?\",\"choices\":[\"인두 잔여물을 중력으로 제거한다\",\"후두 상승을 연장하여 상부식도괄약근의 개방 시간을 늘린다\",\"혀 기저부의 후방 운동을 강화한다\",\"삼킴 반사의 유발 속도를 높인다\",\"삼킴 전과 삼킴 중에 성대 수준에서 기도를 폐쇄하여 흡인을 방지한다\"],\"answer\":5,\"explain\":\"성문위삼킴법은 숨을 참은 상태로 삼킨 뒤 기침을 하는 기법으로, 삼킴 전·중에 진성대 수준에서 기도를 닫아 흡인을 예방한다. 후두 상승 연장과 상부식도괄약근 개방 연장은 멘델슨기법의 목적이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 좌측 상측두회(베르니케 영역) 손상\\n• 유창하지만 착어가 많은 발화\\n• 청각적 이해력이 심하게 저하됨\\n• 따라말하기가 손상되고 병식이 부족함\",\"q\":\"다음 양상을 보이는 실어증 유형은?\",\"choices\":[\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"연결피질감각실어증\",\"브로카실어증\"],\"answer\":1,\"explain\":\"유창한 발화, 심한 청각적 이해력 손상, 착어, 병식 부족은 베르니케실어증의 특징이다. 연결피질감각실어증은 유사하나 따라말하기가 상대적으로 보존된다는 점에서 구별된다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"유창한 발화와 비교적 양호한 청각적 이해력을 보이나 따라말하기가 선택적으로 심하게 손상되고 음소착어가 두드러지는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"베르니케실어증\",\"브로카실어증\",\"전도실어증\",\"전반실어증\"],\"answer\":4,\"explain\":\"전도실어증은 활꼴다발(궁상속)의 손상으로 유창성과 이해력은 보존되나 따라말하기가 선택적으로 손상되고, 음소착어와 스스로 고치려는 접근행동(conduite d'approche)을 보인다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 소뇌 손상\\n• 불규칙하게 조음이 붕괴됨\\n• 과도하고 불규칙한 강세\\n• 술 취한 듯한 말\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"경직형\",\"실조형\",\"과소운동형\",\"과다운동형\"],\"answer\":3,\"explain\":\"실조형 마비말장애는 소뇌 손상으로 발생하며, 불규칙한 조음 붕괴, 과도하고 불규칙한 강세, 운율 이상('술 취한 듯한 말')이 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 상위운동신경의 양측 손상\\n• 느리고 힘이 많이 드는 말\\n• 쥐어짜는 듯한 거친 음성\\n• 과다비성\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"이완형\",\"과소운동형\",\"실조형\",\"편측 상부운동신경형\",\"경직형\"],\"answer\":5,\"explain\":\"경직형 마비말장애는 상위운동신경의 양측 손상으로 발생하며, 느리고 노력성인 말, 쥐어짜는 거친 음성, 과다비성이 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 뇌신경(안면신경·설하신경 등)의 하위운동신경 손상\\n• 침범된 근육의 약화와 위축\\n• 과다비성과 기식 음성\\n• 부정확한 자음\",\"q\":\"다음 양상을 보이는 환자의 마비말장애 유형은?\",\"choices\":[\"과다운동형\",\"경직형\",\"실조형\",\"이완형\",\"과소운동형\"],\"answer\":4,\"explain\":\"이완형 마비말장애는 하위운동신경(뇌신경·척수신경) 손상으로 근육의 약화·저긴장·위축이 나타나며, 과다비성과 기식 음성이 특징이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"우반구 손상 환자의 의사소통 특징으로 가장 적절한 것은?\",\"choices\":[\"심한 실문법증을 보인다\",\"따라말하기가 선택적으로 손상된다\",\"음소착어가 빈번하게 나타난다\",\"화용언어와 운율의 결함을 보이며 좌측 무시가 동반될 수 있다\",\"청각적 이해력이 심하게 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상 환자는 언어 구조 자체보다 화용(담화 조직, 추론, 유머·비유 이해), 운율, 시공간 처리(좌측 무시)에서 결함을 보인다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"멜로디억양치료(MIT)를 적용하기에 가장 적절한 환자는?\",\"choices\":[\"청각적 이해력이 심하게 손상된 전반실어증 환자\",\"이해력은 양호하나 발화 산출이 제한된 비유창 실어증 환자\",\"착어가 많은 베르니케실어증 환자\",\"화용 결함을 보이는 우반구 손상 환자\",\"과다비성을 보이는 마비말장애 환자\"],\"answer\":2,\"explain\":\"멜로디억양치료는 보존된 우반구의 멜로디 기능을 활용하는 치료로, 청각적 이해력이 비교적 양호하고 발화 산출이 제한된 비유창(브로카) 실어증 환자에게 적합하다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"이름대기 장애 치료법으로, 목표 낱말의 범주·기능·특징 등 의미 정보를 활성화하여 낱말 인출을 돕는 접근법은?\",\"choices\":[\"멜로디억양치료\",\"의미자질분석\",\"시각동작치료\",\"각본치료\",\"성문위삼킴법\"],\"answer\":2,\"explain\":\"의미자질분석(SFA)은 목표 낱말과 관련된 의미자질(상위범주, 기능, 특징, 위치 등)을 체계적으로 인출하게 하여 이름대기 능력을 향상시키는 치료법이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"한국판 보스턴이름대기검사(K-BNT)가 평가하는 능력은?\",\"choices\":[\"쓰기 표현\",\"청각적 이해력\",\"문장 따라말하기\",\"대면 이름대기\",\"읽기 이해\"],\"answer\":4,\"explain\":\"K-BNT는 흑백 선화를 보고 이름을 말하는 대면 이름대기(confrontation naming) 능력을 평가하는 검사이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"삼킴 시 후두 상승을 인위적으로 연장·유지하여 상부식도괄약근의 개방 시간을 늘리는 삼킴 기법은?\",\"choices\":[\"성문위삼킴법\",\"최대성문위삼킴법\",\"노력삼킴\",\"멘델슨기법\",\"머리 회전법\"],\"answer\":4,\"explain\":\"멘델슨기법은 삼킴 시 후두가 최고로 올라간 지점에서 인위적으로 상승을 유지하여 상부식도괄약근의 개방 시간과 폭을 늘리는 기법이다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"알츠하이머성 치매 초기 단계에서 가장 두드러지는 언어 특징은?\",\"choices\":[\"조음의 붕괴\",\"구문 구조의 상실\",\"따라말하기 불능\",\"완전한 함구증\",\"이름대기 어려움과 단어 인출 결함\"],\"answer\":5,\"explain\":\"알츠하이머성 치매 초기에는 조음·구문·따라말하기는 비교적 보존되고, 이름대기 어려움과 에두르기 등 의미론적 단어 인출 결함이 먼저 나타난다.\"},{\"subject\":\"신경언어장애\",\"session\":1,\"q\":\"뇌영상 기법에 대한 설명으로 옳은 것은?\",\"choices\":[\"기능자기공명영상(fMRI)은 뇌의 구조적 병변만을 보여준다\",\"구조 MRI와 CT는 뇌의 구조를, fMRI와 PET는 과제 수행 중 뇌 기능(활성화)을 보여준다\",\"컴퓨터단층촬영(CT)은 과제 수행 중 뇌 활성화를 직접 측정한다\",\"확산텐서영상(DTI)은 뇌혈류 속도를 측정한다\",\"모든 뇌영상은 기능적 정보만 제공한다\"],\"answer\":2,\"explain\":\"CT와 구조 MRI는 뇌의 해부학적 구조·병변을 보여주는 구조적 영상이고, fMRI·PET는 과제 수행 중 신경 활동에 따른 혈류·대사 변화를 측정하는 기능적 영상이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동 발화\\n① \\\"엄마 물 줘\\\"\\n② \\\"이거 안 먹어\\\"\\n③ \\\"곰인형 어디 있어\\\"\\n④ \\\"나도 갈래\\\"\",\"q\":\"다음 아동 발화의 평균낱말길이(MLU-w)는?\",\"choices\":[\"2.25\",\"2.5\",\"2.75\",\"3.0\",\"3.25\"],\"answer\":3,\"explain\":\"각 발화의 낱말 수는 3, 3, 3, 2개로 총 11개이다. MLU-w = 총 낱말 수 ÷ 발화 수 = 11 ÷ 4 = 2.75.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"낱말 이름대기 과제에서 아동이 다음과 같이 반응하였다.\\n가위 → \\\"자르는 거\\\"\\n시계 → \\\"똑딱똑딱\\\"\\n칫솔 → \\\"이 닦는 거\\\"\",\"q\":\"위 아동의 이름대기 반응에 대한 설명으로 옳은 것은?\",\"choices\":[\"목표 낱말을 인출하지 못하고 기능·특징으로 에둘러 표현하고 있다\",\"음소착어를 보이고 있다\",\"보속 반응을 보이고 있다\",\"이름대기 능력이 정상 범위이다\",\"의미와 무관한 신조어를 산출하고 있다\"],\"answer\":1,\"explain\":\"낱말 이름대기에서 목표어를 인출하지 못해 그 기능·특징으로 대신 설명하는 것을 에두르기(circumlocution)라 하며, 낱말찾기(인출)의 어려움을 시사한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동이 산출한 이야기\\n\\\"토끼가 당근을 심었어요. 그리고 매일 물을 주었어요. 그런데 당근이 자라지 않았어요. 왜냐하면 씨앗을 거꾸로 심었기 때문이에요.\\\"\",\"q\":\"위 이야기에서 두드러지게 나타난 언어 특성은?\",\"choices\":[\"대용어를 전혀 사용하지 않았다\",\"이야기 문법 요소가 나타나지 않았다\",\"'그리고, 그런데, 왜냐하면' 등 접속부사를 사용해 문장을 연결하고 있다\",\"문법형태소 오류가 빈번하다\",\"단문만 산출하였다\"],\"answer\":3,\"explain\":\"'그리고, 그런데, 왜냐하면' 등 접속부사(연결어미)는 문장·명제를 이어 주는 결속표지로, 위 이야기에서 이를 활용해 사건을 순서·대조·인과로 연결하고 있다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"표준화 언어검사와 평가 영역의 연결이 옳지 않은 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용·표현 어휘력\",\"한국어 읽기 검사(KOLRA) – 자발화 산출 능력\",\"언어문제해결력검사 – 상위언어 및 추론 능력\",\"취학전 아동의 수용언어 및 표현언어 발달 척도(PRES) – 취학전 수용·표현 언어\",\"구문의미이해력검사(KOSECT) – 구문의미 이해력\"],\"answer\":2,\"explain\":\"KOLRA(한국어 읽기 검사)는 해독·읽기이해 등 읽기 능력을 평가하며 자발화 산출 능력을 평가하지 않는다. 나머지는 검사와 평가 영역이 올바르게 연결되어 있다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 아동\\n• 가정에서는 아버지·어머니 모두 베트남어만 사용\\n• 만 3세에 어린이집에 입소하면서 한국어에 처음 본격적으로 노출됨\\n• 현재 한국어 발화가 제한적임\",\"q\":\"위 아동의 이중언어 유형과 평가 시 고려사항으로 옳은 것은?\",\"choices\":[\"동시적 이중언어 아동의 규준을 그대로 적용한다\",\"한국어 검사 결과만으로 언어장애를 진단한다\",\"베트남어 사용을 중단하도록 권고한다\",\"이중언어 노출이 언어지연의 직접 원인이라고 설명한다\",\"제2언어(한국어) 노출 기간이 짧은 순차적 이중언어 아동이므로 노출 기간을 고려해 해석한다\"],\"answer\":5,\"explain\":\"만 3세 이후 제2언어(한국어)에 노출된 순차적 이중언어 아동이다. 노출 기간이 짧으면 제2언어 수행이 낮게 나타날 수 있으므로 노출 기간을 고려해 해석해야 하며, 이중언어 노출 자체는 언어지연의 원인이 아니다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 뇌성마비로 사지의 운동 조절이 어려움\\n• 인지 능력과 언어 이해력은 연령 수준\\n• 손가락으로 상징을 직접 짚는 것이 불가능함\\n• 눈 움직임과 머리 움직임은 비교적 안정적임\",\"q\":\"다음 아동의 보완대체의사소통(AAC) 도구 선택 기법으로 가장 적절한 것은?\",\"choices\":[\"수어를 통한 표현\",\"필담을 이용한 의사 표현\",\"구어 산출 훈련만 실시\",\"시선 응시 또는 스캐닝을 이용한 선택\",\"손가락을 이용한 직접선택\"],\"answer\":4,\"explain\":\"직접선택이 어려운 사지 운동장애 아동에게는 안정적으로 조절 가능한 움직임(시선, 머리)을 활용한 시선 응시 선택이나 스위치를 이용한 스캐닝(간접선택)이 적절하다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등학교 3학년 아동, 난독 의심으로 의뢰\\n• 낱말·비단어를 소리 내어 읽는 속도와 정확도는 또래 수준\\n• 읽은 글의 내용을 이해하고 요약하는 데 또래보다 크게 어려움\\n• 들려주면 이해하고 일상 대화에는 어려움이 없음\",\"q\":\"위 아동의 읽기 문제 유형으로 가장 적절한 것은?\",\"choices\":[\"난독증(해독 부진)\",\"읽기이해부진\",\"말소리장애\",\"쓰기장애\",\"유창성장애\"],\"answer\":2,\"explain\":\"해독(낱말·비단어 읽기의 속도·정확도)은 또래 수준이나 읽기이해가 저조하고 듣기이해는 양호한 양상은, 해독 결함의 난독증이 아니라 읽기이해부진에 해당한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"대화 중 아동이 상대의 말이 끝나기 전에 끼어들어 말하고, 자신의 관심사만 일방적으로 이야기하며, 상대의 질문에 맞지 않는 대답을 자주 한다.\",\"q\":\"위 아동에게 우선 목표로 설정할 화용 능력은?\",\"choices\":[\"낱말 해독 정확도\",\"조음 정확도\",\"평균발화길이(MLU)\",\"대화 차례 주고받기와 주제 유지\",\"음운인식\"],\"answer\":4,\"explain\":\"상대의 말을 끊고 자기 관심사만 말하며 부적절하게 반응하는 것은 대화 규칙(차례 주고받기·주제 유지)의 어려움이므로, 이를 우선 화용 목표로 설정한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어 이전기 아동의 의사소통 행동을 관찰하였다.\\n• 손이 닿지 않는 과자를 향해 소리를 내며 성인의 손을 끌어당긴다.\\n• 싫어하는 음식을 밀어내며 고개를 돌린다.\",\"q\":\"위 두 행동에 해당하는 의사소통 기능을 순서대로 바르게 짝지은 것은?\",\"choices\":[\"요구하기 - 거부하기\",\"서술하기 - 요구하기\",\"거부하기 - 인사하기\",\"공동주의 - 서술하기\",\"요구하기 - 공동주의\"],\"answer\":1,\"explain\":\"손이 닿지 않는 사물을 향해 성인의 손을 끌며 소리 내는 것은 요구하기, 싫어하는 것을 밀어내고 고개를 돌리는 것은 거부하기 기능이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 1학년 아동 평가 결과\\n• 수용·표현 어휘력 검사(REVT) 백분위수: 수용 8, 표현 6\\n• 비언어성 지능: 정상 범위\\n• 청력: 정상\\n• 자발화: 조사 생략과 제한된 어휘 사용 관찰\",\"q\":\"다음 결과에 근거한 부모 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"\\\"또래에 비해 어휘력이 유의하게 낮아 어휘 중심의 언어치료가 필요해요.\\\"\",\"\\\"청력 손실이 원인이므로 보청기 착용이 필요해요.\\\"\",\"\\\"지능이 낮아서 나타나는 현상이므로 인지치료가 우선이에요.\\\"\",\"\\\"발음 문제가 핵심이므로 조음치료를 시작해야 해요.\\\"\",\"\\\"정상 범위이므로 치료 없이 지켜봐도 돼요.\\\"\"],\"answer\":1,\"explain\":\"REVT 백분위수 10 미만은 또래 대비 유의한 어휘 지체를 의미한다. 비언어성 지능과 청력이 정상이므로 언어 영역에 특정된 어려움이며, 어휘·문법을 목표로 한 언어치료가 권고된다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"간식 시간에 치료사가 아동이 좋아하는 주스를 아동 눈에 보이지만 손이 닿지 않는 선반에 올려 두고, 뚜껑을 꼭 닫은 채 건네준 뒤 아동의 반응을 기다린다.\",\"q\":\"위 장면에서 사용된 중재 전략은?\",\"choices\":[\"청각적 집중 자극\",\"스크립트 문맥 활용\",\"비연속 개별시도 교수\",\"반응대가 기법\",\"환경 조성을 통한 의사소통 유도\"],\"answer\":5,\"explain\":\"환경중심 언어중재의 환경 조성 전략은 원하는 물건을 보이지만 닿지 않게 두거나 도움이 필요한 상황(닫힌 뚜껑)을 만들어 아동이 자발적으로 요구하기를 산출하도록 유도하는 방법이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등학교 4학년 아동 언어평가 결과\\n• 상위개념 어휘 이해: 또래 하위 5%\\n• 동의어·반의어 표현: 또래 하위 3%\\n• 복문 산출과 문법형태소 사용: 연령 수준\\n• 조음 및 읽기 해독: 연령 수준\",\"q\":\"다음 아동에게 우선적으로 설정할 중재 목표는?\",\"choices\":[\"문법형태소 오류 수정\",\"낱말 해독 정확도 향상\",\"복문 산출 능력 향상\",\"조음 정확도 향상\",\"어휘의 의미 관계(상위어·동의어·반의어) 확장\"],\"answer\":5,\"explain\":\"구문·조음·해독은 연령 수준이나 어휘의 의미 관계 영역(상위개념, 동의어·반의어)에서만 유의한 지체를 보이므로, 의미론적 어휘 조직화를 확장하는 중재가 우선 목표가 된다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 5세 남아\\n• 상대방의 말을 그대로 따라 말함\\n• 대명사를 뒤바꿔 사용함(너/나 혼동)\\n• 특정 관심사를 반복적으로 언급하고 눈맞춤이 부족함\",\"q\":\"다음 아동에게 의심되는 장애는?\",\"choices\":[\"단순언어장애\",\"청각장애\",\"지적장애\",\"자폐스펙트럼장애\",\"조음음운장애\"],\"answer\":4,\"explain\":\"반향어, 대명사 전도, 제한된 관심사의 반복, 눈맞춤 부족, 상호작용의 어려움은 자폐스펙트럼장애의 대표적 언어·의사소통 특징이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 이야기 전사 자료)\\n토끼랑 거북이가 달리기를 했어요. 토끼는 빨리 뛰다가 낮잠을 잤어요. 그래서 거북이가 먼저 도착했어요.\",\"q\":\"위 아동 발화의 최소종결단위(T-unit) 수는?\",\"choices\":[\"2\",\"3\",\"4\",\"5\",\"6\"],\"answer\":2,\"explain\":\"T-unit은 하나의 주절과 그에 딸린 종속절을 한 단위로 센다. 세 문장이 각각 하나의 T-unit이므로 T-unit 수는 3이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"언어재활사가 아동에게 다음과 같이 질문하였다.\\n• \\\"친구가 '창문이 열려 있네'라고 말하면 무슨 뜻일까요?\\\"\\n• \\\"수업 시간에 딴짓하는 친구에게 선생님이 '지금 뭐 하고 있니?'라고 하면 진짜 궁금해서 물어보는 걸까요?\\\"\",\"q\":\"위 질문으로 평가하려는 능력은?\",\"choices\":[\"음운인식 능력\",\"구문 산출 능력\",\"간접표현·함축된 의미를 이해하는 상위화용 능력\",\"낱말 해독 능력\",\"조음 정확도\"],\"answer\":3,\"explain\":\"'창문이 열려 있네'의 함축(닫아 달라)이나 반어적 발화의 진짜 의도를 파악하는 것은 간접표현·함축 이해로, 상위화용 능력에 해당한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동: 차 가.\\n치료사: 차가 가네.\",\"q\":\"위 장면에서 치료사가 사용한 기법은?\",\"choices\":[\"확장(expansion)\",\"혼잣말기법\",\"평행발화기법\",\"확대(extension)\",\"분리 및 합성\"],\"answer\":1,\"explain\":\"확장(expansion)은 아동 발화의 의미는 유지하면서 문법적으로 완전한 형태로 다시 들려주는 기법이다. 확대는 새로운 의미 정보를 덧붙이는 기법이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"생일잔치, 마트 놀이 등 친숙한 일상 활동의 익숙한 순서를 활용하여 언어를 촉진하는 중재 접근은?\",\"choices\":[\"감각통합 치료\",\"청지각 훈련\",\"스크립트 중재\",\"핵심어휘 접근법\",\"청각구어법\"],\"answer\":3,\"explain\":\"스크립트 중재는 아동에게 친숙한 일상 사건의 구조(스크립트)를 활용하여 인지적 부담을 줄이고 새로운 언어 형식의 학습을 촉진한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"중심축 반응중재(PRT)의 핵심 특징으로 옳은 것은?\",\"choices\":[\"치료사가 모든 자극과 강화를 통제하는 개별시도 형식으로 진행한다\",\"아동의 선택과 주도를 활용하고 동기·복합단서 반응 등 중심축 영역을 목표로 하며 자연적 강화를 사용한다\",\"구조화된 책상 과제에서 인위적 강화물로 반복 시행한다\",\"언어보다 구강운동 훈련에 초점을 둔다\",\"성인 주도의 지시 따르기를 우선한다\"],\"answer\":2,\"explain\":\"중심축 반응중재(PRT)는 아동의 선택·주도를 활용하고 동기·복합단서 반응 등 중심축(pivotal) 영역을 목표로 하며, 자연적 강화(원하는 것 제공)를 사용하는 자연주의적 중재이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"아동의 자발화를 분석한 결과, 전체 낱말 수(NTW)는 40개, 서로 다른 낱말 수(NDW)는 20개였다.\",\"q\":\"이 아동의 어휘다양도(TTR)는?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.8\",\"2.0\"],\"answer\":2,\"explain\":\"어휘다양도(TTR) = 서로 다른 낱말 수 ÷ 전체 낱말 수 = 20 ÷ 40 = 0.5이다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"그림교환의사소통체계(PECS) 훈련에서 가장 먼저 지도하는 것은?\",\"choices\":[\"여러 그림 중에서 목표 그림을 변별하기\",\"'나는 ~을 원해요' 문장판을 구성하기\",\"그림으로 감정을 설명하기\",\"그림 없이 음성으로 요구하기\",\"원하는 사물의 그림카드를 의사소통 상대에게 건네어 교환하기\"],\"answer\":5,\"explain\":\"PECS는 1단계에서 원하는 사물의 그림카드를 의사소통 상대에게 건네는 '교환(요구하기)'을 먼저 지도하고, 변별·문장 구성 등은 이후 단계에서 다룬다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"q\":\"이야기 문법(story grammar)의 구성 요소에 해당하지 않는 것은?\",\"choices\":[\"시도\",\"계기사건\",\"내적 반응\",\"어휘다양도\",\"배경\"],\"answer\":4,\"explain\":\"이야기 문법은 배경, 계기사건, 내적 반응, 시도, 결과, 결말 등으로 구성된다. 어휘다양도(TTR)는 어휘 사용의 다양성을 나타내는 지표로 이야기 문법 요소가 아니다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"• 초등 1학년 아동, 한국 비언어성 지능검사(K-CTONI-2) 지능지수 96(정상)\\n• 또래와 대화 시 눈맞춤이 짧고 상황에 맞지 않는 말과 주제 이탈이 잦음\\n• 농담·비유·간접표현을 문자 그대로 받아들임\\n• 제한된 관심사·상동행동·감각 특이성은 관찰되지 않음\\n• 한국 아동 메타-화용언어 검사(KOPLAC) 상위언어 인식 3%ile\",\"q\":\"위 아동에게 가장 의심되는 진단은?\",\"choices\":[\"자폐스펙트럼장애\",\"지적장애\",\"사회적(화용) 의사소통장애\",\"단순언어장애\",\"학습장애\"],\"answer\":3,\"explain\":\"지능이 정상이고 제한된 관심사·상동행동이 없으면서 화용(대화 규칙·간접표현) 결함이 두드러지면 자폐스펙트럼장애가 아니라 사회적(화용) 의사소통장애로 감별한다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"초등 3학년 아동이 형태소 규칙으로 설명되지 않는 관습적 표기 낱말에서 오류를 보인다.\\n• 깨끗이 → '깨끄시'\\n• 왠지 → '웬지'\\n• 며칠 → '몇일'\",\"q\":\"위 아동에게 필요한 쓰기 중재로 가장 적절한 것은?\",\"choices\":[\"낱말의 표기형(철자 패턴)을 기억하고 인출하도록 돕는 표기처리 중심 중재\",\"형태소의 원형을 밝혀 적도록 하는 형태처리 중심 중재\",\"소리 나는 대로 적도록 하는 음운처리 중심 중재\",\"조음 정확도를 높이는 조음 중재\",\"읽기 유창성 훈련\"],\"answer\":1,\"explain\":\"형태소 규칙으로 설명되지 않고 관습적으로 굳어진 표기(깨끗이, 왠지, 며칠 등)의 오류는, 낱말의 표기형(철자 패턴) 자체를 기억·인출하도록 돕는 표기처리 중심 중재가 적절하다.\"},{\"subject\":\"언어발달장애\",\"session\":1,\"stem\":\"(아동 발화를 전사한 자료)\\n24개월 아동의 발화\\n\\\"엄마 밥\\\", \\\"아빠 어디\\\", \\\"이거 줘\\\", \\\"물 먹어\\\"\",\"q\":\"위 발화 단계에 대한 설명으로 옳은 것은?\",\"choices\":[\"복문을 산출하는 단계이다\",\"두 낱말을 조합하는 초기 문법 단계로 조사·어미 등 문법형태소는 아직 나타나지 않는다\",\"한 낱말 시기(일어문)에 해당한다\",\"문법형태소 오류가 빈번한 단계이다\",\"이야기 문법을 갖춘 담화를 산출하는 단계이다\"],\"answer\":2,\"explain\":\"'엄마 밥', '이거 줘'처럼 두 낱말을 조합하지만 조사·어미 등 문법형태소가 아직 나타나지 않는 것은 초기 문법 단계(두 낱말 시기)의 특징이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"정상적인 비유창성을 보이는 아동의 말을 부모가 '말더듬'으로 잘못 진단하고 부정적으로 반응함으로써, 아동이 자신의 말을 의식하고 긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\",\"q\":\"위 설명에 해당하는 말더듬 발생 이론은?\",\"choices\":[\"예기투쟁가설\",\"진단착오이론\",\"요구용량모델\",\"내적수정가설\",\"대뇌반구우세이론\"],\"answer\":2,\"explain\":\"진단착오이론(Johnson)은 정상적 비유창성을 부모가 말더듬으로 잘못 진단·반응하면서 아동이 말을 의식·긴장·회피하게 되어 말더듬으로 발전한다고 보는 이론이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"\\\"저저저는 어 (막힘)토요일에 ㅅㅅㅅ수영장에 가서 수---영을 배워요.\\\"\",\"q\":\"다음 발화에서 나타난 진성 비유창성(SLD)의 횟수는?\",\"choices\":[\"2회\",\"3회\",\"4회\",\"5회\",\"6회\"],\"answer\":3,\"explain\":\"진성 비유창성은 단어부분반복('저저저', 'ㅅㅅㅅ수'), 막힘 1회, 연장('수---') 1회로 총 4회이다. 간투사 '어'는 기타(정상적) 비유창성으로 분류한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 발화 표본: 총 150음절\\n• 말더듬이 나타난 음절: 12음절\",\"q\":\"위 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"6%\",\"8%\",\"10%\",\"12.5%\",\"15%\"],\"answer\":2,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 12 ÷ 150 × 100 = 8%.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 '빙산 모델(iceberg model)'에서 수면 아래에 해당하는 요소로 가장 적절한 것은?\",\"choices\":[\"겉으로 드러나는 반복·연장·막힘\",\"관찰 가능한 신체적 부수행동\",\"말속도와 조음 정확도\",\"말더듬에 대한 두려움·수치심 등 감정과 태도\",\"발화의 문법 오류\"],\"answer\":4,\"explain\":\"빙산 모델에서 수면 위는 반복·연장·막힘 등 겉으로 드러나는 행동이고, 수면 아래는 말더듬에 대한 두려움·수치심·좌절 등 겉으로 드러나지 않는 감정과 태도이다. 치료에서는 수면 아래 요소도 함께 다루어야 한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 38세 여성, 6개월 전 교통사고로 가족을 잃은 후 말더듬 시작\\n• 아동기 말더듬 병력 없음\\n• 모든 낱말과 문법적 위치에서 유사한 형태의 반복이 일관되게 나타남\\n• 반복해서 읽어도 말더듬 빈도가 줄지 않음\\n• 부수행동이나 말에 대한 불안이 거의 관찰되지 않음\",\"q\":\"다음 대상자에게 의심되는 유창성장애 유형은?\",\"choices\":[\"위장 말더듬\",\"신경학적 말더듬\",\"심인성 말더듬\",\"속화\",\"발달성 말더듬\"],\"answer\":3,\"explain\":\"심리적 외상 후 성인기에 갑자기 발생하고, 낱말 유형·위치와 무관하게 일관된 형태를 보이며, 적응효과가 없고 이차행동·불안이 거의 없는 양상은 심인성 말더듬의 특징이다. 신경학적 말더듬은 뇌손상 병력이 확인되어야 한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"파라다이스-유창성 검사-II(P-FA-II) 결과\\n• 필수과제 총점 백분위수: 65%ile\\n• 의사소통태도 평가 백분위수: 70%ile\",\"q\":\"위 결과에 대한 해석으로 옳은 것은?\",\"choices\":[\"말더듬 정도는 '심함'에 해당한다\",\"말더듬 정도는 '약함'에 해당한다\",\"말더듬 정도는 '중간'에 해당한다\",\"정상 범위의 유창성 수준이다\",\"백분위수로는 중증도를 판단할 수 없다\"],\"answer\":3,\"explain\":\"P-FA-II에서 필수과제 백분위수 1~40%ile은 약함, 41~80%ile은 중간, 81%ile 이상은 심함으로 해석한다. 65%ile은 '중간' 정도에 해당한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 4세 남아, 말더듬 시작 10개월 경과\\n• 부모가 훈련을 받고 가정의 일상 대화에서 중재를 실시함\\n• 아동의 유창한 발화에 \\\"부드럽게 잘 말했네!\\\"라고 칭찬함\\n• 말더듬이 나타나면 가끔씩 \\\"방금 좀 울퉁불퉁했네, 다시 말해 볼까?\\\"라고 요청함\\n• 치료사는 매주 말더듬 심한 정도(SR) 기록을 확인함\",\"q\":\"위 중재에 해당하는 프로그램은?\",\"choices\":[\"스토커 프로브 테크닉\",\"말더듬수정법\",\"리드콤 프로그램\",\"점진적 발화길이 및 복잡성 증가 프로그램(GILCU)\",\"페일린 부모-아동 상호작용치료\"],\"answer\":3,\"explain\":\"부모가 일상 대화에서 유창한 발화에 언어적 칭찬을, 말더듬에 간헐적인 수정 요청을 제공하고 말더듬 심한 정도(SR) 척도로 진전을 관리하는 것은 조작적 조건화 기반의 리드콤 프로그램이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말에서 말을 더듬은 직후 잠시 멈추고, 긴장을 풀고 나서 방금 더듬었던 낱말을 편안한 방식으로 다시 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"가벼운 조음접촉\",\"빠져나오기\",\"예비책\",\"둔감화\",\"취소\"],\"answer\":5,\"explain\":\"취소(cancellation)는 말더듬이 끝난 후 잠시 멈추었다가 더듬은 낱말을 긴장을 줄인 방식으로 다시 말하는 기법이다. 빠져나오기는 말더듬 도중에, 예비책은 말더듬이 예상되는 낱말 이전에 적용한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 말속도가 빠르고 불규칙함\\n• 음절 생략과 낱말 축약이 잦아 명료도가 낮음\\n• 주제에서 자주 벗어나며 발화 조직화가 어려움\\n• 자신의 말 문제를 잘 인식하지 못함\",\"q\":\"다음 특성을 보이는 대상자에게 우선적으로 적용할 중재 방법은?\",\"choices\":[\"가벼운 조음접촉 훈련\",\"호흡-발성 협응 훈련\",\"말속도 조절과 자기 모니터링 훈련\",\"둔감화 훈련\",\"회피행동 감소 훈련\"],\"answer\":3,\"explain\":\"속화(말빠름증)의 핵심 중재는 말속도를 조절하고(속도 낮추기, 쉼 넣기) 자신의 말을 인식하는 자기 모니터링 능력을 기르는 것이다. 속화 화자는 문제 인식이 부족하므로 녹음 청취 등 인식 훈련이 중요하다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 말더듬 중증도 산출에 포함되는 요소로 옳게 묶인 것은?\",\"choices\":[\"말더듬 빈도, 말속도, 조음정확도\",\"말더듬 빈도, 어휘다양도, 발화길이\",\"지속시간, 음도, 강도\",\"의사소통태도, 자아효능감, 회피 정도\",\"말더듬 빈도, 지속시간, 신체적 부수행동\"],\"answer\":5,\"explain\":\"SSI-4는 말더듬 빈도(%SS), 지속시간(가장 긴 말더듬 3개의 평균), 신체적 부수행동의 세 요소 점수를 합산하여 중증도를 산출한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인의 치료 전후 자아효능감 척도(SESAS) 수행 점수가 30점에서 74점으로 상승하였다.\",\"q\":\"위 변화에 대한 해석으로 옳은 것은?\",\"choices\":[\"말더듬 빈도가 증가하였다\",\"의사소통 태도가 부정적으로 변하였다\",\"말에 대한 통제력이 감소하였다\",\"치료 효과가 나타나지 않았다\",\"유창하게 말할 수 있다는 자신감(자아효능감)이 향상되었다\"],\"answer\":5,\"explain\":\"자아효능감 척도(SESAS)는 점수가 높을수록 유창하게 말할 수 있다는 자신감이 크다는 의미이므로, 30→74점의 상승은 자아효능감(자신감)의 향상을 나타낸다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 아동의 아버지가 아이가 말을 더듬을 때마다 \\\"천천히 말해\\\", \\\"다시 말해 봐\\\"라고 지적하고, 아이의 말을 대신 끝맺어 준다.\",\"q\":\"위 아버지에게 제공할 상담 내용으로 가장 적절한 것은?\",\"choices\":[\"말을 더듬을 때마다 즉시 교정해 주세요\",\"아이의 말을 대신 끝맺어 시간을 줄여 주세요\",\"지적을 줄이고 아이의 말을 끝까지 기다리며 편안한 대화 분위기를 만들어 주세요\",\"더 빠르게 말하는 시범을 보여 주세요\",\"말더듬는 낱말을 여러 번 반복시켜 주세요\"],\"answer\":3,\"explain\":\"말더듬 아동에게는 지적·교정·대신 말하기·시간 압박이 유창성을 방해한다. 지적을 줄이고 아이의 말을 끝까지 기다리며 느리고 편안한 대화 분위기를 만드는 것이 권장된다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 핵심행동(core behavior)에 해당하지 않는 것은?\",\"choices\":[\"막힘\",\"소리 연장\",\"단어부분 반복\",\"음절 반복\",\"눈 깜빡임\"],\"answer\":5,\"explain\":\"핵심행동은 반복, 연장, 막힘이다. 눈 깜빡임, 고개 젖히기 등은 핵심행동에서 벗어나거나 피하려는 부수행동(이차행동)이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"발달성 말더듬에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"대부분 성인기에 처음 발생한다\",\"남아가 여아보다 유병률이 높다\",\"상당수는 자연회복된다\",\"발생에 유전적 요인이 관여한다\",\"대부분 학령전기(2~5세)에 시작된다\"],\"answer\":1,\"explain\":\"발달성 말더듬은 대부분 2~5세 학령전기에 시작되며 남아에게 더 흔하고 유전적 요인이 관여하며 상당수 자연회복된다. 성인기 최초 발병이 흔하다는 설명은 옳지 않다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬수정법(Van Riper)의 궁극적인 목표로 가장 적절한 것은?\",\"choices\":[\"말더듬을 편안하고 쉽게 더듬는 것\",\"완전히 유창한 말을 확립하는 것\",\"말더듬을 완전히 제거하는 것\",\"회피행동을 강화하는 것\",\"느린 말을 영구적으로 사용하는 것\"],\"answer\":1,\"explain\":\"말더듬수정법은 말더듬을 완전히 없애기보다, 두려움과 긴장을 줄여 편안하고 쉽게 더듬으면서 자유롭게 의사소통하도록 하는 것을 목표로 한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"정상적 비유창성(기타 비유창성)에 가장 가까운 것은?\",\"choices\":[\"긴장된 막힘\",\"소리 연장\",\"긴장을 동반한 음절 반복\",\"간투사·구 반복·수정\",\"긴장을 동반한 일음절 낱말 반복\"],\"answer\":4,\"explain\":\"간투사, 구 반복, 수정, 미완성 등은 정상적 비유창성(기타 비유창성)에 해당한다. 긴장을 동반한 음절 반복·연장·막힘은 진성 비유창성(SLD)에 가깝다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"신경학적 말더듬(neurogenic stuttering)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"뇌졸중·외상성 뇌손상 등 이후에 발생할 수 있다\",\"적응효과가 잘 나타나지 않는다\",\"낱말 유형·위치와 무관하게 비유창이 나타나는 경향이 있다\",\"발달성 말더듬에 비해 부수행동과 불안이 적은 편이다\",\"심리적 외상이 주된 원인이다\"],\"answer\":5,\"explain\":\"신경학적 말더듬은 신경학적 손상 이후 발생하고 적응효과가 미약하며 낱말 위치와 무관하게 나타난다. 심리적 외상이 주된 원인인 것은 심인성 말더듬의 특징이므로 옳지 않다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬을 '말더듬을 예상하고 이를 피하려는 투쟁 반응'으로 설명하는 이론은?\",\"choices\":[\"대뇌우세이론\",\"진단착오이론\",\"요구용량모델\",\"예기투쟁가설\",\"이원이론\"],\"answer\":4,\"explain\":\"예기투쟁가설은 화자가 말더듬을 예상하고 이에 대해 긴장·투쟁·회피하는 반응이 말더듬을 유발·악화시킨다고 보는 이론이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"같은 문장을 여러 번 반복해서 읽을 때 말더듬 빈도가 점차 감소하는 현상은?\",\"choices\":[\"일관성효과\",\"자발회복\",\"인접효과\",\"후속효과\",\"적응효과\"],\"answer\":5,\"explain\":\"적응효과는 동일한 자료를 반복해서 읽을수록 말더듬 빈도가 감소하는 현상이다. 일관성효과는 같은 낱말·위치에서 반복적으로 더듬는 경향을 말한다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 화자의 회피행동(회피)에 해당하지 않는 것은?\",\"choices\":[\"에둘러 말하기\",\"막힘 도중 고개를 뒤로 젖히기\",\"말할 순서를 미루기\",\"전화 받기를 피하기\",\"낱말을 다른 낱말로 바꾸어 말하기\"],\"answer\":2,\"explain\":\"낱말 대치, 에두르기, 상황·순서 회피는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘 도중 벗어나려고 고개를 젖히는 것은 이미 시작된 말더듬에서 빠져나오려는 탈출행동이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법(fluency shaping)에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"느린 말·부드러운 발성 시작으로 유창한 말을 확립한다\",\"가벼운 조음접촉을 활용한다\",\"확립된 유창성을 점차 실제 상황으로 일반화한다\",\"말더듬 자체보다 유창한 말 패턴 형성에 초점을 둔다\",\"취소·빠져나오기로 말더듬 순간을 수정하는 데 초점을 둔다\"],\"answer\":5,\"explain\":\"취소·빠져나오기는 말더듬수정법의 기법이다. 유창성완성법은 느린 말·부드러운 시작·가벼운 조음접촉으로 유창한 말을 확립하여 일반화하는 접근이므로 '말더듬 순간 수정에 초점'은 옳지 않다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"자신의 말을 짧은 지연 후에 듣게 하여 말속도를 늦추고 유창성을 유도하는 기기는?\",\"choices\":[\"차폐기\",\"지연청각피드백(DAF)\",\"비음측정기\",\"전기성문파형기\",\"스펙트로그램\"],\"answer\":2,\"explain\":\"지연청각피드백(DAF)은 화자의 말을 짧게 지연시켜 다시 들려줌으로써 말속도를 늦추고 유창성을 촉진하는 기기이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"q\":\"에릭슨 의사소통태도 검사(S-24)가 측정하는 것은?\",\"choices\":[\"말더듬 빈도\",\"말더듬 지속시간\",\"의사소통에 대한 태도\",\"신체적 부수행동\",\"말속도\"],\"answer\":3,\"explain\":\"S-24는 말더듬 화자가 의사소통에 대해 갖는 부정적 태도(신념)를 측정하는 자기보고식 척도이다.\"},{\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 말을 더듬을 것으로 예상되는 낱말 직전에, 미리 긴장을 줄이고 부드럽게 첫소리에 접근하여 산출하였다.\",\"q\":\"위 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"예비책\",\"빠져나오기\",\"취소\",\"둔감화\",\"고유수용감각 훈련\"],\"answer\":1,\"explain\":\"예비책(preparatory set)은 말더듬이 예상되는 낱말을 산출하기 직전에 미리 긴장을 줄이고 부드럽게 접근하여 말더듬을 예방하는 기법이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성 산출의 음원-여과기 이론(source-filter theory)에 대한 설명으로 옳은 것은?\",\"choices\":[\"포먼트는 성대 진동수에 의해 직접 결정된다\",\"기본주파수는 성도의 길이에 의해서만 결정된다\",\"성대 진동이 음원이 되고 성도(공명강)가 여과기로 작용하여 포먼트가 형성된다\",\"음원과 여과기는 물리적으로 동일한 구조이다\",\"여과기 기능은 폐의 공기압이 담당한다\"],\"answer\":3,\"explain\":\"음원-여과기 이론에서는 성대 진동이 음원(source)이 되어 기본주파수와 배음을 만들고, 성도(공명강)가 여과기(filter)로 작용하여 특정 주파수를 강조·감쇠함으로써 포먼트가 형성된다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"발성 시 음도(pitch)를 높이는 생리적 기전으로 옳은 것은?\",\"choices\":[\"성대가 짧아지고 두꺼워져 진동수가 증가한다\",\"윤상갑상근이 수축하여 성대가 길어지고 긴장되어 진동수가 증가한다\",\"호기류량만 증가시키면 음도가 높아진다\",\"성문하압을 낮추면 음도가 높아진다\",\"갑상피열근만 이완시키면 음도가 높아진다\"],\"answer\":2,\"explain\":\"음도는 성대의 진동수에 의해 결정된다. 윤상갑상근(CT)이 수축하면 성대가 길어지고 긴장되어 진동수가 증가하므로 음도가 높아진다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"공기역학적 검사 결과\\n• 폐활량: 정상 범위\\n• 최대연장발성시간(MPT): 5.2초\\n• 평균호기류율: 260 mL/sec (증가)\\n• 성문하압: 정상 범위\\n• 청지각적으로 기식적이고 약한 음성\",\"q\":\"다음 결과에서 추정되는 음성장애는?\",\"choices\":[\"근긴장성 발성장애\",\"라인케부종\",\"편측 성대마비\",\"내전형 연축성발성장애\",\"변성발성장애\"],\"answer\":3,\"explain\":\"짧은 MPT와 증가된 평균호기류율은 성문폐쇄부전으로 공기가 새고 있음을 의미하며, 기식적이고 약한 음성과 함께 편측 성대마비를 시사한다. 근긴장성 발성장애나 내전형 연축성발성장애는 과내전 양상으로 호기류율이 감소하는 경향을 보인다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"환자가 지각하는 음성 문제가 일상생활에 미치는 신체적·기능적·정서적 영향을 평가하는 자기보고식 도구는?\",\"choices\":[\"CAPE-V\",\"최대연장발성시간(MPT)\",\"GRBAS 척도\",\"음성장애지수(VHI)\",\"음성범위프로파일(VRP)\"],\"answer\":4,\"explain\":\"음성장애지수(VHI)는 환자 스스로 음성 문제로 인한 신체·기능·정서 영역의 불편감을 평정하는 자기보고식 설문이다. GRBAS와 CAPE-V는 평가자의 청지각적 평가 도구이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음향학적 검사(MDVP) 결과\\n• 기본주파수(F0): 성별·연령 규준 범위\\n• 주파수변동률(jitter): 3.85 % (증가)\\n• 진폭변동률(shimmer): 7.9 % (증가)\\n• 소음대배음비(NHR): 0.28 (증가)\",\"q\":\"위 결과에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성 강도가 과도하게 크다\",\"음성 신호의 주기성이 낮다\",\"습관적 음도가 비정상적으로 높다\",\"공명 문제가 확인된다\",\"정상 음질에 해당한다\"],\"answer\":2,\"explain\":\"jitter(주파수 변동률), shimmer(진폭 변동률), NHR(소음대배음비)의 증가는 성대 진동의 규칙성이 떨어지고 신호 내 소음 성분이 많다는 것, 즉 음성 신호의 주기성이 낮음을 의미한다. F0 자체는 정상 범위이므로 음도 문제로 볼 수 없다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 32세 초등교사\\n• 후두내시경: 양측 성대 막성부 중간 지점의 대칭적인 양성 병변, 모래시계 모양의 성문폐쇄\\n• 음성 남용력: 하루 6교시 수업, 큰 소리 사용 빈번\",\"q\":\"위 환자에게 우선적으로 적용할 치료는?\",\"choices\":[\"반폐쇄성도훈련(SOVT) 등 음성치료와 음성위생 교육\",\"보툴리눔 독소 주입\",\"성대 주입술\",\"제I형 갑상성형술\",\"후두미세수술\"],\"answer\":1,\"explain\":\"양측성·대칭성 병변과 모래시계형 성문폐쇄는 성대결절의 전형적 소견이며, 음성 남용이 원인이므로 일차적 치료는 음성치료(반폐쇄성도훈련 등)와 음성위생 교육이다. 수술은 충분한 음성치료 후에도 호전이 없을 때 고려한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"20대 여성이 특별한 신체 질환 없이 갑자기 목소리가 나오지 않아 속삭이는 소리로만 말한다. 그러나 기침과 웃음에서는 정상적인 유성음이 산출되고, 후두내시경에서 구조적 이상이 없다.\",\"q\":\"위 사례에 대한 설명으로 옳은 것은?\",\"choices\":[\"성대의 구조적 병변에 의한 기질적 실성증이다\",\"반드시 수술적 치료가 필요하다\",\"기침·웃음에서도 발성이 전혀 불가능하다\",\"기능적(심인성) 실성증으로, 기침·웃음 등 보존된 반사적 발성을 치료의 출발점으로 활용한다\",\"신경 손상에 의한 성대마비가 원인이다\"],\"answer\":4,\"explain\":\"구조적 이상 없이 기침·웃음 등 반사적(생리적) 발성에서 정상 유성음이 가능한 것은 기능적(심인성) 실성증의 특징이다. 보존된 생리적 발성(기침·헛기침·허밍)에서 모음·낱말로 확장하며 발성을 재확립한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 17세 남학생, 변성기가 지났으나 지속적으로 높은 음도로 말함\\n• 후두 구조와 호르몬 검사: 정상\",\"q\":\"위 대상자에게 적용할 수 있는 음성치료 기법은?\",\"choices\":[\"음도를 더 높여 가성구 발성을 훈련한다\",\"큰 소리로 고음 발성을 반복시킨다\",\"속삭이는 소리로 말하게 한다\",\"성대 과내전을 유도한다\",\"갑상연골 전방을 부드럽게 눌러 낮은 음도의 발성을 유도한다\"],\"answer\":5,\"explain\":\"변성발성장애는 변성기 이후에도 높은 음도가 유지되는 기능적 장애로, 손가락 조작법(갑상연골을 후하방으로 눌러 성대를 이완)으로 낮은 진성 발성을 유도한 뒤 이를 안정화하는 치료가 효과적이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 68세 남성, 파킨슨병 진단\\n• 약한 음성 강도, 단조로운 음도\\n• 말끝이 흐려지며 가족들이 잘 알아듣지 못함\\n• 스스로는 목소리가 작다고 느끼지 않음\",\"q\":\"위 환자에게 가장 적절한 음성치료는?\",\"choices\":[\"차폐 기법으로 무의식적 강도 증가 유도\",\"속삭임 발성 훈련\",\"가성대 발성 훈련\",\"리실버만음성치료(LSVT)로 큰 강도의 발성을 집중 훈련\",\"저작하기 기법\"],\"answer\":4,\"explain\":\"리실버만음성치료(LSVT LOUD)는 파킨슨병 환자를 대상으로 '크게 말하기'에 집중하여 고강도로 반복 훈련하는 근거 기반 치료로, 강도 증가와 함께 명료도 개선 효과가 보고된다. 감각 인식 저하(스스로 작다고 느끼지 않음)에 대한 보정 훈련도 포함한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"내전형 연축성발성장애에 대한 설명으로 옳지 않은 것은?\",\"choices\":[\"모음으로 시작하는 낱말에서 쥐어짜는 듯한 음성 끊김이 나타난다\",\"구조적 성대 병변이 원인이다\",\"속삭임·노래·웃음에서는 증상이 감소한다\",\"보툴리눔 독소 주입이 대표적 치료이다\",\"성대 내전근의 불수의적 연축에 의한 신경학적 장애이다\"],\"answer\":2,\"explain\":\"내전형 연축성발성장애는 구조적 병변 없이 성대 내전근의 불수의적 연축으로 발생하는 신경학적 장애이다. 모음 시작 낱말에서 음성 끊김이 두드러지고 속삭임·노래에서 감소하며 보툴리눔 독소로 치료하므로 '구조적 성대 병변이 원인'은 옳지 않다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두전적출 환자의 식도발성(esophageal speech)에 대한 설명으로 옳은 것은?\",\"choices\":[\"폐의 공기를 성대로 보내어 소리를 낸다\",\"삼킨 공기를 식도에 넣었다가 역류시켜 인두식도분절을 진동시켜 소리를 낸다\",\"반드시 보철(프로테제) 삽입이 있어야 발성할 수 있다\",\"전기 진동자를 목에 대어 소리를 낸다\",\"성대가 재생되어 발성이 가능해진다\"],\"answer\":2,\"explain\":\"식도발성은 공기를 삼켜 식도에 넣었다가 역류시키면서 인두식도분절(PE segment)을 진동시켜 소리를 내는 무후두 음성 방법으로, 별도의 보철 없이도 훈련할 수 있다. 성대는 재생되지 않는다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 74세 남성, 목소리가 약하고 쉽게 피로하다고 호소\\n• 후두내시경: 성대 위축과 활모양의 성문틈, 병변 없음\\n• 신경학적 이상 없음\",\"q\":\"위 환자에게 적절한 음성치료 접근은?\",\"choices\":[\"음성 사용을 최대한 제한한다\",\"속삭임으로 말하도록 한다\",\"보툴리눔 독소 주입을 의뢰한다\",\"밀기 접근법 등 성대내전 강화 훈련을 실시한다\",\"음도를 낮추는 훈련을 실시한다\"],\"answer\":4,\"explain\":\"노인성 음성(성대 위축, 활모양 성문틈)은 성문폐쇄부전이 핵심이므로 밀기 접근법, 강한 성대접촉 유도, 반폐쇄성도훈련 등 성대내전과 발성 효율을 강화하는 음성치료가 적절하다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"GRBAS 척도에서 'R'이 의미하는 음성 특성은?\",\"choices\":[\"전반적 중증도\",\"조조성(거친 소리)\",\"기식성\",\"무력성\",\"긴장성\"],\"answer\":2,\"explain\":\"GRBAS에서 G는 전반적 중증도, R은 조조성(거친 소리), B는 기식성, A는 무력성, S는 긴장성을 의미한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"• 후두내시경: 편측 성대의 유경성(줄기 달린) 병변\\n• 갑작스러운 고함·큰 소리 이후 발생\\n• 거칠고 낮은 음성\",\"q\":\"위 소견에서 의심되는 질환은?\",\"choices\":[\"성대결절\",\"성대구증\",\"라인케부종\",\"후두유두종\",\"성대폴립\"],\"answer\":5,\"explain\":\"성대폴립은 흔히 편측성이며 유경성 또는 무경성으로 나타나고, 갑작스러운 음성 남용(고함) 후 발생하는 경우가 많다. 성대결절은 대개 양측성·대칭성이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"후두에 기질적 병변이 없으나 후두 주변 근육의 과도한 긴장으로 쥐어짜는 음성을 보이는 장애는?\",\"choices\":[\"편측 성대마비\",\"변성발성장애\",\"연축성 발성장애\",\"근긴장성 발성장애\",\"성대구증\"],\"answer\":4,\"explain\":\"근긴장성 발성장애(MTD)는 구조적 병변 없이 후두 내·외근의 과도한 긴장으로 발생하는 기능적 음성장애이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음향학적 분석에서 진폭(강도)의 주기 간 변동률을 나타내는 측정치는?\",\"choices\":[\"shimmer\",\"F0\",\"NHR\",\"CPP\",\"jitter\"],\"answer\":1,\"explain\":\"shimmer는 주기 간 진폭(강도)의 변동률, jitter는 주기 간 기본주파수의 변동률, NHR은 소음 대 배음 비율이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"s/z 비율이 1.4 이상으로 증가했을 때 가장 우선적으로 의심할 수 있는 것은?\",\"choices\":[\"호흡 기능만의 저하\",\"조음기관의 구조적 이상\",\"청력 손실\",\"성대 병변에 의한 성문폐쇄부전\",\"공명강의 협착\"],\"answer\":4,\"explain\":\"/s/는 호흡 기능, /z/는 호흡과 발성 기능을 함께 반영한다. s/z 비율이 1.4 이상이면 /z/ 연장이 상대적으로 짧다는 의미로, 성대 병변에 의한 성문폐쇄부전을 시사한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"음성위생 교육 내용으로 적절하지 않은 것은?\",\"choices\":[\"충분한 수분을 섭취한다\",\"소음 환경에서 큰 소리로 말하는 것을 줄인다\",\"음성 휴식이 필요할 때 속삭이는 소리로 말한다\",\"습관적인 헛기침을 줄인다\",\"과도한 카페인 섭취를 줄인다\"],\"answer\":3,\"explain\":\"속삭이기는 성대에 오히려 과도한 긴장을 주므로 음성위생법으로 권장되지 않는다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"갑상샘 수술 후 편측 성대마비를 유발하기 쉬운 신경은?\",\"choices\":[\"되돌이후두신경\",\"안면신경\",\"설하신경\",\"삼차신경\",\"부신경\"],\"answer\":1,\"explain\":\"미주신경의 분지인 되돌이후두신경(반회후두신경)은 갑상샘 수술 시 손상되기 쉬우며, 손상되면 편측 성대마비로 기식적이고 약한 음성이 나타난다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"최대연장발성시간(MPT)이 정상보다 현저히 짧게 나타날 때 가장 우선적으로 시사되는 것은?\",\"choices\":[\"청력의 손실\",\"성문폐쇄부전 또는 호흡 지지의 부족\",\"성대의 과내전\",\"조음기관의 이상\",\"공명강의 이상\"],\"answer\":2,\"explain\":\"MPT는 한 번의 흡기 후 낼 수 있는 최대 발성 시간으로, 현저히 짧으면 성문폐쇄부전으로 공기가 새거나 호흡 지지가 부족함을 시사한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"소아에게서 반복적으로 재발하며, 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양의 병변이 자라 애성과 기도 폐쇄를 유발하는 질환이 있다.\",\"q\":\"위 설명에 해당하는 질환으로 가장 적절한 것은?\",\"choices\":[\"성대결절\",\"라인케부종\",\"재발성 후두유두종\",\"성대구증\",\"근긴장성 발성장애\"],\"answer\":3,\"explain\":\"재발성 후두유두종(재발성 호흡기 유두종증)은 인유두종바이러스(HPV) 감염과 관련되어 성대에 사마귀 모양 병변이 자라 애성·기도폐쇄를 유발하며, 소아에서 반복 재발하는 경향이 있다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 접촉 양상(개방·폐쇄 주기)을 비침습적으로 간접 측정하는 데 가장 적절한 도구는?\",\"choices\":[\"전기성문파형검사(EGG)\",\"나조미터\",\"스펙트로그램\",\"순음청력검사\",\"음성범위프로파일\"],\"answer\":1,\"explain\":\"전기성문파형검사(EGG)는 성대 접촉 면적의 변화를 통해 성대의 개방·폐쇄 주기(접촉 양상)를 비침습적으로 간접 측정하는 도구이다.\"},{\"subject\":\"음성장애\",\"session\":2,\"stem\":\"음성치료에서 대상자에게 빨대를 물컵에 담그고 그 안으로 소리를 내게 하거나, 입술 트릴·허밍을 하며 발성하도록 하였다.\",\"q\":\"위 기법들의 공통된 원리로 옳은 것은?\",\"choices\":[\"성대를 강하게 접촉시켜 강도를 높인다\",\"성문을 완전히 개방하여 기식성을 늘린다\",\"음도를 최대한 높여 가성구로만 발성한다\",\"호흡을 멈추고 발성한다\",\"성도를 부분적으로 좁혀(반폐쇄) 성대 접촉 부담을 줄이고 효율적인 발성을 유도한다\"],\"answer\":5,\"explain\":\"빨대 발성, 입술 트릴, 허밍 등은 반폐쇄성도훈련(SOVT)으로, 성도를 부분적으로 좁혀 성문 상부 압력을 높임으로써 성대 접촉 부담을 줄이고 효율적인 발성을 유도한다.\"},{\"subject\":\"음성장애\",\"session\":2,\"q\":\"성대의 유리연을 따라 고랑(구)이 패여 성문폐쇄부전과 기식 음성을 보이는 질환은?\",\"choices\":[\"후두유두종\",\"성대결절\",\"라인케부종\",\"성대폴립\",\"성대구증\"],\"answer\":5,\"explain\":\"성대구증은 성대 유리연을 따라 고랑이 패이는 질환으로, 성문폐쇄부전으로 인한 기식 음성과 음성 피로가 나타난다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동1: 4세, 어리고 정상적인 아동에게 나타나는 음운변동(종성생략, 연구개음 전방화)이 지속됨\\n아동2: 혀 내밀기로 인한 /ㅅ/ 왜곡이 모든 문맥에서 일관됨\\n아동3: 어중초성 생략과 어두 자음 첨가 등 발달과정에서 드문 오류패턴이 일관되게 나타남\\n아동4: 같은 낱말을 말할 때마다 40% 이상 서로 다른 형태로 산출함\",\"q\":\"Dodd의 분류에 따라 '음운지연'에 해당하는 아동은?\",\"choices\":[\"아동1\",\"아동2\",\"아동3\",\"아동4\",\"해당 아동 없음\"],\"answer\":1,\"explain\":\"음운지연은 정상 발달과정에서 나타나는 음운변동이 해당 연령이 지나서도 지속되는 경우이다. 아동2는 조음장애(일관된 왜곡), 아동3은 비전형적 패턴이 일관된 일관적 음운장애, 아동4는 비일관적 음운장애에 해당한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n사자 → [타다]\\n수박 → [투박]\\n코끼리 → [토끼리]\\n그네 → [드네]\\n호랑이 → [호앙이]\",\"q\":\"다음 조음음운장애 아동의 발화에서 나타난 음운오류패턴에 대한 설명으로 적절한 것은?\",\"choices\":[\"종성생략이 2회 나타났다\",\"유음의 활음화가 2회 나타났다\",\"마찰음과 파찰음의 파열음화가 3회 나타났다\",\"연구개음 전방화가 3회 나타났다\",\"비음화가 1회 나타났다\"],\"answer\":3,\"explain\":\"파열음화는 사자→[타다]에서 /ㅅ/→[ㅌ], /ㅈ/→[ㄷ] 2회, 수박→[투박]에서 /ㅅ/→[ㅌ] 1회로 총 3회이다. 연구개음 전방화는 코끼리→[토끼리], 그네→[드네]의 2회, 호랑이→[호앙이]는 유음 탈락이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어(자음) → 아동 발화\\n가방 (ㄱ,ㅂ,ㅇ) → [가바]\\n모자 (ㅁ,ㅈ) → [모다]\\n나무 (ㄴ,ㅁ) → [나무]\\n딸기 (ㄸ,ㄹ,ㄱ) → [딸기]\",\"q\":\"위 낱말 검사에서 아동의 자음정확도(PCC)는?\",\"choices\":[\"6/10 × 100\",\"7/10 × 100\",\"8/10 × 100\",\"9/10 × 100\",\"10/10 × 100\"],\"answer\":3,\"explain\":\"조음해야 할 자음은 총 10개이며, 오류는 '가방'의 종성 /ㅇ/ 생략과 '모자'의 /ㅈ/→[ㄷ] 대치 2개이다. 따라서 자음정확도 = 8/10 × 100 = 80%.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"6세 아동이 어두 /ㅅ/를 [ㄷ]로 대치하는 오류를 보인다. 무의미음절 /사/, /수/에서는 청각·시각 단서를 주면 정조음이 가능하여, 낱말 수준으로 확장하려 한다.\",\"q\":\"어두 /ㅅ/ 확립을 위한 낱말 수준 훈련 목록으로 가장 적절한 것은?\",\"choices\":[\"단추, 다리, 도장\",\"거울, 가위, 구두\",\"사탕, 손, 시소\",\"라면, 리본, 로봇\",\"모자, 무지개, 미소\"],\"answer\":3,\"explain\":\"확립 단계에서는 목표음이 포함된 낱말로 연습해야 하므로 어두에 /ㅅ/가 오는 '사탕, 손, 시소'가 적절하다. 목표음이 안정되면 어중·어말, 문장 수준으로 점차 일반화한다. 나머지는 목표음 /ㅅ/가 포함되지 않은 낱말들이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"순음청력검사 결과\\n• 양측 기도 청력역치: 45 dB HL\\n• 양측 골도 청력역치: 10 dB HL\\n• 기도-골도 차(air-bone gap): 35 dB\",\"q\":\"위 결과에 대한 해석으로 적절한 것은?\",\"choices\":[\"감각신경성 난청이 의심된다\",\"전음성 난청이 의심되며 중이 질환 확인이 필요하다\",\"정상 청력이다\",\"혼합성 난청이며 내이 손상이 확실하다\",\"청신경 종양이 의심된다\"],\"answer\":2,\"explain\":\"골도 역치는 정상이나 기도 역치가 상승하여 기도-골도 차가 존재하는 것은 전음성 난청의 소견으로, 중이염 등 외이·중이의 병변을 확인해야 한다. 감각신경성 난청은 기도·골도가 함께 상승하고 기도-골도 차가 없다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n바지 → [빠지]\\n도로 → [또로]\\n가방 → [까방]\",\"q\":\"위 오류에서 아동이 아직 확립하지 못한 변별자질의 대립은?\",\"choices\":[\"지속성\",\"긴장성\",\"비음성\",\"설측성\",\"공명성\"],\"answer\":2,\"explain\":\"평음 /ㅂ, ㄷ, ㄱ/이 경음 /ㅃ, ㄸ, ㄲ/으로 대치되는 경음화로, [−긴장성]과 [+긴장성]의 대립을 아직 확립하지 못한 것이다. 따라서 긴장성 자질의 대조를 목표로 중재한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 목록이 매우 제한된 어린 아동에게 실시하는 독립분석(independent analysis)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음운변동의 출현 빈도를 분석한다\",\"자음정확도(PCC)를 산출한다\",\"목표 음소 대비 정확도를 백분율로 나타낸다\",\"성인의 목표 형태와 비교하지 않고 아동이 산출한 말소리 목록과 음절 구조를 그 자체로 분석한다\",\"오류음의 자극반응도를 측정한다\"],\"answer\":4,\"explain\":\"독립분석은 성인(목표) 형태와 대조하지 않고 아동이 실제로 산출한 말소리 목록·음절 구조 등을 그 자체로 기술하는 방법으로, 말소리 목록이 제한적인 어린 아동에게 유용하다. 목표와 비교하여 정확도·음운변동을 분석하는 것은 관계분석에 해당한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"문맥검사 결과: 아동은 /ㅅ/를 /ㅣ/ 모음 앞에서만 정조음하고('시소'의 '시'), 다른 모음 문맥에서는 [ㄷ]로 대치한다.\",\"q\":\"위 결과를 활용한 중재 방법으로 적절한 것은?\",\"choices\":[\"비언어적 구강운동 훈련만 실시한다\",\"정조음이 가능한 /시/ 문맥에서 시작하여 다른 모음 문맥으로 점차 확대한다\",\"오류가 가장 심한 문맥부터 훈련한다\",\"/ㅅ/ 훈련을 중단하고 다른 음소를 목표로 한다\",\"모든 모음 문맥을 무작위로 섞어 훈련한다\"],\"answer\":2,\"explain\":\"문맥검사에서 발견된 촉진 문맥(정조음 가능한 문맥)은 치료의 출발점이 된다. /시/에서 안정적으로 산출한 뒤 다른 모음 문맥, 음절·낱말 수준으로 점진적으로 일반화시키는 것이 적절하다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운인식 능력의 발달에 대한 설명으로 옳은 것은?\",\"choices\":[\"음소 분절이 음절 수 세기보다 먼저 발달한다\",\"음소 조작이 각운(rhyme) 인식보다 먼저 발달한다\",\"음운인식은 읽기(해독) 능력과 관련이 없다\",\"음소 탈락이 음절 탈락보다 이른 시기에 발달한다\",\"음절 수준의 인식이 음소 수준의 인식보다 먼저 발달한다\"],\"answer\":5,\"explain\":\"음운인식은 대체로 음절 → 초성-각운(음절체-종성) → 음소 순으로, 큰 단위에서 작은 단위로 발달한다. 따라서 음절 수준 인식이 음소 수준 인식보다 먼저 발달하며, 음운인식은 낱말 해독의 중요한 기초가 된다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 3세 남아, 기질적 결함 없음\\n• 산출 가능한 자음이 /ㅁ, ㅂ, ㅃ/로 제한됨\\n• 모음은 대부분 정확하게 산출함\",\"q\":\"위 아동의 초기 목표 낱말 선정 원칙으로 가장 적절한 것은?\",\"choices\":[\"아동의 목록에 없는 음소들로만 구성된 낱말을 선정한다\",\"아동이 이미 산출할 수 있는 음소로 구성되고 일상에서 자주 쓰는 기능적 낱말을 선정한다\",\"음절 수가 많고 구조가 복잡한 낱말부터 선정한다\",\"의미보다 발음 난이도가 높은 낱말을 우선 선정한다\",\"사용 빈도가 낮은 낱말을 선정한다\"],\"answer\":2,\"explain\":\"초기 목표 낱말은 아동이 이미 산출 가능한 음소(여기서는 양순음)와 단순한 음절 구조로 이루어지고, 일상에서 의사소통 기능이 높은 낱말이 적절하다. 성공 경험을 통해 의사소통 동기를 높이는 것이 목적이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"구개열 수술을 받은 5세 아동이 파열음·마찰음을 산출할 때 코로 공기가 새고 과다비성이 동반되어 말명료도가 낮다.\",\"q\":\"위 아동의 비강누출·과다비성을 간편하게 선별하는 방법으로 적절한 것은?\",\"choices\":[\"교호운동속도(DDK)를 측정한다\",\"청력역치를 측정한다\",\"차가운 거울(비경)을 콧구멍 아래 대고 압력자음 산출 시 김서림을 관찰한다\",\"최대연장발성시간을 측정한다\",\"수용어휘력 검사를 실시한다\"],\"answer\":3,\"explain\":\"구강 압력이 필요한 압력자음(파열음·마찰음)을 산출할 때 콧구멍 아래 댄 거울(비경)에 김이 서리는지 관찰하면 비강누출과 과다비성을 간편하게 선별할 수 있다. 나머지는 공명·비강누출을 직접 선별하는 방법이 아니다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"청능훈련의 단계를 발달 순서대로 바르게 나열한 것은?\",\"choices\":[\"탐지 → 변별 → 확인 → 이해\",\"변별 → 탐지 → 확인 → 이해\",\"탐지 → 확인 → 변별 → 이해\",\"확인 → 변별 → 탐지 → 이해\",\"이해 → 확인 → 변별 → 탐지\"],\"answer\":1,\"explain\":\"청능훈련은 소리의 유무를 아는 탐지, 두 소리가 같은지 다른지 아는 변별, 무슨 소리인지 알아 반응하는 확인, 말의 의미를 이해하는 이해의 순서로 진행한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'불-풀'처럼 하나의 음소 차이로 의미가 달라지는 낱말 쌍을 이용하는 음운론적 치료 접근은?\",\"choices\":[\"짝자극 기법\",\"최소대립쌍 치료\",\"주기법\",\"전통적 조음지시법\",\"구강운동 훈련\"],\"answer\":2,\"explain\":\"최소대립쌍 치료는 한 음소의 차이로 의미가 구별되는 낱말 쌍을 이용하여 음운 대조를 인식시키고 목표음 산출을 유도하는 음운론적 접근이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"명료도가 매우 낮은 아동을 대상으로 여러 오류 음운패턴을 주기마다 순환하며 목표로 삼는 접근법은?\",\"choices\":[\"짝자극 기법\",\"감각운동 기법\",\"조음점 지시법\",\"주기법(cycles approach)\",\"변별자질 접근법\"],\"answer\":4,\"explain\":\"주기법은 명료도가 매우 낮은 아동을 대상으로 오류 음운 패턴들을 주기(cycle)마다 순환하며 목표로 하는 음운적 접근이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"오류음을 청각·시각적 단서나 모방 조건에서 정확히 산출할 수 있는 정도로, 목표음 선정과 예후 판단에 활용되는 것은?\",\"choices\":[\"자극반응도\",\"말명료도\",\"말소리목록\",\"일관성\",\"음운인식\"],\"answer\":1,\"explain\":\"자극반응도(stimulability)는 단서나 모방 조건에서 오류음을 바르게 산출할 수 있는 정도로, 치료 목표음 선정과 예후 판단에 활용된다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 대한 설명으로 가장 적절한 것은?\",\"choices\":[\"화자가 산출한 자음의 정확도만을 의미한다\",\"음도와 강도의 적절성을 의미한다\",\"발화의 문법적 정확성을 의미한다\",\"말속도의 적절성을 의미한다\",\"청자가 화자의 말을 알아듣는 정도를 의미한다\"],\"answer\":5,\"explain\":\"말명료도는 화자가 전달한 말을 청자가 얼마나 알아듣는가의 정도로, 오류 말소리의 수·유형·일관성, 운율 등 여러 요인의 영향을 받는다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"/ㅂ/와 /ㅁ/를 구별하는 변별자질은?\",\"choices\":[\"비음성\",\"지속성\",\"설정성\",\"긴장성\",\"고설성\"],\"answer\":1,\"explain\":\"/ㅂ/와 /ㅁ/는 모두 양순음이지만 /ㅁ/는 [+비음성], /ㅂ/는 [-비음성]으로 비음성 자질에서 대립한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음 중 일반적으로 가장 늦게 습득되는 말소리는?\",\"choices\":[\"/ㄷ/\",\"/ㅂ/\",\"/ㅁ/\",\"/ㅅ/\",\"/ㅇ/\"],\"answer\":4,\"explain\":\"비음·파열음은 조기에 습득되는 반면, 치경마찰음 /ㅅ, ㅆ/은 가장 늦게 완전 습득되는 말소리에 속한다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n라면 → [야면]\\n리본 → [이본]\\n나라 → [나야]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"유음의 비음화\",\"파열음화\",\"종성생략\",\"전방화\",\"유음의 단순화(활음화)\"],\"answer\":5,\"explain\":\"유음 /ㄹ/이 활음 /j/ 또는 생략으로 나타나는 유음의 단순화(활음화)이다. 유음의 비음화라면 /ㄹ/이 /ㄴ/으로 대치된다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"목표 단어 → 아동 발화\\n코 → [고]\\n토끼 → [도끼]\\n파 → [바]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"탈기식음화(이완음화)\",\"전방화\",\"경음화\",\"파열음화\",\"기식음화\"],\"answer\":1,\"explain\":\"격음(기식음) /ㅋ, ㅌ, ㅍ/이 평음 /ㄱ, ㄷ, ㅂ/으로 대치되는 탈기식음화(이완음화)이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"아동이 산출한 5개의 낱말 중 3개를 목표 형태와 완전히 동일하게 산출하였다.\",\"q\":\"이 아동의 단어단위정확률(PWC)은?\",\"choices\":[\"0.4\",\"0.5\",\"0.6\",\"0.7\",\"0.8\"],\"answer\":3,\"explain\":\"단어단위정확률(PWC) = 완전히 정확하게 산출한 낱말 수 ÷ 전체 낱말 수 = 3 ÷ 5 = 0.6이다. 낱말 전체를 단위로 조음 능력을 평가하는 지표이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"거울·설압자 등을 이용하여 조음 위치와 방법을 직접 지시하고 시범을 통해 목표음을 유도하는 접근법은?\",\"choices\":[\"주기법\",\"최소대립쌍 치료\",\"조음점 지시법(전통적 접근법)\",\"음운변동 접근법\",\"상위음운 접근법\"],\"answer\":3,\"explain\":\"조음점 지시법(전통적 접근법)은 조음 위치와 방법을 직접 알려주고 청각·시각·촉각 단서와 시범으로 목표음을 유도하는 운동 중심의 조음치료 접근이다.\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표 → 아동 발화\\n코끼리 → [토끼리]\\n가위 → [다위]\\n그네 → [드네]\\n나무 → [나무]\\n우산 → [우산]\",\"q\":\"위 발화에서 공통적으로 나타난 음운변동은?\",\"choices\":[\"연구개음의 전방화\",\"치경음의 후방화\",\"마찰음의 파열음화\",\"종성생략\",\"유음의 단순화\"],\"answer\":1,\"explain\":\"연구개음 /ㄱ, ㅋ, ㄲ/이 치경음 /ㄷ, ㅌ/으로 조음 위치가 앞으로 이동하여 대치되는 연구개음의 전방화이다(코끼리→[토끼리], 가위→[다위], 그네→[드네]).\"},{\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"(아동 발화를 전사한 자료)\\n목표: 할머니랑 시장 가서 사탕 샀어요\\n아동: [하머니랑 시장 가서 사탕 다떠요]\",\"q\":\"위 발화에 대한 분석으로 옳은 것은?\",\"choices\":[\"자음정확도는 100%이다\",\"종성생략이 나타났다\",\"유음의 비음화가 나타났다\",\"모든 마찰음을 정확하게 조음하였다\",\"연구개음 전방화가 나타났다\"],\"answer\":2,\"explain\":\"'할머니→[하머니]'에서 종성 /ㄹ/이 생략되었다. 또한 '샀어요→[다떠요]'에서 마찰음 /ㅅ/이 파열음으로 대치되어 마찰음을 정확히 조음하지 못했고, 자음정확도는 100%가 아니다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사 B는 자신이 훈련받거나 슈퍼비전을 받은 적이 없는 삼킴장애 환자를, 관련 교육 없이 인터넷 정보에만 의존하여 단독으로 중재하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용으로 가장 적절한 것은?\",\"choices\":[\"비밀유지의 의무\",\"차별금지\",\"연구 윤리\",\"전문성 유지의 의무\",\"동료 간 협력\"],\"answer\":4,\"explain\":\"언어재활사는 자신이 훈련받고 역량을 갖춘 전문 영역 내에서 서비스를 제공해야 한다. 준비되지 않은 영역을 교육·슈퍼비전 없이 단독으로 수행하는 것은 전문성 유지 의무 위반이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"만 7세 등록 장애아동의 보호자가 발달재활서비스 이용을 문의하였다. 가구 소득은 기준 중위소득 이내이다.\",\"q\":\"위 사례에 대한 안내로 옳은 것은?\",\"choices\":[\"소득 수준에 따라 본인부담금을 부담하며 바우처로 언어·청능 등 재활서비스를 이용할 수 있다\",\"등록 장애아동은 이 서비스를 이용할 수 없다\",\"만 18세 이상만 이용할 수 있다\",\"소득과 무관하게 전액 무료로 지원된다\",\"의료기관 입원 치료만 지원한다\"],\"answer\":1,\"explain\":\"발달재활서비스는 만 18세 미만 등록 장애아동에게 소득 수준별 본인부담금과 함께 언어·청능 등 재활 바우처를 지원한다. 따라서 이 아동은 대상에 해당하며 바우처로 서비스를 이용할 수 있다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"연구 주제: \\\"태블릿 기반 AAC 앱 훈련이 뇌성마비 아동의 자발적 의사소통 시도 횟수에 미치는 효과\\\"\",\"q\":\"위 연구에서 '태블릿 기반 AAC 앱 훈련'에 해당하는 변인은?\",\"choices\":[\"혼란변인\",\"매개변인\",\"통제변인\",\"종속변인\",\"독립변인\"],\"answer\":5,\"explain\":\"독립변인은 연구자가 조작하여 그 효과를 알아보려는 처치이다. 이 연구에서 처치인 'AAC 앱 훈련'이 독립변인이고, 그 결과로 측정되는 '자발적 의사소통 시도 횟수'가 종속변인이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어치료 효과에 관한 여러 개별 연구의 결과를 통계적으로 통합하여 전체 효과크기를 분석하는 연구 방법은?\",\"choices\":[\"횡단적 기술연구\",\"단일대상연구\",\"질적 사례연구\",\"델파이 조사\",\"메타분석\"],\"answer\":5,\"explain\":\"메타분석은 동일 주제의 개별 연구 결과들을 수집하여 통계적으로 통합·분석함으로써 전체적인 효과크기를 산출하는 연구 방법이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 회기 목표를 \\\"그림자극 10개 중 8개에서 목표 낱말의 어두 /ㅅ/를 3회기 연속 정조음한다.\\\"로 진술하였다.\",\"q\":\"위 행동목표 진술에 포함된 요소로 볼 수 없는 것은?\",\"choices\":[\"수행 조건(그림자극)\",\"관찰 가능한 목표 행동\",\"사용할 치료 기법\",\"도달 준거(10개 중 8개)\",\"숙달 기준(3회기 연속)\"],\"answer\":3,\"explain\":\"잘 진술된 행동목표는 수행 조건, 관찰 가능한 행동, 도달 준거와 숙달 기준을 포함한다. 그러나 '어떤 기법으로 가르칠지'(치료 기법)는 목표 진술 자체에 포함되는 요소가 아니다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"「장애인복지법」상 1급 언어재활사 국가시험 응시자격으로 옳지 않은 것은?\",\"choices\":[\"2급 자격 없이 언어재활 경력이 5년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 대학원에서 석사·박사학위를 받고 언어재활 경력이 1년 이상이면 응시할 수 있다\",\"2급 취득 후 관련 학과 학사학위 취득자로서 언어재활 경력이 3년 이상이면 응시할 수 있다\",\"응시자격에서 요구하는 경력은 언어재활 분야의 경력을 의미한다\",\"2급 언어재활사 자격 취득이 전제되어야 한다\"],\"answer\":1,\"explain\":\"1급은 2급 자격 취득을 전제로, 관련 대학원 석·박사학위+경력 1년 또는 관련 학과 학사학위+경력 3년의 요건을 갖춰야 한다. 2급 자격 없이 경력만으로는 응시할 수 없다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"개인 언어재활센터에 정규직으로 채용된 언어재활사가 4대 사회보험 가입에 대해 문의하였다.\",\"q\":\"다음 중 보험료를 전액 사업주(사용자)가 부담하는 것은?\",\"choices\":[\"국민연금\",\"산업재해보상보험\",\"국민건강보험\",\"고용보험(실업급여)\",\"노인장기요양보험\"],\"answer\":2,\"explain\":\"산업재해보상보험료는 사업주가 전액 부담한다. 국민연금·국민건강보험·고용보험(실업급여)은 근로자와 사업주가 분담한다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어발달지연 아동의 어머니가 평소 아동에게 빠른 속도로 길고 복잡한 문장을 사용하고, 아동이 반응하기 전에 다음 말을 이어간다.\",\"q\":\"위 어머니에게 제공할 상호작용 지도 내용으로 가장 적절한 것은?\",\"choices\":[\"말속도를 늦추고 짧고 단순한 문장으로 말하며 아동의 반응을 기다려 주세요\",\"더 빠른 속도로 많은 어휘를 들려주세요\",\"낮고 단조로운 억양으로 말해 주세요\",\"아동이 말할 내용을 미리 대신 말해 주세요\",\"아동의 발화를 그때그때 자주 교정해 주세요\"],\"answer\":1,\"explain\":\"언어발달을 촉진하려면 느린 말속도, 짧고 단순한 문장, 풍부한 억양과 함께 아동이 반응할 시간을 충분히 기다려 주는 것이 중요하다. 빠르고 복잡한 발화나 대신 말하기, 잦은 교정은 바람직하지 않다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"초등학교 3학년 아동이 지능은 정상 범위이나 낱말을 소리 내어 읽을 때 매우 느리고 자주 틀린다. 반면 들려주는 이야기의 이해력은 또래 수준이다.\",\"q\":\"위 아동에게 우선적으로 고려할 수 있는 진단은?\",\"choices\":[\"지적장애\",\"청각장애\",\"단순언어장애\",\"난독증(읽기 특정학습장애)\",\"말소리장애\"],\"answer\":4,\"explain\":\"지능과 듣기 이해는 정상이나 낱말 해독(정확성·유창성)에서 두드러진 어려움을 보이는 것은 신경생물학적 원인의 난독증(읽기 특정학습장애)의 핵심 양상이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"표준화 검사 적용이 어려운 무발화 영유아의 의사소통 능력을 평가하는 방법으로 가장 적절한 것은?\",\"choices\":[\"표준화 언어검사의 원점수만으로 언어 연령을 산출한다\",\"놀이·일상 상황에서 발성·몸짓·공동주의 등 비구어 의사소통을 관찰하고 보호자 면담을 병행한다\",\"아동이 말을 시작할 때까지 평가를 미룬다\",\"보호자 정보는 주관적이므로 배제한다\",\"단일 회기의 검사 점수만으로 장애를 확정한다\"],\"answer\":2,\"explain\":\"무발화 영유아는 표준화 검사 적용이 제한되므로, 자연스러운 놀이·일상 맥락에서 발성의 양과 질, 몸짓, 공동주의, 모방 등 비구어 의사소통을 반복 관찰하고 보호자 면담으로 정보를 보완한다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"언어재활사가 SNS에 내담자의 실명과 평가 결과를 본인·보호자의 동의 없이 게시하였다.\",\"q\":\"위 사례에서 위반된 언어재활사 윤리강령의 내용은?\",\"choices\":[\"연구 윤리\",\"비밀유지의 의무\",\"전문성 유지의 의무\",\"동료 간 협력\",\"차별금지\"],\"answer\":2,\"explain\":\"내담자의 개인정보·평가결과를 동의 없이 외부에 공개하는 것은 윤리강령의 비밀유지(비밀보장) 의무 위반이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 보수교육에 대한 설명으로 옳은 것은?\",\"choices\":[\"1급 언어재활사에게만 부과된다\",\"최초 자격 취득 시 한 번만 받으면 된다\",\"이수 여부는 자격 유지와 무관하다\",\"대학원 재학생만 이수 대상이다\",\"자격 유지를 위해 매년 정해진 시간의 교육을 이수해야 한다\"],\"answer\":5,\"explain\":\"언어재활사는 자격 유지를 위해 매년 정해진 시간의 보수교육을 이수해야 하며, 정당한 사유 없이 연속하여 이수하지 않으면 제재 대상이 될 수 있다. 급수와 무관하게 자격을 가진 언어재활사에게 적용된다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"중재 효과 연구에서 독립변인 외에 종속변인에 영향을 줄 수 있는 변인들을 일정하게 통제하는 주된 이유는?\",\"choices\":[\"연구 대상자 수를 줄이기 위해\",\"종속변인의 측정을 생략하기 위해\",\"관찰된 변화가 독립변인 때문임을 확신할 수 있도록 내적 타당도를 높이기 위해\",\"연구 결과의 일반화를 제한하기 위해\",\"독립변인을 무작위로 바꾸기 위해\"],\"answer\":3,\"explain\":\"외생변인(혼란변인)을 통제하면 종속변인의 변화가 독립변인(중재) 때문임을 더 확신할 수 있어 연구의 내적 타당도가 높아진다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"한 명 또는 소수의 대상에게 기초선-중재 등의 설계를 적용하여 중재 효과를 검증하는 연구 방법은?\",\"choices\":[\"상관연구\",\"집단비교연구\",\"단일대상연구\",\"델파이 조사\",\"메타분석\"],\"answer\":3,\"explain\":\"단일대상연구는 개별 대상에게 기초선-중재-반전(또는 중다기초선) 등의 설계를 적용하여 중재의 효과를 실험적으로 검증하는 방법으로, 언어재활 임상연구에서 널리 사용된다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"검사도구가 측정하고자 하는 바를 정확하게 측정하는 정도를 의미하는 것은?\",\"choices\":[\"타당도\",\"실용도\",\"신뢰도\",\"객관도\",\"난이도\"],\"answer\":1,\"explain\":\"타당도는 검사가 측정하려는 개념을 실제로 측정하고 있는가의 정도이고, 신뢰도는 측정의 일관성·안정성을 의미한다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"언어재활사의 업무로 가장 적절한 것은?\",\"choices\":[\"청력역치의 의학적 진단\",\"수술적 처치\",\"약물 처방\",\"난청의 외과적 치료\",\"의사소통장애의 평가·중재 및 상담\"],\"answer\":5,\"explain\":\"언어재활사는 의사소통장애(언어·조음·유창성·음성·삼킴 등)의 평가와 중재, 대상자·보호자 상담 및 교육을 수행한다. 의학적 진단·처방·수술은 의사의 업무이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"아버지는 한국어, 어머니는 몽골어를 사용하는 가정의 4세 아동이 두 언어에 모두 노출되어 있다. 평가 결과 한국어 어휘 수가 또래보다 적었다.\",\"q\":\"위 아동의 어휘 능력 평가·해석으로 가장 적절한 것은?\",\"choices\":[\"두 언어에서 아는 개념을 합산한 개념 어휘로 능력을 판단한다\",\"한국어 어휘 수만으로 어휘 지체를 판정한다\",\"두 언어 노출이 어휘 지체의 원인이라고 설명한다\",\"몽골어 사용을 즉시 중단하도록 권고한다\",\"이중언어 아동에게 단일언어 규준을 그대로 적용한다\"],\"answer\":1,\"explain\":\"이중언어 아동의 어휘를 한 언어의 낱말 수만으로 판단하면 과소평가되므로, 두 언어에 걸쳐 아는 개념을 합산한 개념 어휘(conceptual vocabulary)로 평가해야 한다. 이중언어 노출 자체는 언어장애의 원인이 아니다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"q\":\"연구 참여자에게 연구의 목적·절차·위험을 설명하고 자발적 참여 동의를 받는 절차는?\",\"choices\":[\"사후 보고\",\"사전 동의(고지된 동의)\",\"디브리핑\",\"무선 할당\",\"이중 은폐\"],\"answer\":2,\"explain\":\"사전 동의(고지된 동의, informed consent)는 연구 참여 전에 목적·절차·이익·위험 등을 충분히 설명하고 자발적 동의를 받는 연구윤리의 기본 절차이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"첫 상담에서 언어재활사가 보호자에게 상담의 목적과 진행 방식을 설명하고, 아동의 발달력과 가정에서의 의사소통 모습에 대한 정보를 수집하며 신뢰 관계를 형성하였다.\",\"q\":\"위 상담에 해당하는 부모상담 단계는?\",\"choices\":[\"실행 단계\",\"종결 단계\",\"추후 단계\",\"초기(준비) 단계\",\"평가 단계\"],\"answer\":4,\"explain\":\"상담의 목적·절차 안내, 라포 형성, 기초 정보 수집은 상담의 초기(준비) 단계에서 이루어진다. 공감적 반응을 바탕으로 구체적 문제해결 방안을 제시·실행하는 것은 실행 단계이다.\"},{\"subject\":\"언어재활현장실무\",\"session\":2,\"stem\":\"다문화가족·한부모가족 등의 자녀 중 언어발달이 지연된 아동에게 언어평가와 언어촉진 교육을 제공하는 지원사업이 있다.\",\"q\":\"위 사업에 대한 설명으로 옳은 것은?\",\"choices\":[\"등록 장애아동만을 대상으로 하는 의료 서비스이다\",\"대상 아동의 언어를 평가하고 부모교육을 포함한 언어촉진 서비스를 제공한다\",\"성인을 대상으로 하는 직업재활 사업이다\",\"자격 없이 누구나 중재를 제공할 수 있다\",\"평가 없이 모든 아동에게 동일한 프로그램을 제공한다\"],\"answer\":2,\"explain\":\"다문화가족 자녀 등을 위한 언어발달지원사업은 언어발달이 지연된 아동을 평가하고, 부모교육을 포함한 언어촉진 교육을 제공한다. 등록 장애아동을 주 대상으로 하는 발달재활서비스와는 대상·성격이 다르다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌손상 환자\\n• 근긴장 저하, 안정 시 떨림 없음\\n• 보행이 불안정함\\n• 손가락-코 검사에서 목표를 지나치고 흔들림(측정이상)\",\"q\":\"손상 부위로 가장 적절한 것은?\",\"choices\":[\"시상\",\"소뇌\",\"해마\",\"기저핵\",\"측두엽\"],\"answer\":2,\"explain\":\"근긴장 저하·측정이상(dysmetria)·보행 실조·의도성 떨림은 소뇌 손상의 특징이다. 기저핵 손상은 안정 시 떨림·경직·운동완만을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"혀를 내밀게 하니 혀끝이 왼쪽으로 치우치고, 왼쪽 혀의 위축이 관찰됨.\",\"q\":\"손상된 뇌신경으로 옳은 것은?\",\"choices\":[\"왼쪽 안면신경(7번)\",\"오른쪽 설하신경(12번)\",\"왼쪽 설하신경(12번)\",\"왼쪽 삼차신경(5번)\",\"오른쪽 미주신경(10번)\"],\"answer\":3,\"explain\":\"혀 운동은 설하신경(12번)이 지배하며, 손상 시 혀를 내밀면 손상된 쪽으로 편위되고 그쪽 혀가 위축된다. 왼쪽으로 편위+왼쪽 위축이면 왼쪽 설하신경 손상이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사 설명\\n• 실어증 유무와 유형을 확인함\\n• 스스로 말하기·알아듣기·따라말하기·이름대기를 평가함\\n• 실어증지수(AQ)를 산출함\",\"q\":\"해당하는 검사는?\",\"choices\":[\"한국판 간이정신상태검사(K-MMSE)\",\"한국판 몬트리올 인지평가(K-MoCA)\",\"실어증-신경언어장애 선별검사(STAND)\",\"파라다이스 한국판 웨스턴 실어증 검사(PK-WAB-R)\",\"한국 실어증 감별진단 검사(KTDDA)\"],\"answer\":4,\"explain\":\"AQ 산출과 4개 언어영역 평가로 실어증 유형을 진단하는 검사는 PK-WAB-R이다. STAND는 선별검사, K-MMSE·K-MoCA는 인지선별검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: (사과 그림) \\\"이름이 무엇입니까?\\\"\\n환자: \\\"그… 먹는 거… 빨갛고 둥근… 그거요.\\\"\",\"q\":\"이 환자가 보이는 이름대기 오류 유형은?\",\"choices\":[\"보속증\",\"음소착어\",\"에두르기(circumlocution)\",\"신조착어\",\"의미착어\"],\"answer\":3,\"explain\":\"목표 낱말을 산출하지 못하고 그 특징이나 기능을 우회적으로 설명하는 것은 에두르기이다. 의미착어는 관련 낱말로 대치('사과'→'포도'), 음소착어는 음소 대치('사과'→'다과')이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말을 의미적으로 관련된 낱말로 대치함('버스'→'기차')\\n• 비단어('무핀') 읽기가 거의 불가능함\\n• 추상어보다 구체어를 더 잘 읽음\",\"q\":\"이 실독증 유형은?\",\"choices\":[\"표층실독증\",\"음운실독증\",\"무시실독증\",\"순수실독증\",\"심층실독증\"],\"answer\":5,\"explain\":\"의미착어(의미 대치), 비단어 읽기의 심한 손상, 구체어>추상어의 심상성 효과는 심층실독증의 특징이다. 표층은 불규칙어 규칙화 오류, 음운실독증은 비단어의 선택적 손상을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화는 유창하나 착어가 섞임\\n• 청각적 이해가 심하게 손상됨\\n• 따라말하기도 손상됨\\n• 병식이 부족함\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"연결피질감각실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\"],\"answer\":4,\"explain\":\"유창한 착어 발화+이해 손상+따라말하기 손상+병식 부족은 베르니케실어증이다. 따라말하기가 보존되면 연결피질감각실어증으로 감별한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 느리고 노력성인 비유창 발화\\n• 조사·어미 등 문법형태소를 생략하는 전보식 발화\\n• 따라말하기 손상, 단순 지시 이해는 비교적 양호\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"명칭실어증\",\"베르니케실어증\",\"전도실어증\",\"전반실어증\",\"브로카실어증\"],\"answer\":5,\"explain\":\"비유창·노력성·전보식(실문법) 발화, 손상된 따라말하기, 비교적 양호한 이해는 브로카실어증의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 유창한 발화에 음소착어가 잦음\\n• 청각적 이해는 양호함\\n• 따라말하기가 선택적으로 뚜렷하게 손상됨\",\"q\":\"이 환자의 실어증 유형과 관련 손상 구조로 옳은 것은?\",\"choices\":[\"베르니케실어증 – 상측두회\",\"전도실어증 – 궁상다발\",\"브로카실어증 – 하전두회\",\"명칭실어증 – 각회\",\"전반실어증 – 광범위\"],\"answer\":2,\"explain\":\"유창+이해 양호+따라말하기의 선택적 손상+음소착어는 전도실어증이며, 브로카·베르니케 영역을 잇는 궁상다발 손상과 관련된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌졸중에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"색전증은 다른 부위에서 생긴 혈전 조각이 혈관을 막아 갑자기 발생한다\",\"허혈성 뇌졸중의 대표적 원인은 혈관 파열이다\",\"혈전증은 혈관벽이 풍선처럼 부풀어 발생한다\",\"출혈성 뇌졸중은 허혈성보다 발생 빈도가 높다\",\"지주막하출혈은 혈관이 서서히 좁아져 발생한다\"],\"answer\":1,\"explain\":\"색전증은 다른 부위(심장 등)에서 형성된 색전이 이동해 혈관을 막아 갑작스럽게 발생한다. 허혈성이 출혈성보다 흔하며, 허혈성의 주 기전은 혈전·색전에 의한 혈관 폐색이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌경색 환자\\n• 시력은 정상\\n• 단어의 어휘성이나 자소-음소 일치 여부와 상관없이 읽기 수행이 저하됨\\n• 글자를 쓰는 데에도 어려움을 보임\",\"q\":\"손상 가능성이 가장 높은 동맥은?\",\"choices\":[\"전대뇌동맥\",\"후대뇌동맥\",\"척추기저동맥\",\"내경동맥 안분지\",\"중대뇌동맥\"],\"answer\":5,\"explain\":\"읽기·쓰기(각회·모서리위이랑 등 좌측 두정-측두 영역)를 담당하는 영역은 중대뇌동맥 관류 영역에 속한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 환자의 PK-WAB-R 결과\\n• AQ 37점, 스스로 말하기 6/20(비유창)\\n• 알아듣기 양호, 따라말하기 비교적 보존\",\"q\":\"이 프로파일에 가장 부합하는 실어증 유형은?\",\"choices\":[\"연결피질운동실어증\",\"전도실어증\",\"베르니케실어증\",\"명칭실어증\",\"연결피질감각실어증\"],\"answer\":1,\"explain\":\"비유창하나 이해가 양호하고 따라말하기가 유창성에 비해 뚜렷하게 보존되면 연결피질운동실어증이다. 브로카는 따라말하기도 손상된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"마비말장애 유형에 대한 설명이다.\",\"q\":\"유형과 특징이 옳게 연결된 것은?\",\"choices\":[\"실조형 – 불규칙한 조음 오류와 과도·불규칙한 강세\",\"경직형 – 과비성과 기식음이 두드러짐\",\"이완형 – 쥐어짜는 노력성 음성\",\"과소운동형 – 불수의적 과다 운동\",\"과다운동형 – 단조로운 음도와 감소된 강도\"],\"answer\":1,\"explain\":\"실조형(소뇌)은 불규칙 조음·과도 강세가 특징이다. 이완형은 과비성·기식(하부운동신경), 경직형은 쥐어짜는 노력성 음성, 과소운동형은 단조·약한 강도, 과다운동형은 불수의 운동을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 같은 낱말에서도 매번 다른 조음 오류를 보임\\n• 말소리를 찾는 듯한 입술·혀의 모색행동\\n• 근력 약화는 뚜렷하지 않음\",\"q\":\"이 환자의 말장애로 가장 적절한 것은?\",\"choices\":[\"이완형 마비말장애\",\"경직형 마비말장애\",\"말실행증\",\"실조형 마비말장애\",\"과소운동형 마비말장애\"],\"answer\":3,\"explain\":\"비일관적 조음 오류와 모색행동, 뚜렷하지 않은 근력 약화는 말운동 프로그래밍의 손상인 말실행증의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"말실행증과 마비말장애를 감별하려 한다.\",\"q\":\"말실행증에 더 부합하는 특징은?\",\"choices\":[\"일관된 위치에서 반복적으로 같은 오류\",\"근긴장 항진에 따른 느린 말\",\"지속적인 과비성\",\"조음 오류가 비일관적이고 모색행동이 관찰됨\",\"호흡·발성의 지속적 약화\"],\"answer\":4,\"explain\":\"말실행증은 비일관적 오류와 모색행동이 특징인 반면, 마비말장애는 근육 약화·마비에 따른 비교적 일관된 오류와 음성·공명 이상을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"수정바륨삼킴검사 단계별 결과\\n• 구강 준비·구강 운반 단계: 정상\\n• 인두 단계: 삼킴반사 지연, 후두계곡·조롱박오목에 잔여물\\n• 식도 단계: 정상\",\"q\":\"문제가 있는 단계는?\",\"choices\":[\"구강 준비 단계\",\"구강 운반 단계\",\"정상 소견\",\"식도 단계\",\"인두 단계\"],\"answer\":5,\"explain\":\"삼킴반사 지연과 인두 잔여물은 인두 단계의 문제이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"삼킴장애 환자에게서 다음 소견이 관찰됨.\\n• 삼킨 뒤에도 기침·목소리 변화가 없으나 흉부 영상에서 흡인 소견이 확인됨\",\"q\":\"이 현상에 대한 설명으로 옳은 것은?\",\"choices\":[\"정상적인 방어 반응이다\",\"무증상 흡인(silent aspiration)으로, 기도 방어 반사 저하를 시사한다\",\"구강 준비 단계의 문제이다\",\"식도 이완불능증의 특징이다\",\"항상 미각 저하가 원인이다\"],\"answer\":2,\"explain\":\"기침 등 외현적 징후 없이 성문 아래로 이물이 넘어가는 것을 무증상 흡인이라 하며, 감각·기도 방어 반사 저하와 관련되어 위험이 크다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"정상 삼킴 생리의 단계에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"구강 준비 단계에서 삼킴반사가 유발된다\",\"인두 단계에서 연구개가 하강하여 비강으로 음식이 넘어간다\",\"인두 단계에서 후두가 상승하고 성대가 닫혀 기도를 보호한다\",\"식도 단계는 수의적으로 조절된다\",\"구강 운반 단계에서 상부식도괄약근이 열린다\"],\"answer\":3,\"explain\":\"인두 단계에서 후두 거상·성대 폐쇄·후두개 하강으로 기도가 보호되고 상부식도괄약근이 열려 음식이 식도로 이동한다. 연구개는 상승하여 비인두를 막는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"DSM-5에서 알츠하이머병으로 인한 경도 신경인지장애를 진단하려 한다.\",\"q\":\"필수적인 조건으로 옳은 것은?\",\"choices\":[\"일상활동의 독립성이 상실됨\",\"삼킴능력의 저하\",\"한 가지 이상 인지영역에서 이전 수행 수준보다 경미한 저하가 있으나 독립성은 유지됨\",\"말초 지각능력의 저하\",\"운동마비의 동반\"],\"answer\":3,\"explain\":\"경도 신경인지장애는 인지영역의 경미한 저하가 있으나 일상생활의 독립성은 유지된다. 독립성이 상실되면 주요(major) 신경인지장애로 진단한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"인지의사소통장애·치매 유형에 대한 설명이다.\",\"q\":\"옳게 연결된 것은?\",\"choices\":[\"알츠하이머 치매 – 발병 초기부터 비유창 발화가 두드러짐\",\"혈관성 치매 – 베타 아밀로이드 축적이 주된 원인\",\"원발진행실어증 – 뇌혈관 질환에 의한 급성 발병\",\"파킨슨병 치매 – 발병 초기부터 심한 실어증\",\"전두측두엽 치매 – 초기부터 성격·행동·언어 변화가 두드러짐\"],\"answer\":5,\"explain\":\"전두측두엽 치매는 초기부터 성격·행동 변화 또는 언어 변화가 두드러진다. 알츠하이머는 초기 기억·이름대기 저하(발화는 유창), 베타 아밀로이드는 알츠하이머, PPA는 서서히 진행되는 퇴행성 언어장애이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"검사자: \\\"방금 불러드린 숫자 5-2-8-1을 거꾸로 말해 보세요.\\\"\\n환자: 수행에 어려움을 보임\",\"q\":\"이 과제가 주로 평가하는 기억 유형은?\",\"choices\":[\"절차기억\",\"암묵기억\",\"작업기억\",\"서술적 장기기억\",\"점화(priming)\"],\"answer\":3,\"explain\":\"정보를 잠시 유지하면서 조작(역순 말하기)하는 능력은 작업기억이다. 절차·암묵기억은 기술·습관에 관한 비서술 기억이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"기억 유형에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"절차기억은 사건·사실에 대한 의식적 기억이다\",\"서술기억은 자전거 타기 같은 기술에 대한 기억이다\",\"의미기억은 개인적 사건의 시공간 정보를 포함한다\",\"절차기억은 반복 학습된 기술·습관에 대한 비서술 기억이다\",\"일화기억은 일반 지식에 대한 기억이다\"],\"answer\":4,\"explain\":\"절차기억은 반복 학습된 운동·기술 습관에 대한 비서술(암묵) 기억이다. 서술기억은 의미기억(일반 지식)과 일화기억(개인적 사건)으로 나뉜다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"우반구 손상 환자의 의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"문법형태소를 생략한 전보식 발화가 핵심이다\",\"따라말하기만 선택적으로 손상된다\",\"심한 청각적 이해 손상과 착어가 핵심이다\",\"은유·함축 이해의 어려움, 단조로운 운율, 좌측 무시가 나타난다\",\"비단어 읽기가 선택적으로 손상된다\"],\"answer\":4,\"explain\":\"우반구 손상은 화용·비유·함축 이해의 어려움, 운율(감정 억양) 저하, 좌측 무시가 특징이다. 나머지는 좌반구 실어증 유형의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌 영상 기법에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"CT는 방사선을 쓰지 않는다\",\"기능적 MRI(fMRI)는 과제 수행 시 혈류 변화를 통해 뇌 활성을 반영한다\",\"fMRI는 뇌의 구조만 보여주고 기능은 반영하지 못한다\",\"구조적 MRI는 실시간 신경 활동의 전기 신호를 측정한다\",\"EEG는 대사(포도당) 소비를 측정한다\"],\"answer\":2,\"explain\":\"fMRI는 과제 중 혈중 산소 수준(BOLD) 변화를 통해 뇌 기능 활성을 간접 측정한다. 구조적 MRI·CT는 구조 영상, EEG는 전기활동, PET는 대사를 측정한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"뇌자기공명영상(B-MRI)에서 양측 선조체에 저음영을 보이는 환자의 말 특성\\n검사자: \\\"몇 시에 약을 드세요?\\\"\\n환자: \\\"나는 약을 12시에, 12시에 먹어야, 12시에 먹어야, 먹어야 해\\\"\",\"q\":\"이 환자가 보이는 증상은?\",\"choices\":[\"반향어증\",\"동어반복증(palilalia)\",\"실구어증\",\"감금증후군\",\"발성실행증\"],\"answer\":2,\"explain\":\"자신의 낱말·구를 반복하는 것은 동어반복증(palilalia)으로, 기저핵(선조체) 병변과 관련될 수 있다. 반향어는 상대의 말을 따라 반복하는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"실어증 평가의 하위 영역에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"유창성은 청각적 이해 점수로만 판단한다\",\"이름대기 손상은 거의 모든 실어증에서 흔하게 관찰된다\",\"따라말하기 손상은 모든 실어증에서 동일하게 나타난다\",\"알아듣기 검사는 발화의 문법성만 평가한다\",\"스스로 말하기는 읽기 능력으로 대체 평가한다\"],\"answer\":2,\"explain\":\"이름대기 손상은 유형과 무관하게 대부분의 실어증에서 흔히 관찰된다. 따라말하기 손상 여부는 유형 감별의 핵심 지표로 유형마다 다르다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"외상성 뇌손상(TBI) 환자의 인지-의사소통 특징이다.\",\"q\":\"가장 적절한 설명은?\",\"choices\":[\"주의·기억·집행기능 저하와 함께 화용(주제 유지·상황 파악)의 어려움이 두드러진다\",\"언어의 음운·문법 손상이 핵심이며 인지는 보존된다\",\"항상 심한 청각적 이해 손상을 보인다\",\"반드시 편측 무시를 동반한다\",\"항상 비유창 실어증 형태로 나타난다\"],\"answer\":1,\"explain\":\"TBI는 주의·기억·집행기능 등 인지 저하와 함께 화용(주제 유지, 장황함, 상황 파악)의 어려움이 두드러지는 인지-의사소통장애 양상을 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"낱말 읽기\\n• 실제 낱말('학교','사람') 읽기는 양호함\\n• 비단어('두랍','무핀') 읽기가 선택적으로 손상됨\",\"q\":\"이 실독증 유형과 손상된 경로는?\",\"choices\":[\"표층실독증 – 어휘 경로\",\"심층실독증 – 의미 경로\",\"순수실독증 – 시각 입력\",\"음운실독증 – 음운(자소-음소 변환) 경로\",\"무시실독증 – 주의\"],\"answer\":4,\"explain\":\"실제 낱말은 잘 읽으나 비단어 읽기가 선택적으로 손상되면 자소-음소 변환(음운 경로) 손상인 음운실독증이다. 표층은 불규칙어 규칙화 오류가 핵심이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"대뇌 반구의 기능 편재화에 대한 설명이다.\",\"q\":\"일반적인 오른손잡이 성인에서 옳은 것은?\",\"choices\":[\"운율의 정서적 측면과 화용은 주로 우반구가 관여한다\",\"언어의 음운·통사 처리는 주로 우반구가 담당한다\",\"좌측 무시는 좌반구 손상에서 흔하다\",\"좌반구는 얼굴 정서 인식만 담당한다\",\"우반구 손상은 전형적인 실문법증을 유발한다\"],\"answer\":1,\"explain\":\"대부분의 오른손잡이에서 언어의 음운·통사는 좌반구가 우세하고, 정서적 운율·화용·시공간 주의는 우반구가 관여한다. 좌측 무시는 우반구 손상에서 흔하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"초기 알츠하이머병 환자의 이름대기 저하를 다루는 치료 원리이다.\",\"q\":\"가장 적절한 것은?\",\"choices\":[\"무오류 학습과 간격 회상 등 보존된 기억 체계를 활용한다\",\"오류를 많이 경험하게 하여 스스로 교정하게 한다\",\"복잡한 통사 이해 과제를 우선 훈련한다\",\"구강 근력 강화를 우선한다\",\"제약유발 언어치료로 구어를 강제한다\"],\"answer\":1,\"explain\":\"치매에서는 무오류 학습과 간격 회상, 환경 단서 등 보존된 절차·점화 기억을 활용하는 것이 효과적이며, 오류 경험을 최소화하는 것이 원칙이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"신경언어장애\",\"session\":1,\"stem\":\"• 발화·청각적 이해·따라말하기·이름대기가 모두 심하게 손상됨\\n• 몇몇 자동구어(인사말 등)와 상황에 맞는 표정·제스처만 남아 있음\",\"q\":\"이 환자의 실어증 유형은?\",\"choices\":[\"브로카실어증\",\"베르니케실어증\",\"전도실어증\",\"명칭실어증\",\"전반실어증\"],\"answer\":5,\"explain\":\"네 가지 언어 영역이 모두 심하게 손상되고 자동구어·비언어 수단만 남으면 전반실어증이다. 광범위한 좌반구(중대뇌동맥 영역) 손상과 관련된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"단어 '참새'에 포함된 자음(ㅊ, ㅁ, ㅅ)의 조음방법을 순서대로 옳게 나열한 것은?\",\"choices\":[\"파열음 – 비음 – 마찰음\",\"마찰음 – 비음 – 파찰음\",\"파찰음 – 유음 – 마찰음\",\"파찰음 – 비음 – 마찰음\",\"파찰음 – 비음 – 파열음\"],\"answer\":4,\"explain\":\"/ㅊ/은 경구개 파찰음, 종성 /ㅁ/은 양순 비음, /ㅅ/은 치조 마찰음이다. /ㅊ/을 파열음이나 마찰음으로, /ㅁ/을 유음으로, /ㅅ/을 파열음·파찰음으로 분류한 나머지 보기는 모두 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 변별자질에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/은 [-공명성] 자질을 갖는다\",\"치조음과 경구개음은 [+설정성] 자질을 공유한다\",\"연구개음 /ㄱ, ㄲ, ㅋ/은 [+전방성] 자질을 갖는다\",\"파찰음 /ㅈ, ㅉ, ㅊ/은 [+지속성] 자질을 갖는다\",\"마찰음 /ㅅ, ㅆ/은 [-지속성] 자질을 갖는다\"],\"answer\":2,\"explain\":\"[설정성(coronal)]은 혀끝·혓날이 올라가 조음되는 치조음·경구개음이 공유하는 자질이다. 비음은 공명음이므로 [+공명성], 파찰음은 폐쇄 구간이 있어 [-지속성], 마찰음은 기류가 지속되므로 [+지속성], 연구개음은 치조 뒤에서 조음되므로 [-전방성]이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 종성(받침) 자음에 관한 설명으로 옳은 것은?\",\"choices\":[\"발음상 종성에는 /ㄱ, ㄴ, ㄷ, ㄹ, ㅁ, ㅂ, ㅇ/ 7개 자음만 실현된다\",\"종성 /ㄹ/은 탄설음 [ɾ]으로 실현된다\",\"종성 파열음은 개방(파열)되어 산출된다\",\"종성 위치에서 파찰음 /ㅈ/은 그대로 실현된다\",\"발음상 종성에서는 두 개의 자음이 연이어 실현될 수 있다\"],\"answer\":1,\"explain\":\"한국어는 음절 말에서 7개 자음(7종성)만 실현된다(예: '꽃'→[꼳], '부엌'→[부억]). 종성 파열음은 불파음(미파음)으로 산출되고, 종성 /ㄹ/은 설측음 [l]로 실현되며, 겹받침은 자음군 단순화로 하나만 발음된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"우리말 /ㄹ/의 변이음 실현이 옳게 연결된 것은?\",\"choices\":[\"'라면'의 /ㄹ/ – 설측음 [l]\",\"'노래'의 /ㄹ/ – 설측음 [l]\",\"'달'의 /ㄹ/ – 설측음 [l]\",\"'빨래'의 첫 번째 /ㄹ/ – 탄설음 [ɾ]\",\"'달'의 /ㄹ/ – 탄설음 [ɾ]\"],\"answer\":3,\"explain\":\"/ㄹ/은 초성(어두, 모음 사이)에서 탄설음 [ɾ], 종성에서 설측음 [l]로 실현된다. '빨래'처럼 /ㄹ/이 연이어 나오면 [ll]로 둘 다 설측음이다. 따라서 '달'의 종성 /ㄹ/ – 설측음 연결만 옳다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"'고기'의 표준 발음에 대한 음성 전사로 옳은 것은?\",\"choices\":[\"[koki]\",\"[gogi]\",\"[kʰogi]\",\"[kogi]\",\"[k*ogi]\"],\"answer\":4,\"explain\":\"평음 /ㄱ/은 어두에서 무성 파열음 [k]로, 유성음(모음) 사이에서는 유성음화되어 [g]로 실현된다. 어두를 [g]로 전사하거나 어중을 [k]로 전사한 것, 격음 [kʰ]·경음 [k*]으로 전사한 것은 모두 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"한국어 자음의 일반적인 습득 순서에 관한 설명으로 옳은 것은?\",\"choices\":[\"치조 마찰음 /ㅅ, ㅆ/은 가장 이른 시기에 습득된다\",\"유음 /ㄹ/은 양순 파열음보다 먼저 습득된다\",\"모든 종성 자음은 초성 자음보다 늦게 습득된다\",\"치조 마찰음은 만 3세 이전에 완전 습득된다\",\"비음과 파열음은 파찰음·마찰음보다 먼저 습득된다\"],\"answer\":5,\"explain\":\"우리말 자음은 대체로 비음·파열음 → 파찰음 → 유음·마찰음 순으로 습득되며, /ㅅ, ㅆ/과 /ㄹ/이 가장 늦게 완성된다. 종성 비음(/ㅁ, ㅇ/)은 비교적 이른 시기에 습득되므로 모든 종성이 초성보다 늦다는 설명은 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"'토마토'를 듣고 손뼉을 치며 음절 수 세기\",\"'밤'에서 /ㅁ/을 빼고 말하기\",\"'바나나'에서 '바'를 빼고 말하기\",\"/ㄱ/, /ㅗ/, /ㅁ/을 합쳐 '곰' 말하기\",\"'사'와 '자'를 합쳐 '사자' 말하기\"],\"answer\":2,\"explain\":\"음운인식은 큰 단위(음절)에서 작은 단위(음소)로 발달하며, 같은 음소 수준에서도 합성보다 탈락·대치 과제가 더 어렵다. 따라서 음소 탈락('밤'에서 /ㅁ/ 빼기)이 가장 늦게 발달한다. 음절 수 세기·음절 합성·음절 탈락은 음절 수준, 음소 합성은 음소 수준이지만 탈락보다 쉽다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말소리 습득 연령 기준에 관한 설명으로 옳은 것은?\",\"choices\":[\"출현연령은 해당 연령 아동의 95% 이상이 정조음한 연령이다\",\"출현연령은 완전습득연령보다 늦다\",\"관습적 습득연령은 해당 연령 아동의 50%가 정조음한 연령이다\",\"숙달연령은 해당 연령 아동의 25%가 정조음한 연령이다\",\"완전습득연령은 해당 연령 아동의 100%가 정조음한 연령이다\"],\"answer\":5,\"explain\":\"우리말 자음 습득 연구(김영태)에서 출현연령은 50~74%, 관습적 습득연령은 75~94%, 숙달연령은 95~99%, 완전습득연령은 100%의 아동이 정조음한 연령으로 정의된다. 출현연령이 가장 이르고 완전습득연령이 가장 늦다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동의 말소리 오류를 '성인 형태를 단순화하는 자연스러운 과정(음운변동)'으로 보고, 발달과 함께 이 과정이 억제되면서 성인 음운체계에 도달한다고 설명한 이론은?\",\"choices\":[\"행동주의 학습이론\",\"생성음운론\",\"자연음운론\",\"최적성이론\",\"운율음운론\"],\"answer\":3,\"explain\":\"자연음운론(Stampe)은 아동이 타고난 자연적 음운변동(단순화 과정)을 성장하면서 억제·제한하여 성인 체계에 이른다고 본다. 생성음운론은 변별자질과 규칙 체계, 최적성이론은 제약의 서열, 행동주의는 강화 학습으로 말소리 발달을 설명한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 왜곡(distortion) 오류에 해당하는 것은?\",\"choices\":[\"'사' 산출 시 공기가 혀 옆으로 새어 나와 우리말 음소 목록에 없는 소리로 산출됨\",\"고래 → [고애]\",\"오리 → [모리]\",\"사탕 → [타탕]\",\"밥 → [바]\"],\"answer\":1,\"explain\":\"왜곡은 목표음이 우리말 음소 목록에 없는 비표준 소리로 산출되는 오류로, /ㅅ/의 설측음화가 대표적이다. [타탕]은 다른 음소로 바뀐 대치, [고애]·[바]는 생략, [모리]는 첨가 오류이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"가방 → [다방]\\n코 → [토]\\n공 → [동]\",\"q\":\"이 아동이 보이는 음운오류패턴은?\",\"choices\":[\"파열음화\",\"치조음 후방화\",\"연구개음 전방화\",\"양순음화\",\"탈기식음화\"],\"answer\":3,\"explain\":\"연구개음 /ㄱ, ㅋ/이 조음위치가 앞쪽인 치조음 /ㄷ, ㅌ/으로 바뀌었으므로 연구개음 전방화이다. 조음방법(파열음)과 발성유형(평음·격음)은 유지되어 파열음화나 탈기식음화가 아니며, 뒤쪽으로 이동한 후방화도 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 4세 아동의 오류 중 일반적인 음운발달 과정에서 잘 나타나지 않는 비발달적 오류패턴에 해당하여 우선 중재가 필요한 것은?\",\"choices\":[\"나비 → [아비]\",\"딸기 → [딸디]\",\"라면 → [야면]\",\"사자 → [다자]\",\"책 → [채]\"],\"answer\":1,\"explain\":\"어두 초성 생략(나비→[아비])은 정상 발달에서 거의 나타나지 않는 비발달적 패턴이다. 연구개음 전방화([딸디]), 유음의 활음화([야면]), 마찰음의 파열음화([다자]), 종성생략([채])은 어린 아동에게 흔히 관찰되는 발달적 패턴이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [가과]\\n두부 → [부부]\",\"q\":\"두 오류에 공통적으로 해당하는 오류패턴은?\",\"choices\":[\"순행동화\",\"전방화\",\"음절 반복\",\"후방화\",\"역행동화\"],\"answer\":5,\"explain\":\"두 예 모두 앞 자음이 뒤에 오는 자음(/ㄱ/, /ㅂ/)의 영향을 받아 같은 소리로 바뀌었으므로 뒤 소리가 앞 소리에 영향을 준 역행동화이다. 순행동화는 앞 소리가 뒤 소리를 바꾸는 경우이며, 전방화·후방화는 문맥과 무관하게 조음위치가 이동하는 대치 패턴이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"사과 → [자과]\\n새 → [재]\\n수박 → [주박]\",\"q\":\"이 아동이 보이는 오류패턴은?\",\"choices\":[\"마찰음의 파열음화\",\"파찰음의 마찰음화\",\"구개음화\",\"마찰음의 파찰음화\",\"경음화\"],\"answer\":4,\"explain\":\"치조 마찰음 /ㅅ/이 파찰음 /ㅈ/으로 바뀌었으므로 마찰음의 파찰음화이다. 파열음화는 /ㄷ/ 등 파열음으로 바뀌는 것이고, 파찰음의 마찰음화는 반대 방향(/ㅈ/→/ㅅ/)이며, 경음화는 발성유형 변화이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자극반응도(stimulability)에 관한 설명으로 옳은 것은?\",\"choices\":[\"독립음 수준에서만 평가한다\",\"자발화에서 목표 음소가 오조음되는 빈도이다\",\"자극반응도가 높은 음소는 자연 회복 가능성이 낮아 우선 치료 대상이 된다\",\"검사자가 모델이나 단서를 제공했을 때 오조음하던 말소리를 정조음할 수 있는 정도이다\",\"말명료도와 같은 개념이다\"],\"answer\":4,\"explain\":\"자극반응도는 청각·시각·촉각 단서나 모델을 주었을 때 오조음을 정조음으로 산출할 수 있는 능력으로, 독립음·음절·단어 수준에서 평가한다. 자극반응도가 높은 음소는 예후가 좋고 자연 회복 가능성이 높다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"토끼 신발 → [토띠 신발]\",\"q\":\"이 발화의 자음정확도(PCC)는?\",\"choices\":[\"5/6×100(%)\",\"4/6×100(%)\",\"4/7×100(%)\",\"5/7×100(%)\",\"5/8×100(%)\"],\"answer\":1,\"explain\":\"목표 자음은 '토끼'의 /ㅌ, ㄲ/, '신발'의 /ㅅ, ㄴ, ㅂ, ㄹ/로 총 6개이다. 이 중 /ㄲ/→[ㄸ] 1개만 오류이므로 5/6×100이다. 초성 'ㅇ'(음가 없음)이나 모음은 자음 수에 포함하지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"모자 → [모다]\\n김 → [김]\",\"q\":\"두 단어의 평균음운길이(PMLU)는?\",\"choices\":[\"8/2\",\"9/2\",\"11/2\",\"10/2\",\"12/2\"],\"answer\":4,\"explain\":\"PMLU는 아동 산출의 분절음마다 1점, 정조음한 자음마다 1점을 추가한다. [모다]는 분절음 4개 + 정조음 자음 /ㅁ/ 1개 = 5점(/ㅈ/→[ㄷ]는 추가점 없음), [김]은 분절음 3개 + 정조음 자음 2개 = 5점이다. 합계 10점을 단어 수 2로 나누어 10/2이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"말명료도(speech intelligibility)에 관한 설명으로 옳은 것은?\",\"choices\":[\"자음정확도가 같으면 말명료도도 항상 같다\",\"말용인도(acceptability)와 같은 개념이다\",\"청자가 화자의 말을 알아듣는 정도로, 평정척도나 단어 확인 과제로 측정한다\",\"왜곡 오류가 생략 오류보다 말명료도를 더 크게 떨어뜨린다\",\"청자의 친숙도는 말명료도에 영향을 미치지 않는다\"],\"answer\":3,\"explain\":\"말명료도는 청자가 화자의 메시지를 알아듣는 정도로 등간척도 평정이나 알아들은 단어 비율(단어 확인 과제)로 측정한다. 오류 유형·일관성·문맥·청자 친숙도 등 여러 요인이 영향을 미치므로 자음정확도와 항상 일치하지 않으며, 생략이 왜곡보다 명료도를 더 떨어뜨린다. 말용인도는 말이 자연스럽고 정상적으로 들리는 정도로 다른 개념이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"다음 중 말명료도를 가장 크게 저하시킬 것으로 예상되는 오류는?\",\"choices\":[\"/ㅅ/의 일관된 치간음화 왜곡\",\"종성 /ㄹ/의 왜곡\",\"여러 위치에서 나타나는 초성 생략\",\"/ㅈ/ 한 음소의 일관된 파열음화\",\"어말 종성 /ㅇ/의 약화\"],\"answer\":3,\"explain\":\"오류 유형 중 생략이 명료도에 가장 큰 영향을 주고 대치, 왜곡 순이며, 여러 음소·위치에 걸친 오류일수록 명료도가 더 낮아진다. 단일 음소의 왜곡이나 한 음소의 일관된 대치는 비교적 명료도 저하가 적다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"• 만 3세~6세 5개월 아동 대상\\n• 37개 단어 이름대기와 연결발화 검사로 구성\\n• 자음정확도와 음운오류패턴 분석 결과를 제공\",\"q\":\"해당하는 검사는?\",\"choices\":[\"아동용 발음평가(APAC)\",\"우리말 조음음운검사2(U-TAP2)\",\"한국어 표준 그림 조음음운검사(KS-PAPT)\",\"한국어 읽기 검사(KOLRA)\",\"취학전 아동의 수용언어 및 표현언어 발달척도(PRES)\"],\"answer\":1,\"explain\":\"APAC은 37개 단어 검사와 연결발화 검사로 자음정확도와 오류패턴을 분석하는 검사이다. U-TAP2는 단어·문장 수준 검사로 구성되며, KS-PAPT는 선별·정밀검사로 나뉜다. KOLRA는 읽기, PRES는 언어발달 검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"독립분석(independent analysis)에 관한 설명으로 옳은 것은?\",\"choices\":[\"성인 목표형과 비교하여 대치·생략 오류를 분류한다\",\"성인 목표형과 비교하지 않고 아동이 산출한 음소 목록과 음절구조를 기술한다\",\"자음정확도(PCC)를 산출하는 분석이다\",\"학령기 잔존오류 아동에게 가장 적합하다\",\"음운오류패턴의 출현율을 계산한다\"],\"answer\":2,\"explain\":\"독립분석은 아동의 산출 자체를 하나의 체계로 보고 자음·모음 목록과 음절구조 목록을 기술하며, 어리거나 명료도가 매우 낮은 아동에게 유용하다. 성인 목표형과 비교하는 오류 분류, 자음정확도, 오류패턴 출현율은 관계분석에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"자음정확도(PCC)가 48%인 아동의 말소리장애 심각도(Shriberg & Kwiatkowski 기준)는?\",\"choices\":[\"중도(severe)\",\"경도-중등도(mild-moderate)\",\"중등도-중도(moderate-severe)\",\"경도(mild)\",\"정상 범위\"],\"answer\":1,\"explain\":\"PCC 심각도 기준은 85% 초과 경도, 65~85% 경도-중등도, 50~65% 중등도-중도, 50% 미만 중도이다. 48%는 50% 미만이므로 중도에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동\\n• 같은 단어를 여러 번 산출할 때 40% 이상 다르게 산출함\\n• 구강운동 기능은 정상이고 모색행동이 없음\\n• 운율은 자연스러움\",\"q\":\"Dodd의 분류에 따른 이 아동의 말소리장애 유형은?\",\"choices\":[\"음운지연\",\"비일관적 음운장애\",\"일관적 음운장애\",\"아동기 말실행증\",\"조음장애\"],\"answer\":2,\"explain\":\"같은 단어를 반복 산출할 때 40% 이상 변이를 보이면서 구강운동·운율 문제가 없으면 비일관적 음운장애이다. 아동기 말실행증도 비일관성을 보이지만 모색행동, 동시조음 전이 어려움, 운율 이상을 동반한다. 음운지연은 발달적 패턴이 늦게까지 남는 것, 일관적 음운장애는 비발달적 패턴을 일관되게 보이는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"아동기 말실행증(CAS)의 핵심 특징으로 옳게 묶인 것은?\",\"choices\":[\"발달적 오류패턴, 양호한 말명료도, 정확한 모음\",\"과다비성, 근력 약화, 느린 말속도\",\"일관된 대치, 높은 자극반응도, 정상 운율\",\"한 음소의 왜곡, 청력 손실, 구조적 이상\",\"비일관적 오류, 음소·음절 간 동시조음 전이의 어려움, 부적절한 운율\"],\"answer\":5,\"explain\":\"CAS는 말운동 계획·프로그래밍의 문제로 자음·모음의 비일관적 오류, 음소·음절 간 전이의 연장과 단절, 부적절한 강세·운율이 핵심 특징이다. 근력 약화와 과다비성은 마비말장애, 일관된 발달적 대치는 음운지연의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"구개열 아동의 말 특성에 관한 설명으로 옳은 것은?\",\"choices\":[\"비음 /ㅁ, ㄴ, ㅇ/이 가장 큰 영향을 받는다\",\"파열음·마찰음·파찰음 등 고압력 자음이 약하게 산출되고 비누출이 동반될 수 있다\",\"보상조음은 조음위치가 구강 앞쪽으로 전방화된 것이다\",\"모음이 자음보다 더 큰 영향을 받는다\",\"과소비성이 주된 공명 문제이다\"],\"answer\":2,\"explain\":\"연인두 폐쇄부전이 있으면 구강 내 압력을 형성해야 하는 고압력 자음(파열·마찰·파찰음)이 약해지고 비누출과 과다비성이 나타난다. 비음은 원래 비강 공명을 이용하므로 영향이 적고, 보상조음(성문파열음·인두마찰음 등)은 조음위치가 뒤쪽(후방)으로 이동한 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"선천성 심도 감각신경성 난청 아동의 말 특성으로 옳은 것은?\",\"choices\":[\"저주파수 비음이 가장 먼저 손상된다\",\"자음보다 모음이 항상 정확하다\",\"운율과 음도는 정상적으로 유지된다\",\"말속도가 빠르고 말명료도가 양호하다\",\"고주파수 마찰음 /ㅅ, ㅆ/의 생략·왜곡, 모음의 중립화, 종성 생략이 나타난다\"],\"answer\":5,\"explain\":\"청각 피드백 결여로 고주파수 에너지가 큰 마찰음이 생략·왜곡되고, 모음이 중앙화(중립화)되며, 종성 생략과 음도·운율 이상, 과다비성이 나타나 명료도가 낮다. 저주파수 비음은 비교적 잘 산출된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"음운장애보다 조음장애(운동적 말소리장애)에 더 부합하는 특징은?\",\"choices\":[\"여러 음소에 걸친 체계적인 대치 패턴\",\"종성생략으로 인한 낮은 말명료도\",\"음운인식 결함을 동반함\",\"/ㅅ/을 일관되게 설측음화(왜곡)하며 다른 음소는 정확함\",\"여러 음소가 하나의 음소로 대치되는 음소 붕괴\"],\"answer\":4,\"explain\":\"조음장애는 말소리 산출의 운동적 문제로 소수 음소의 일관된 왜곡이 특징이며 명료도 저하가 적다. 여러 음소에 걸친 대치 패턴, 종성생략, 음소 붕괴, 음운인식 결함은 음운 체계(언어적) 문제인 음운장애의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"전통적 조음치료법(Van Riper)의 단계 순서로 옳은 것은?\",\"choices\":[\"단어 훈련 → 독립음 확립 → 감각-지각 훈련 → 유지 → 전이\",\"감각-지각 훈련 → 독립음 확립 → 음절·단어·문장으로 안정화 → 전이(일반화) → 유지\",\"독립음 확립 → 감각-지각 훈련 → 전이 → 문장 안정화 → 유지\",\"전이 → 감각-지각 훈련 → 독립음 확립 → 안정화 → 유지\",\"감각-지각 훈련 → 문장 훈련 → 독립음 확립 → 유지 → 전이\"],\"answer\":2,\"explain\":\"전통적 접근법은 목표음을 듣고 변별하는 감각-지각(청지각) 훈련으로 시작하여 독립음에서 목표음을 확립한 뒤, 음절·단어·구·문장·대화로 점차 확장(안정화)하고 치료실 밖으로 전이시킨 후 유지 단계를 거친다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"짝자극 기법(paired-stimuli approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"핵심단어는 목표음을 10회 중 3회 이하로 정조음하는 단어이다\",\"목표음을 정조음하는 핵심단어와 오조음하는 훈련단어를 짝지어 연습한다\",\"최소대립쌍을 이용하여 의미 대조를 가르친다\",\"독립음 수준에서 훈련을 시작한다\",\"청각적 자극(auditory bombardment)이 핵심 절차이다\"],\"answer\":2,\"explain\":\"짝자극 기법은 아동이 목표음을 안정적으로 정조음하는 핵심단어(10회 중 9회 이상 정조음)를 오조음하는 훈련단어와 번갈아 산출하게 하여 정조음을 전이시키는 단어 수준의 기법이다. 최소대립쌍은 음운론적 접근, 청각적 자극은 주기법의 절차이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"5세 아동이 /ㅅ, ㅈ, ㄱ, ㅋ/을 모두 /ㄷ/으로 대치함\\n(예: 사과 → [다과], 자 → [다], 공 → [동], 코 → [도])\",\"q\":\"이 아동에게 가장 적합한 대조 접근법은?\",\"choices\":[\"최소대립쌍 접근법\",\"최대대립 접근법\",\"짝자극 기법\",\"다중대립 접근법\",\"핵심어휘 접근법\"],\"answer\":4,\"explain\":\"여러 음소가 하나의 음소로 붕괴(phoneme collapse)된 경우, 대치음 /ㄷ/과 여러 목표음을 동시에 대조하는 다중대립 접근법이 적합하다. 최소대립쌍은 한 자질 차이의 두 음소, 최대대립은 자질 차이가 큰 두 음소를 대조하고, 핵심어휘 접근법은 비일관적 음운장애에 사용한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"주기법(cycles approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"잔존오류를 보이는 학령기 아동이 주 대상이다\",\"말소리 자질에 대한 상위언어적 인식 지도가 1단계이다\",\"한 패턴을 완전히 숙달한 뒤에 다음 패턴으로 넘어간다\",\"독립음 수준의 반복 훈련이 중심이다\",\"각 목표 패턴을 정해진 시간 동안 훈련한 뒤 숙달 여부와 관계없이 다음 패턴으로 순환하며, 청각적 자극을 포함한다\"],\"answer\":5,\"explain\":\"주기법(Hodson & Paden)은 말명료도가 매우 낮은 아동을 대상으로 오류패턴별 목표음을 일정 시간 훈련한 뒤 숙달 기준 없이 다음 패턴으로 순환하고, 회기마다 청각적 자극(auditory bombardment)을 제공한다. 숙달 후 진행은 수직적 접근, 상위언어적 인식 지도는 상위음운 접근법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"상위음운 접근법(Metaphon)의 1단계에서 실시하는 활동으로 적절한 것은?\",\"choices\":[\"최대대립쌍 단어를 반복 산출한다\",\"구강 근육 강화 운동을 한다\",\"'긴 소리/짧은 소리', '앞 소리/뒤 소리'와 같이 말소리의 대조되는 속성 개념을 인식하게 한다\",\"대화 수준에서 의사소통 수정 전략을 연습한다\",\"비단어 따라말하기로 음운기억을 훈련한다\"],\"answer\":3,\"explain\":\"상위음운 접근법 1단계는 개념 수준(긴/짧은, 앞/뒤 등 비언어적 속성)에서 시작해 소리·음소·단어 수준으로 말소리 자질의 대조를 인식시키는 단계이고, 2단계에서 의사소통 상황에서 이를 활용해 산출을 수정하게 한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"q\":\"핵심어휘 접근법(core vocabulary approach)에 관한 설명으로 옳은 것은?\",\"choices\":[\"의미 대조를 이용해 음운 체계를 재구조화한다\",\"잔존오류 아동을 대상으로 왜곡음을 교정한다\",\"하나의 음소를 독립음 수준에서 확립한다\",\"말실행증 아동의 운율 개선이 1차 목표이다\",\"비일관적 음운장애 아동을 대상으로, 기능적 단어를 선정해 아동의 '최선의 산출'을 일관되게 하도록 훈련한다\"],\"answer\":5,\"explain\":\"핵심어휘 접근법(Dodd)은 비일관적 음운장애 아동에게 자주 쓰는 기능적 단어를 선정하여 완전한 정조음이 아니더라도 아동이 할 수 있는 최선의 산출을 일관되게 하도록 훈련한다. 의미 대조를 이용한 재구조화는 최소대립쌍 등 음운론적 대조 접근법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료 결과, 어두 초성에서만 훈련한 /ㅅ/를 훈련하지 않은 어중 초성('가수', '버섯')에서도 정조음하게 되었다.\",\"q\":\"이에 해당하는 일반화 유형은?\",\"choices\":[\"위치 일반화\",\"언어단위 일반화\",\"상황 일반화\",\"음소 간 일반화\",\"문맥 일반화\"],\"answer\":1,\"explain\":\"단어 내 훈련하지 않은 위치(어두→어중·어말)로 정조음이 확대되는 것은 위치 일반화이다. 문맥 일반화는 인접 모음 등 음성 문맥, 언어단위 일반화는 음절→단어→문장, 상황 일반화는 치료실 밖 장소·대화상대, 음소 간 일반화는 훈련하지 않은 다른 음소로의 확대를 말한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"조음음운장애\",\"session\":2,\"stem\":\"치료사가 한 회기 안에서 /ㅅ/, /ㄹ/, 종성 /ㄱ/ 세 가지 목표를 각각 15분씩 나누어 동시에 훈련하고 있다.\",\"q\":\"이 치료사가 사용한 목표 접근 전략은?\",\"choices\":[\"수직적 접근법\",\"주기적 접근법\",\"수평적 접근법\",\"절충적 접근법\",\"위계적 접근법\"],\"answer\":3,\"explain\":\"여러 목표음을 한 회기에서 동시에 다루는 것은 수평적 접근법이다. 수직적 접근법은 한두 개 목표를 준거에 도달할 때까지 집중 훈련한 뒤 다음으로 넘어가고, 주기적 접근법은 일정 기간 단위로 목표를 순환한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 행동을 핵심행동과 부수행동(탈출행동·회피행동)으로 분류하려 한다.\",\"q\":\"행동과 분류가 옳게 연결된 것은?\",\"choices\":[\"막힘 – 탈출행동\",\"눈 깜박임 – 핵심행동\",\"소리 연장 – 회피행동\",\"더듬을 것 같은 낱말을 다른 낱말로 바꿔 말하기 – 회피행동\",\"고개를 갑자기 젖히며 막힘에서 벗어나기 – 핵심행동\"],\"answer\":4,\"explain\":\"핵심행동은 반복·연장·막힘 등 말더듬 자체이고, 부수행동은 이에 대한 반응으로 학습된 행동이다. 낱말 대치(바꿔 말하기)는 말더듬을 예상하고 미리 피하는 회피행동이다. 막힘과 연장은 핵심행동이며, 눈 깜박임·고개 젖히기처럼 이미 시작된 말더듬에서 빠져나오려는 행동은 탈출행동(부수행동)이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동의 비유창성을 진성 비유창성(SLD)과 기타 비유창성(OD)으로 나누어 분석하려 한다.\",\"q\":\"비유창성 유형과 분류가 옳게 연결된 것은?\",\"choices\":[\"\\\"나 나 나 갈래\\\"(1음절 낱말 반복) – 기타 비유창성\",\"\\\"나는 나는 갈래\\\"(구 반복) – 기타 비유창성\",\"\\\"음, 어\\\"(간투사) – 진성 비유창성\",\"\\\"나는, 아니 우리는 갈래\\\"(수정) – 진성 비유창성\",\"\\\"ㅅ---사탕\\\"(소리 연장) – 기타 비유창성\"],\"answer\":2,\"explain\":\"진성 비유창성(SLD)은 낱말부분(음소·음절) 반복, 1음절 낱말 반복, 연장·막힘 등 비운율적 발성으로, 말더듬 아동에게 특징적이다. 기타 비유창성(OD)은 간투사, 수정, 미완성, 구·다음절 낱말 전체 반복 등 일반 아동에게도 흔한 비유창성이다. 따라서 구 반복만 기타 비유창성으로 분류되며, 1음절 낱말 반복과 연장은 진성 비유창성, 간투사와 수정은 기타 비유창성이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 발생·발달을 설명하는 이론에 대한 설명으로 옳은 것은?\",\"choices\":[\"진단착오이론 – 양쪽 대뇌반구의 우세 경쟁으로 말운동 협응이 실패하여 말더듬이 생긴다\",\"요구-용량 모델 – 환경·내적 요구가 아동의 운동·언어·정서·인지 용량을 초과할 때 비유창성이 나타난다\",\"대뇌반구 우세이론 – 부모가 정상적 비유창성을 말더듬으로 낙인찍어 말더듬이 생긴다\",\"예기투쟁가설 – 말더듬은 유전자에 의해 전적으로 결정되며 환경의 영향은 없다\",\"내적수정가설 – 말더듬은 청자의 부정적 반응에 의해 강화된 조작적 행동일 뿐이다\"],\"answer\":2,\"explain\":\"요구-용량 모델(Starkweather)은 말속도·언어 복잡성·시간 압박 등 요구가 아동의 말운동·언어·정서·인지 용량을 넘어설 때 비유창성이 발생한다고 본다. 진단착오이론은 부모의 낙인, 대뇌반구 우세이론은 양반구 우세 경쟁, 예기투쟁가설은 말더듬을 예상하고 피하려는 투쟁 반응, 내적수정가설은 음운 계획 오류를 내적으로 감지·수정하는 과정에서 비유창성이 생긴다는 설명이므로 보기의 연결은 모두 잘못되었다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"Guitar의 말더듬 발달 단계 중 '경계선급 말더듬'에 대한 설명이다.\",\"q\":\"옳은 것은?\",\"choices\":[\"반복 단위 수가 많은 반복이 잦으나 긴장이나 부수행동은 거의 없고 아동이 스스로 인식하지 않는다\",\"낱말·상황 회피가 나타나기 시작한다\",\"말더듬에 대한 두려움과 부정적 자아개념이 확립되어 있다\",\"막힘과 탈출행동이 뚜렷하게 나타난다\",\"비유창성 대부분이 간투사·수정이며 빈도가 낮다\"],\"answer\":1,\"explain\":\"경계선급 말더듬은 정상적 비유창성보다 비유창성 빈도가 높고(대략 100낱말당 10회 이상) 반복 단위 수가 2회 이상으로 많으나, 긴장·막힘·탈출행동은 거의 없고 아동이 자신의 말을 의식하지 않는 단계이다. 막힘과 탈출행동은 초기 말더듬, 회피와 두려움은 중간급, 부정적 자아개념의 확립은 심화된 말더듬의 특징이며 간투사·수정 위주의 낮은 빈도는 정상적 비유창성에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 52세 남성, 뇌경색 후 말더듬이 시작됨\\n• 아동기 말더듬 병력 없음\\n• 조사·어미 등 기능어와 내용어를 가리지 않고 반복이 나타남\\n• 같은 문장을 반복해서 읽어도 말더듬이 줄지 않음\\n• 부수행동과 말에 대한 불안이 거의 없음\",\"q\":\"이 대상자에게 가장 적절한 유창성장애 유형은?\",\"choices\":[\"발달성 말더듬\",\"속화(말빠름증)\",\"심인성 말더듬\",\"신경학적 말더듬\",\"경계선급 말더듬\"],\"answer\":4,\"explain\":\"성인기 뇌손상 이후 시작되고, 기능어·내용어 구분 없이 낱말 위치와 무관하게 비유창성이 나타나며, 적응효과가 없고 부수행동과 불안이 적은 것은 신경학적 말더듬의 특징이다. 발달성 말더듬은 아동기에 시작되고 적응효과와 부수행동을 보이며, 심인성 말더듬은 심리적 외상·스트레스 사건 이후 시작되고 뇌손상이 없다. 속화는 빠르고 불규칙한 말속도와 명료도 저하가 핵심이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"속화(cluttering)에 대한 설명으로 옳은 것은?\",\"choices\":[\"자신의 말 문제를 잘 인식하고 말하기 불안이 높다\",\"막힘과 탈출행동이 핵심행동이다\",\"말에 주의를 기울일수록 명료도가 더 나빠진다\",\"언어·화용 문제는 동반되지 않는다\",\"말속도가 빠르거나 불규칙하고 음절 축약·생략으로 명료도가 저하된다\"],\"answer\":5,\"explain\":\"속화는 빠르거나 불규칙한 말속도, 음절·낱말의 축약과 생략, 과도한 정상적 비유창성으로 명료도가 떨어지는 유창성장애이며, 언어·화용·주의 문제를 자주 동반한다. 말더듬과 달리 자신의 문제에 대한 인식과 불안이 낮고, 주의를 기울이면 말이 오히려 좋아지는 경향이 있다. 막힘·탈출행동은 말더듬의 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말의 유창성을 구성하는 요소로 옳게 묶인 것은?\",\"choices\":[\"명료도 – 강도 – 음도 – 공명\",\"연속성 – 정확성 – 강도 – 음도\",\"정확성 – 명료도 – 억양 – 공명\",\"연속성 – 말속도 – 리듬 – 노력\",\"정확성 – 노력 – 공명 – 억양\"],\"answer\":4,\"explain\":\"유창한 말은 끊김 없이 이어지고(연속성), 적절한 속도와 리듬을 유지하며, 신체적·정신적 노력이 적게 드는 말이다. 명료도·강도·음도·공명·정확성은 조음·음성 영역의 개념으로 유창성 자체의 구성요소가 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령전 말더듬 아동 중 자연회복 가능성이 가장 높은 경우는?\",\"choices\":[\"음운·언어 능력이 또래보다 낮은 남아이다\",\"말더듬이 성인기까지 지속된 가족력이 있는 남아이다\",\"발병 후 18개월 이상 지속되며 부수행동이 늘고 있다\",\"여아이며 발병 후 수개월 사이 비유창성 빈도가 감소하는 추세이다\",\"5세 이후에 발병하였고 비유창성 빈도에 변화가 없다\"],\"answer\":4,\"explain\":\"자연회복과 관련된 긍정적 예후 요인은 여아, 발병 초기 수개월 이내에 비유창성이 감소하는 경향, 이른 발병, 회복된 가족력, 양호한 음운·언어 능력 등이다. 반대로 남아, 지속된 가족력, 발병 후 12개월 이상 지속, 늦은 발병, 음운 능력 저하, 부수행동 증가는 지속 위험 요인이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말을 더듬는 사람의 말더듬이 일반적으로 감소하는 조건은?\",\"choices\":[\"전화로 낯선 사람과 통화할 때\",\"노래를 부르거나 다른 사람과 함께 소리 내어 읽을 때\",\"시간 압박이 큰 상황에서 빠르게 대답할 때\",\"이름·주소 등 바꿔 말할 수 없는 정보를 말할 때\",\"권위 있는 사람 앞에서 발표할 때\"],\"answer\":2,\"explain\":\"노래, 합창읽기(함께 읽기), 혼잣말, 리듬에 맞춰 말하기, 속삭이기 등은 대표적인 유창성 유도 조건이다. 전화 통화, 권위 있는 청자, 시간 압박, 대치할 수 없는 고유 정보(이름·주소) 말하기는 말더듬이 증가하는 상황이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 같은 지문을 5회 반복해서 읽었다. 1회에서 더듬은 낱말의 대부분을 5회에서도 같은 위치에서 더듬었다.\",\"q\":\"이 현상을 설명하는 용어는?\",\"choices\":[\"적응효과\",\"일관성 효과\",\"인접효과\",\"청자규모효과\",\"교환효과\"],\"answer\":2,\"explain\":\"반복 읽기에서 말더듬이 발생하는 낱말의 위치가 일정하게 유지되는 현상은 일관성 효과이다. 적응효과는 반복 읽기에서 말더듬 빈도가 점차 감소하는 현상, 인접효과는 이전에 더듬었던 낱말을 제거하면 그 인접 낱말에서 말더듬이 나타나는 현상, 청자규모효과는 청자 수가 많아질수록 말더듬이 증가하는 현상이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬의 역학적 특성에 대한 설명으로 옳은 것은?\",\"choices\":[\"출현율은 일생 동안 한 번이라도 말더듬을 경험한 사람의 비율이다\",\"성인기로 갈수록 남녀 비율이 1:1에 가까워진다\",\"대부분 학령기 이후(7세 이후)에 발병한다\",\"발생률이 출현율보다 높은 것은 상당수가 자연회복되기 때문이다\",\"말더듬 발생은 가족력과 관련이 없다\"],\"answer\":4,\"explain\":\"발생률(일생 중 말더듬을 경험하는 비율, 약 5% 내외)이 출현율(특정 시점의 말더듬 인구 비율, 약 1%)보다 높은 이유는 학령전기에 발병한 아동의 상당수가 자연회복되기 때문이다. 출현율은 특정 시점의 비율이고, 남녀 비율은 연령이 높아질수록 남성 쪽으로 더 커지며(약 4:1), 발병은 대부분 2~5세 학령전기에 일어나고 가족력은 중요한 위험 요인이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"회피행동의 유형과 예가 옳게 연결된 것은?\",\"choices\":[\"상황회피 – 어려운 낱말을 쉬운 다른 낱말로 바꿔 말함\",\"대치(substitution) – 막힌 순간 눈을 깜박이며 빠져나옴\",\"에두르기(circumlocution) – 말해야 하는 상황 자체에 참여하지 않음\",\"시작기법(starter) – 더듬었던 낱말을 다시 한 번 말함\",\"연기(postponement) – 더듬을 것 같은 낱말 앞에서 '음…'을 넣어 시작을 미룸\"],\"answer\":5,\"explain\":\"연기는 어려운 낱말 앞에서 간투사·쉼 등으로 시간을 끌어 말더듬을 미루는 회피행동이다. 대치는 어려운 낱말을 다른 낱말로 바꾸는 것이고, 에두르기는 낱말을 피해 돌려 설명하는 것이며, 시작기법은 '그러니까' 같은 말을 앞에 붙여 발화를 시작하는 것, 상황회피는 말하는 상황 자체를 피하는 것이다. 눈 깜박임으로 빠져나오는 것은 회피가 아니라 탈출행동이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"학령기 말더듬 아동의 치료에 대한 설명으로 옳은 것은?\",\"choices\":[\"학교 환경(교사·또래) 요인은 치료 범위에 포함하지 않는다\",\"인식이 생기기 전이므로 부모 중심의 간접치료만 실시한다\",\"놀림·괴롭힘에 대처하는 방법과 말더듬에 대한 개방적 태도를 함께 다룬다\",\"부모의 참여는 학령전기에만 필요하므로 배제한다\",\"소리 내어 읽기 등 학급 활동에서 면제받도록 교사에게 요청한다\"],\"answer\":3,\"explain\":\"학령기 아동은 말더듬에 대한 인식과 부정적 감정, 또래의 놀림이 문제가 되는 시기이므로 유창성 기법과 함께 놀림·괴롭힘 대처, 말더듬에 대한 개방적 태도, 교사·부모와의 협력을 다룬다. 이 시기에는 직접치료가 중심이 되며, 학급 활동 면제는 회피를 강화하므로 적절하지 않다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"파라다이스-유창성 검사-II(P-FA-II)에 대한 설명으로 옳은 것은?\",\"choices\":[\"의사소통태도 평가는 모든 연령 집단에 실시한다\",\"필수과제는 읽기와 대화 두 가지로만 구성된다\",\"취학전 아동·초등학생·중학생 이상의 연령 집단별로 과제가 구성되어 있다\",\"결과는 말더듬 음절 백분율(%SS)로만 산출하고 백분위 점수는 제공하지 않는다\",\"핵심행동만 평가하고 부수행동은 평가하지 않는다\"],\"answer\":3,\"explain\":\"P-FA-II는 취학전 아동, 초등학생, 중학생 이상의 세 연령 집단에 맞춘 필수과제와 선택과제로 구성되며, 구어 평가(핵심행동)와 부수행동, 의사소통태도를 평가하고 백분위 점수로 중증도를 해석한다. 의사소통태도 평가는 초등학생 이상에게 실시하며, 필수과제는 연령별로 낱말그림·따라말하기·문장그림·읽기·이야기그림·말하기그림 등 여러 과제로 구성된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대화 발화 표본 분석\\n• 전체 음절 수: 250음절\\n• 말더듬이 나타난 음절 수: 15음절\",\"q\":\"이 대상자의 말더듬 음절 백분율(%SS)은?\",\"choices\":[\"4 %SS\",\"5 %SS\",\"15 %SS\",\"7.5 %SS\",\"6 %SS\"],\"answer\":5,\"explain\":\"%SS = (말더듬 음절 수 ÷ 전체 음절 수) × 100 = 15 ÷ 250 × 100 = 6 %SS이다. 말더듬 음절 백분율은 발화 표본의 전체 음절 수를 분모로 하며, 말더듬 순간의 횟수를 그대로 백분율로 쓰지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말더듬 정도 측정 검사(SSI-4)에서 '지속시간' 점수를 산출하는 방법은?\",\"choices\":[\"가장 긴 말더듬 순간 3개의 평균 지속시간을 구한다\",\"가장 짧은 말더듬 순간의 지속시간을 사용한다\",\"전체 발화 시간에서 말더듬 시간이 차지하는 비율을 구한다\",\"모든 말더듬 순간의 지속시간을 평균한다\",\"모든 말더듬 순간의 지속시간을 합산한다\"],\"answer\":1,\"explain\":\"SSI-4의 지속시간 점수는 발화 표본에서 가장 긴 말더듬 순간 3개의 평균 지속시간을 측정하여 척도 점수로 변환한다. SSI-4의 총점은 빈도(%SS), 지속시간, 신체적 부수행동 점수의 합으로 산출된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"말더듬 성인이 말더듬에 대해 느끼는 정서·행동적 반응, 일상 의사소통의 어려움, 삶의 질에 미치는 영향을 자기보고식으로 평가하려 한다.\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"말더듬 전반적 경험 평가(OASES)\",\"P-FA-II 필수과제\",\"말더듬 음절 백분율(%SS) 산출\",\"말더듬 정도 측정 검사(SSI-4)\",\"한국 아동 말더듬 검사(KOCS)\"],\"answer\":1,\"explain\":\"OASES는 말더듬에 대한 일반 정보, 정서·행동·인지적 반응, 일상 의사소통, 삶의 질의 네 영역을 자기보고로 평가하여 말더듬이 화자의 삶에 미치는 영향을 파악하는 도구이다. SSI-4와 %SS는 외현적 말더듬 행동의 중증도·빈도를 측정하고, KOCS는 아동용 검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"아동 발화: \\\"책책책상 위에 있어요.\\\"\",\"q\":\"'책책책상'에서 나타난 낱말부분 반복의 단위반복수는?\",\"choices\":[\"2\",\"1\",\"3\",\"4\",\"5\"],\"answer\":1,\"explain\":\"단위반복수는 목표 낱말이 산출되기 전에 반복된 단위의 횟수이다. '책책책상'은 목표 낱말 '책상'의 첫 음절 '책'이 두 번 더 반복된 것이므로 단위반복수는 2이다. 산출된 음절 '책'의 총 개수(3)와 혼동하지 않아야 한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"말속도 측정에 대한 설명으로 옳은 것은?\",\"choices\":[\"전체 말속도는 발화 중 쉼 시간을 제외하고 산출한다\",\"조음속도는 쉼과 비유창성에 소요된 시간을 제외한 순수 조음 시간으로 산출한다\",\"말속도는 분당 낱말 수로만 측정할 수 있다\",\"조음속도는 항상 전체 말속도보다 느리게 산출된다\",\"말더듬에 소요된 시간은 조음속도 산출에 포함한다\"],\"answer\":2,\"explain\":\"조음속도는 쉼·주저·말더듬 등 비유창성 시간을 제외한 순수 조음 시간을 기준으로 산출하므로 전체 말속도보다 같거나 빠르게 나온다. 전체 말속도는 쉼을 포함한 전체 발화 시간으로 산출하며, 말속도는 초당 음절 수, 분당 음절 수, 분당 낱말 수 등 여러 단위로 측정할 수 있다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Yairi와 Ambrose의 기준에 따라 학령전 아동을 말더듬으로 판단하는 진성 비유창성(SLD) 빈도는?\",\"choices\":[\"100음절당 3회 이상\",\"100음절당 2회 이상\",\"100음절당 1회 이상\",\"100음절당 5회 이상\",\"100음절당 10회 이상\"],\"answer\":1,\"explain\":\"Yairi와 Ambrose는 100음절당 진성 비유창성(낱말부분 반복, 1음절 낱말 반복, 비운율적 발성)이 3회 이상이면 말더듬으로 간주하는 기준을 제시하였다. 진성 비유창성이 3회 미만이고 간투사·수정 등 기타 비유창성 위주이면 정상적 비유창성으로 본다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"유창성완성법과 말더듬수정법을 비교한 설명으로 옳은 것은?\",\"choices\":[\"유창성완성법은 조절 유창성과 수용 말더듬을 최종 목표로 한다\",\"말더듬수정법은 느린 말속도·부드러운 발성 등 새 말하기 방식을 모든 발화에 적용한다\",\"말더듬수정법은 말더듬 순간을 덜 힘들게 더듬도록 수정하고 두려움·회피의 감소를 중시한다\",\"두 접근 모두 부수행동과 정서는 다루지 않는다\",\"유창성완성법은 말더듬에 대한 감정·태도 변화를 우선 목표로 한다\"],\"answer\":3,\"explain\":\"말더듬수정법(Van Riper)은 말더듬 순간을 확인·둔감·수정하여 더 쉽고 편하게 더듬게 하며, 말더듬에 대한 두려움과 회피를 줄이는 데 초점을 둔다(목표: 조절 유창성·수용 말더듬). 유창성완성법은 느린 말속도, 부드러운 발성 등 새로운 말하기 방식을 학습하여 유창한 말을 산출하는 것을 목표로 하며 감정·태도는 부차적으로 다룬다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"Van Riper 말더듬수정법의 치료 단계를 순서대로 옳게 나열한 것은?\",\"choices\":[\"둔감 → 확인 → 변형 → 수정 → 안정\",\"확인 → 변형 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 수정 → 변형 → 안정\",\"변형 → 확인 → 둔감 → 수정 → 안정\",\"확인 → 둔감 → 변형 → 수정 → 안정\"],\"answer\":5,\"explain\":\"말더듬수정법은 자신의 말더듬 행동을 인식하는 확인(동일시) 단계, 말더듬과 청자 반응에 대한 두려움을 줄이는 둔감 단계, 말더듬 형태를 의도적으로 바꾸어 통제 가능성을 경험하는 변형 단계, 취소·빠져나오기·준비하기로 더 쉽게 더듬는 수정(접근) 단계, 이를 일상에 유지·일반화하는 안정 단계 순으로 진행된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"대상자가 낱말 도중 막힘이 나타나자 멈추거나 되돌아가지 않고, 막힌 상태에서 조음기관의 긴장을 서서히 풀면서 소리를 부드럽게 늘여 그 낱말을 끝까지 산출하였다.\",\"q\":\"이 장면에서 사용된 말더듬수정법의 기법은?\",\"choices\":[\"준비하기(preparatory set)\",\"취소(cancellation)\",\"빠져나오기(pull-out)\",\"가벼운 조음접촉\",\"지연청각피드백\"],\"answer\":3,\"explain\":\"빠져나오기는 말더듬이 진행되는 도중에 멈추지 않고 긴장을 풀며 부드럽게 낱말을 완성하는 기법이다. 취소는 더듬은 낱말을 끝낸 뒤 잠시 멈추고 다시 편안하게 말하는 것이고, 준비하기는 더듬을 것이 예상되는 낱말 앞에서 미리 부드럽게 접근하는 것이다. 가벼운 조음접촉과 지연청각피드백은 말더듬수정법의 단계별 기법이 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"q\":\"리드콤 프로그램(Lidcombe Program)에 대한 설명으로 옳은 것은?\",\"choices\":[\"치료사가 아동에게 느린 말속도와 부드러운 발성을 직접 훈련한다\",\"아동의 말더듬에 대해서는 어떤 언급도 하지 않는 것이 원칙이다\",\"부모의 말속도와 가정 환경을 조정하는 간접치료이다\",\"학령기 이상 아동과 성인에게 적합한 프로그램이다\",\"부모가 일상에서 아동의 유창한 말에 칭찬 등 구어 수반 자극을 제공하는 학령전 아동 대상 직접치료이다\"],\"answer\":5,\"explain\":\"리드콤 프로그램은 학령전 말더듬 아동을 대상으로, 훈련받은 부모가 가정의 일상 대화에서 아동의 유창한 말에 칭찬을, 더듬은 말에는 가끔 부드러운 지적을 제공하는 행동주의(조작적 조건화)에 기초한 직접치료이며 부모가 매일 말더듬 중증도를 평정한다. 새로운 말하기 방식을 가르치거나 환경만 조정하는 접근이 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"유창성장애\",\"session\":1,\"stem\":\"• 3세 2개월 아동, 3개월 전부터 말더듬 시작\\n• 긴장이 없는 낱말부분 반복이 주로 관찰됨\\n• 아동은 자신의 말을 의식하지 않음\\n• 부모가 빠른 말속도로 질문을 많이 함\",\"q\":\"이 아동에게 우선적으로 적용할 접근으로 가장 적절한 것은?\",\"choices\":[\"말더듬에 대한 둔감화 훈련을 실시한다\",\"아동에게 취소·빠져나오기 기법을 훈련한다\",\"부모 교육을 통해 부모의 말속도를 늦추고 질문을 줄이며 반응 시간을 늘리는 등 환경을 조정한다\",\"지연청각피드백 기기를 사용하게 한다\",\"아동에게 말더듬을 의도적으로 흉내 내게 하여 인식을 높인다\"],\"answer\":3,\"explain\":\"발병 초기이고 긴장·인식이 없는 학령전 아동에게는 요구-용량 모델에 근거하여 부모의 말속도, 질문 빈도, 대화 차례 주고받기 등 환경적 요구를 줄이는 간접치료(부모 교육)를 우선 적용한다. 취소·빠져나오기·둔감화는 말더듬을 인식하고 있는 학령기 이상 대상자의 말더듬수정법 기법이며, 아동에게 말더듬을 의식시키는 활동은 이 단계에서 적절하지 않다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동은 성인과의 상호작용 속에서 혼자서는 할 수 없지만 도움을 받으면 할 수 있는 수준의 과제를 수행하며 언어를 습득한다. 성인은 아동의 수준에 맞추어 지원(비계)을 제공하고 점차 줄여 나간다.\",\"q\":\"이 설명에 해당하는 언어습득 이론은?\",\"choices\":[\"행동주의 이론\",\"생득주의 이론\",\"인지적 구성주의 이론\",\"연결주의 이론\",\"사회적 상호작용주의 이론\"],\"answer\":5,\"explain\":\"근접발달영역과 비계(scaffolding)는 비고츠키의 사회적 상호작용주의의 핵심 개념으로, 성인과의 상호작용이 언어 습득의 주된 동력이라고 본다. 행동주의는 모방·강화, 생득주의는 타고난 언어습득장치(LAD), 인지적 구성주의(피아제)는 인지 발달이 언어에 선행한다고 보며, 연결주의는 입력의 통계적 규칙성 학습으로 설명한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"반복적(음절성) 옹알이 단계에 관한 설명으로 옳은 것은?\",\"choices\":[\"문장과 유사한 억양 패턴을 지닌 자곤(jargon)이 주로 나타난다\",\"목 뒤쪽에서 나는 '구구' 소리가 특징이며 생후 2~3개월경 나타난다\",\"'바바바', '마마마'처럼 동일한 자음-모음 음절을 반복하며 대략 6~9개월경 나타난다\",\"의미 있는 첫 낱말이 산출되기 시작한다\",\"서로 다른 자음과 모음이 섞인 '바다구'와 같은 음절 연쇄가 주를 이룬다\"],\"answer\":3,\"explain\":\"반복적(canonical) 옹알이는 동일 CV 음절을 반복하는 것으로 대략 6~9개월경 출현한다. ②는 쿠잉(2~3개월), ③은 자곤(10개월 이후), ④는 첫 낱말기(12개월 전후), ⑤는 다양한 음절이 섞이는 변형적(variegated) 옹알이에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"12개월 아동\\n• 원하는 장난감을 향해 손을 뻗으며 '어어' 소리를 내고 엄마 얼굴을 번갈아 쳐다본다.\\n• 아직 관습적인 낱말은 산출하지 않는다.\",\"q\":\"베이츠(Bates)의 의사소통 의도 발달 단계 중 이 아동이 속한 단계는?\",\"choices\":[\"언향적(perlocutionary) 단계\",\"언표적(locutionary) 단계\",\"언표내적(illocutionary) 단계\",\"자곤 단계\",\"낱말조합 단계\"],\"answer\":3,\"explain\":\"몸짓·발성·시선 교대로 의도를 관습적으로 표현하지만 아직 낱말을 사용하지 않는 시기는 언표내적 단계(약 8~12개월)이다. 언향적 단계는 아동에게 의도가 없고 성인이 해석해 주는 시기이며, 언표적 단계는 낱말로 의도를 표현하는 시기이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"엄마와 아동이 창가에 있다.\\n아동: (창밖의 새를 가리키며 엄마 얼굴을 쳐다본다) 어! 어!\\n엄마: 응, 새가 있네.\",\"q\":\"아동이 보인 의사소통 기능은?\",\"choices\":[\"사물 요구하기\",\"행동 요구하기\",\"거부하기\",\"인사하기\",\"서술하기(관심 공유하기)\"],\"answer\":5,\"explain\":\"아동이 대상을 가리키며 성인의 시선을 끌어 관심을 공유하려는 행동은 원시서술(protodeclarative)로, 서술·주의끌기 기능에 해당한다. 사물을 얻거나 행동을 시키기 위한 가리키기는 원시명령(protoimperative)에 해당하는 요구하기 기능이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"두 낱말 발화의 의미관계 분석으로 옳은 것은?\",\"choices\":[\"\\\"엄마 가방\\\": 행위자-대상\",\"\\\"공 커\\\": 대상-행위\",\"\\\"또 줘\\\": 재현-행위\",\"\\\"안 먹어\\\": 부정-대상\",\"\\\"여기 앉아\\\": 대상-행위\"],\"answer\":3,\"explain\":\"'또 줘'는 되풀이를 요구하는 재현(recurrence)-행위 관계이다. '엄마 가방'은 소유자-대상, '공 커'는 실체-서술(상태), '안 먹어'는 부정-행위, '여기 앉아'는 장소-행위로 분석한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동 발화 4개\\n① 엄마 물 줘\\n② 이거 내 꺼\\n③ 아빠가 왔어\\n④ 안 먹어\",\"q\":\"위 발화의 평균형태소길이(MLU-m)는? (용언의 어간과 어미는 각각 형태소로 계산한다)\",\"choices\":[\"3.75\",\"3.50\",\"3.25\",\"4.00\",\"4.25\"],\"answer\":1,\"explain\":\"①엄마/물/주-/-어(4) ②이거/내/꺼(3) ③아빠/-가/오-/-았-/-어(5) ④안/먹-/-어(3)로 총 15개 형태소이며, 15÷4=3.75이다. 조사(-가)와 선어말어미(-았-), 종결어미(-어)를 각각 세지 않으면 값이 낮게 산출된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"자발화 표본 수집과 분석에 관한 설명으로 옳은 것은?\",\"choices\":[\"검사자가 '네/아니오'로 답할 수 있는 질문을 주로 사용하여 발화를 유도한다\",\"아동이 직전 발화를 그대로 반복한 발화도 모두 분석 대상에 포함한다\",\"발화 10개 정도면 신뢰로운 분석이 가능하다\",\"알아들을 수 없는 발화도 형태소 수 계산에 포함한다\",\"놀이·대화 등 두 가지 이상의 상황에서 표본을 수집한다\"],\"answer\":5,\"explain\":\"자발화는 아동의 대표적 언어 수행을 반영해야 하므로 여러 상황·대화 상대에서 충분한 양(일반적으로 50~100발화 이상)을 수집한다. 예/아니오 질문은 발화 길이를 제한하고, 즉각 반복·모방 발화와 불명료 발화는 MLU 등 분석에서 제외하는 것이 원칙이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동: 잼 줘.\\n치료사: 응? 뭐라고?\\n아동: 딸기 잼 줘요, 빵에 발라 먹게.\",\"q\":\"치료사의 명료화 요구에 대해 아동이 사용한 대화 수정 전략은?\",\"choices\":[\"반복(repetition)\",\"첨가(addition)\",\"단서 제공(cue)\",\"수정(revision)\",\"무반응\"],\"answer\":2,\"explain\":\"원래 발화의 내용을 유지하면서 새로운 정보(딸기, 빵에 발라 먹게)를 덧붙였으므로 첨가 전략이다. 반복은 같은 발화를 그대로 되풀이하는 것, 수정은 낱말이나 문장 형태를 바꾸어 말하는 것이며, 단서 제공은 배경 정보를 설명해 청자의 이해를 돕는 전략이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"어느 날 지우는 공원에서 연을 날렸어요.\\n그런데 연줄이 끊어져 연이 나무에 걸렸어요.\\n지우는 너무 속상해서 울고 싶었어요.\\n지우는 긴 막대기로 연을 내리려고 했어요.\\n결국 연을 다시 찾았어요.\\n지우는 기분이 좋아졌어요.\",\"q\":\"세 번째 문장 '지우는 너무 속상해서 울고 싶었어요.'에 해당하는 이야기 문법(story grammar) 요소는?\",\"choices\":[\"내적 반응\",\"계기 사건\",\"배경\",\"시도\",\"결과\"],\"answer\":1,\"explain\":\"계기 사건(연이 나무에 걸림)에 대한 주인공의 감정·생각은 내적 반응이다. 첫 문장은 배경, 둘째는 계기 사건, 넷째는 시도, 다섯째는 결과, 마지막은 반응(결말)에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이야기에 나타난 결속표지(cohesive device)의 유형이 옳게 연결된 것은?\",\"choices\":[\"\\\"비가 왔어. 그래서 우산을 썼어.\\\" – 생략\",\"\\\"형이 공을 찼어. 그것은 멀리 날아갔어.\\\" – 지시(대용)\",\"\\\"강아지가 짖었어. 그 개는 무서웠어.\\\" – 접속\",\"\\\"나는 빵을, 동생은 우유를 먹었어.\\\" – 지시(대용)\",\"\\\"먼저 손을 씻고, 그다음에 밥을 먹어.\\\" – 어휘적 결속\"],\"answer\":2,\"explain\":\"'그것'이 앞 문장의 '공'을 가리키므로 지시(대용) 결속이다. ②의 '그래서'와 ⑤의 '먼저·그다음에'는 접속, ③의 '강아지→개'는 유의어를 활용한 어휘적 결속, ④는 서술어 '먹었어'가 앞 절에서 생략된 생략 결속이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 과제 중 상위언어(metalinguistic) 능력을 평가하는 것은?\",\"choices\":[\"들려준 문장을 그대로 따라 말하기\",\"그림을 보고 사물의 이름 말하기\",\"\\\"책을 책상 위에 올려놓으세요.\\\" 지시 따르기\",\"\\\"'나무'에서 '나'를 빼면 무엇이 남지?\\\"\",\"사물의 색깔 말하기\"],\"answer\":4,\"explain\":\"상위언어 능력은 언어 자체를 사고의 대상으로 삼아 조작·판단하는 능력으로, 음절 탈락과 같은 음운인식 과제가 대표적이다. 이름대기·지시 따르기·문장 따라말하기·속성 말하기는 언어를 사용하는 과제이지 언어 자체를 분석하는 과제가 아니다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"초기 어휘 습득에 관한 개념과 예가 옳게 연결된 것은?\",\"choices\":[\"과잉확장 – '공'을 자기 공에만 사용한다\",\"과소확장 – '아빠'를 모든 성인 남자에게 사용한다\",\"전체대상 가정 – 새 낱말을 사물의 부분이나 색깔로 해석한다\",\"상호배타성 가정 – 새 낱말을 이미 이름을 아는 사물이 아닌 낯선 사물에 대응시킨다\",\"빠른 연결(fast mapping) – 수십 번의 노출 후에야 낱말을 습득한다\"],\"answer\":4,\"explain\":\"상호배타성 가정은 한 사물에 하나의 이름만 있다고 여겨 새 낱말을 낯선 사물에 연결하는 것이다. ①은 과소확장, ②는 과잉확장의 예이며, 전체대상 가정은 새 낱말을 사물 전체를 지칭하는 것으로 해석하는 것이고, 빠른 연결은 한두 번의 노출로 낱말과 의미를 잠정 연결하는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"읽기의 단순관점(Simple View of Reading)에 따를 때 난독증(dyslexia) 아동의 전형적인 프로파일은?\",\"choices\":[\"해독 정상, 듣기이해 저하\",\"해독 저하, 듣기이해 저하\",\"해독 정상, 듣기이해 정상, 읽기이해만 저하\",\"해독 저하, 듣기이해 정상\",\"해독과 듣기이해 모두 우수\"],\"answer\":4,\"explain\":\"단순관점에서 읽기이해는 해독과 언어(듣기)이해의 곱으로 설명된다. 난독증은 언어이해가 정상이면서 낱말 해독이 선택적으로 손상된 유형이다. ①은 특정 읽기이해 결함, ②는 혼합형(일반 읽기부진)에 해당하며, ③은 이 모델에서 설명되지 않는 조합이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 음운인식 과제 중 일반적으로 가장 늦게 발달하는 것은?\",\"choices\":[\"낱말의 음절 수 세기\",\"'사'와 '자'를 합쳐 '사자' 만들기\",\"'나비'와 '나무'의 첫음절이 같은지 판단하기\",\"두 낱말의 끝음절이 같은지 판단하기\",\"'산'에서 /ㅅ/를 빼고 말하기\"],\"answer\":5,\"explain\":\"음운인식은 음절 수준에서 음소 수준으로 발달하며, 같은 수준 안에서는 변별·합성보다 탈락·대치 같은 조작 과제가 더 어렵다. 음소 탈락 과제는 음소 수준의 조작 과제이므로 음절 세기·음절 합성·음절 변별보다 늦게 발달한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"초등학교 2학년 아동의 받아쓰기 오류\\n• 꽃이 → 꼬치\\n• 먹어서 → 머거서\\n• 높이 → 노피\",\"q\":\"이 아동의 철자 오류 유형과 우선적으로 필요한 교수 초점은?\",\"choices\":[\"음운처리 오류 – 자소-음소 대응 지도\",\"형태처리 오류 – 형태소 원형 유지와 경계 인식 지도\",\"표기처리 오류 – 관습적 표기 낱말 암기 지도\",\"의미처리 오류 – 낱말 의미 지도\",\"시각기억 오류 – 낱말 형태 시각화 지도\"],\"answer\":2,\"explain\":\"발음은 정확히 반영했으나 어간·어미와 조사의 경계를 나누지 못하고 소리 나는 대로 썼으므로 형태소 원형을 유지하지 못한 형태처리 오류이다. 음운처리 오류는 소리 자체가 틀리는 것(꽃→꼭), 표기처리 오류는 소리로 설명되지 않는 관습 표기의 오류(며칠→몇일)이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"표준화 언어검사와 그 특성이 옳게 연결된 것은?\",\"choices\":[\"수용·표현 어휘력 검사(REVT) – 수용과 표현 어휘를 각각 평가하여 등가연령과 백분위수를 산출한다\",\"취학전 아동의 수용언어 및 표현언어 발달척도(PRES) – 초등학생의 담화와 읽기 능력을 평가한다\",\"학령기 아동 언어 검사(LSSC) – 영유아의 의사소통 발달을 선별한다\",\"한국어 읽기 검사(KOLRA) – 학령전기 아동의 어휘 능력을 평가한다\",\"맥아더-베이츠 의사소통발달 검사(K M-B CDI) – 검사자가 아동에게 직접 그림 이름대기를 실시한다\"],\"answer\":1,\"explain\":\"REVT는 그림 지적(수용)과 그림 이름대기(표현)로 어휘력을 각각 평가하여 등가연령과 백분위수를 제공한다. K M-B CDI는 부모 보고형 검사이고, PRES는 학령전기 아동 대상, LSSC와 KOLRA는 초등학생 대상 검사이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"언어검사 결과 아동의 표현 어휘 백분위수가 5로 나타났다.\",\"q\":\"이 결과의 해석으로 옳은 것은?\",\"choices\":[\"검사 문항의 5%를 맞혔다\",\"규준집단에서 이 아동보다 낮은 점수를 받은 아동이 약 5%이다\",\"또래 평균보다 5점 낮다\",\"평균에서 -1 표준편차에 해당하는 위치이다\",\"등가연령이 5세이다\"],\"answer\":2,\"explain\":\"백분위수는 규준집단에서 해당 점수 이하를 받은 사람의 비율이므로 백분위수 5는 하위 5%에 해당한다. 정답률이나 점수 차이를 의미하지 않으며, -1 표준편차는 약 백분위수 16에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"역동적 평가(dynamic assessment)에 관한 설명으로 옳은 것은?\",\"choices\":[\"규준집단과 비교하여 표준점수를 산출하는 것이 목적이다\",\"결과는 등가연령으로 보고한다\",\"부모의 보고만으로 아동의 언어 능력을 추정한다\",\"한 시점의 수행만을 측정하므로 이중언어 아동에게는 부적합하다\",\"검사-교수-재검사 형식으로 아동의 학습 가능성과 수정 가능성을 평가한다\"],\"answer\":5,\"explain\":\"역동적 평가는 중재 반응을 통해 학습 잠재력을 파악하는 방법으로, 언어 차이와 언어장애를 감별해야 하는 이중언어·다문화 아동 평가에 특히 유용하다. 규준 비교나 표준점수·등가연령 산출은 정적(표준화) 평가의 특성이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애(SLI) 진단 준거로 옳은 것은?\",\"choices\":[\"표준화 언어검사에서 -1.25 SD 이하이면서 비언어성 지능지수는 85 이상이다\",\"감각신경성 난청을 동반한다\",\"자폐스펙트럼장애 진단을 동반한다\",\"비언어성 지능지수가 70 이하이다\",\"언어 지연을 설명하는 신경학적 손상이 확인된다\"],\"answer\":1,\"explain\":\"레너드(Leonard)의 준거에 따르면 단순언어장애는 언어검사 -1.25 SD 이하이면서 비언어성 지능 85 이상이고, 청력·구강구조·신경학적 손상·자폐 등 언어 지연을 설명할 다른 원인이 배제되어야 한다. 나머지는 모두 배제 준거에 해당한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"단순언어장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"비언어성 인지 저하가 언어 지연의 원인이다\",\"수용언어는 항상 정상이며 표현언어만 손상된다\",\"화용 능력은 영향을 받지 않는다\",\"첫 낱말 출현 시기가 또래보다 빠르다\",\"조사·어미 등 문법형태소의 습득과 사용이 특히 지연된다\"],\"answer\":5,\"explain\":\"단순언어장애 아동은 문법형태소 습득이 두드러지게 지연되고 낱말 찾기 어려움, 늦은 첫 낱말 등을 보인다. 수용언어도 손상될 수 있고, 언어 문제로 인한 대화·이야기 등 화용의 어려움이 동반될 수 있으며, 비언어성 인지는 정상 범위인 것이 진단의 전제이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"말 늦은 아동(late talker)의 판별 기준으로 옳은 것은?\",\"choices\":[\"18개월에 표현 낱말이 10개 미만이다\",\"24개월에 표현 어휘가 50개 미만이거나 낱말 조합이 나타나지 않는다\",\"36개월에 완전한 문장을 산출하지 못한다\",\"수용언어가 -2 SD 이하이다\",\"청력 손실을 동반한다\"],\"answer\":2,\"explain\":\"말 늦은 아동은 인지·청력·신경학적 문제 없이 24개월에 표현 어휘 50개 미만 또는 두 낱말 조합이 없는 아동을 말한다. 수용언어는 대체로 정상 범위이며, 청력 손실이 있으면 말 늦은 아동으로 분류하지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"5세 자폐스펙트럼장애 아동\\n• 과자가 먹고 싶을 때마다 며칠 전에 본 광고 문구인 \\\"맛있게 드세요~\\\"를 억양까지 그대로 말한다.\",\"q\":\"이 발화의 유형과 기능이 옳게 연결된 것은?\",\"choices\":[\"지연 반향어 – 요청\",\"즉각 반향어 – 대답\",\"지연 반향어 – 거부\",\"자곤 – 서술\",\"즉각 반향어 – 요청\"],\"answer\":1,\"explain\":\"이전에 들은 말을 시간이 지난 뒤 그대로 반복하는 것은 지연 반향어이며, 과자를 얻으려는 상황에서 사용하므로 요청 기능을 수행한다. 즉각 반향어는 상대의 말을 직후에 따라 하는 것이고, 자곤은 의미 없는 옹알이성 발화이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"다음 중 '공동주의 시작하기(initiating joint attention)'에 해당하는 행동은?\",\"choices\":[\"성인이 가리키는 곳을 따라 쳐다본다\",\"이름을 부르면 고개를 돌린다\",\"장난감을 들어 성인에게 보여주며 눈을 맞춘다\",\"과자를 얻으려고 성인의 손을 끌어당긴다\",\"성인의 박수 동작을 따라 한다\"],\"answer\":3,\"explain\":\"공동주의 시작하기는 아동이 먼저 보여주기·가리키기·시선 교대로 성인의 관심을 대상에 끌어들이는 행동이다. ①은 공동주의에 반응하기, ②는 이름 반응, ④는 요구를 위한 도구적 행동, ⑤는 모방으로 공동주의 시작과 구분된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"증후군과 언어 특성이 옳게 연결된 것은?\",\"choices\":[\"윌리엄스증후군 – 어휘와 표현언어가 인지 수준에 비해 현저히 낮다\",\"윌리엄스증후군 – 언어보다 시공간 인지가 상대적 강점이다\",\"취약X증후군 – 사회성이 과도하게 높아 낯선 사람에게도 친근하게 다가간다\",\"다운증후군 – 수용언어가 표현언어보다 더 심하게 손상된다\",\"다운증후군 – 표현언어와 구문 발달이 인지 수준에 비해 더 지연되고 말명료도가 낮다\"],\"answer\":5,\"explain\":\"다운증후군은 수용에 비해 표현·구문이 특히 약하고 저긴장·구강구조 특성으로 말명료도가 낮다. 윌리엄스증후군은 시공간 인지가 약한 반면 어휘·표현언어와 사회성이 상대적 강점이며, 취약X증후군은 사회적 불안·시선 회피와 보속적·빠른 말이 특징이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"청각장애 아동의 언어 특성으로 옳은 것은?\",\"choices\":[\"조사·어미 같은 기능어보다 내용어 습득이 더 어렵다\",\"문장 구조가 단순하고 문법형태소의 생략과 오류가 흔하다\",\"비유·관용 표현의 이해에 어려움이 없다\",\"낱말의 다의성 이해가 또래보다 우수하다\",\"말명료도는 청력 손실 정도와 관계가 없다\"],\"answer\":2,\"explain\":\"청각장애 아동은 청각 입력이 제한되어 강세가 약하고 짧은 문법형태소를 놓치기 쉬워 조사·어미 생략과 단순한 문장 구조를 보인다. 내용어보다 기능어 습득이 더 어렵고, 추상어·다의어·비유 이해도 제한되며, 말명료도는 청력 손실 정도와 관련된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"이중언어 아동의 언어장애 판별에 관한 설명으로 옳은 것은?\",\"choices\":[\"한국어 표준화 검사의 규준만으로 언어장애를 판정한다\",\"제2언어인 한국어에서만 지연이 있어도 언어장애로 진단한다\",\"두 언어 모두에서 지연이 나타날 때 언어장애를 의심한다\",\"새 언어에 노출된 초기의 침묵기는 언어장애의 징후이다\",\"모국어 사용을 중단시켜야 한국어 발달이 촉진된다\"],\"answer\":3,\"explain\":\"언어장애는 특정 언어가 아니라 언어 학습 능력 자체의 문제이므로 두 언어 모두에서 지연이 나타나야 의심할 수 있다. 한 언어에서만의 지연은 언어 차이(노출 부족)일 수 있고, 침묵기는 순차적 이중언어 습득의 정상적 과정이며, 모국어 유지는 제2언어 발달에도 도움이 된다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"아동이 블록을 쌓고 있다.\\n치료사: (아동의 행동을 보며) 블록을 높이 쌓네. 또 올리네. 와, 무너졌다.\",\"q\":\"치료사가 사용한 언어촉진 기법은?\",\"choices\":[\"혼잣말 기법(self-talk)\",\"확장(expansion)\",\"확대(extension)\",\"평행발화(parallel talk)\",\"개작(recast)\"],\"answer\":4,\"explain\":\"치료사가 아동이 하고 있는 행동을 아동의 입장에서 말로 묘사하는 것은 평행발화이다. 혼잣말 기법은 치료사 자신의 행동을 말로 표현하는 것이며, 확장·확대·개작은 아동의 발화가 있은 뒤 이를 문법적으로 보완하거나 의미를 덧붙이거나 문장 형태를 바꾸어 되돌려 주는 기법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"간식 시간마다 치료사가 아동에게 주스를 따라 주는 것이 반복되어 왔다.\\n오늘 치료사는 주스병을 들고 아동을 바라보며 기대하는 표정으로 약 5초간 기다렸다.\\n아동: 주스!\\n치료사: 그래, 주스 줄게.\",\"q\":\"치료사가 사용한 환경중심 언어중재 절차는?\",\"choices\":[\"시간지연(time delay)\",\"요구-모델(mand-model)\",\"아동중심 시범(child-cued modeling)\",\"우발교수(incidental teaching)\",\"스크립트 중재\"],\"answer\":1,\"explain\":\"익숙한 일과에서 성인이 도움을 주지 않고 기대하는 표정으로 기다려 아동의 자발적 의사소통을 유도하는 것은 시간지연 절차이다. 요구-모델은 '뭐 줄까?'와 같은 요구(질문)를 먼저 제시하고, 아동중심 시범은 아동의 관심사에 대해 시범을 보이며, 우발교수는 아동이 먼저 요구를 시작했을 때 이를 확장해 가르친다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"스크립트 중재의 절차로 옳은 것은?\",\"choices\":[\"친숙한 활동 순서를 먼저 확립한 뒤 계획된 위반(방해)을 도입하여 목표 발화를 유도한다\",\"첫 회기부터 예고 없이 활동 순서를 바꾸어 아동의 반응을 유도한다\",\"아동에게 낯선 활동을 선택하여 새로운 경험을 제공한다\",\"목표 언어는 스크립트의 하위 행동과 관계없이 삽입한다\",\"스크립트의 하위 행동은 하나로 제한한다\"],\"answer\":1,\"explain\":\"스크립트 중재는 생일잔치·마트놀이 등 친숙한 일상 활동의 순서를 먼저 익히게 하여 인지적 부담을 줄인 뒤, 각 하위 행동에 목표 언어를 배치하고 필요 시 순서를 빠뜨리거나 사물을 빼는 계획된 위반으로 발화를 유도한다. 낯선 활동이나 처음부터의 무작위 변형은 이 원리에 어긋난다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"수직적 목표 달성 전략에 관한 설명으로 옳은 것은?\",\"choices\":[\"여러 목표를 한 회기 안에서 동시에 지도한다\",\"일정 기간마다 여러 목표를 순환하며 번갈아 지도한다\",\"한 목표가 준거에 도달한 뒤 다음 목표로 넘어간다\",\"목표 도달 여부와 관계없이 매 회기 목표를 바꾼다\",\"아동이 선택한 목표만 지도한다\"],\"answer\":3,\"explain\":\"수직적 전략은 한 번에 하나의 목표를 집중 지도하여 준거에 도달한 후 다음 목표로 이동한다. ①은 수평적 전략, ③은 주기적 전략에 해당하며, ④·⑤는 목표 달성 전략에 해당하지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"장기목표: 연결어미가 포함된 복문을 사용하여 사건을 표현할 수 있다.\",\"q\":\"이 장기목표에 대한 단기목표로 가장 적절하게 기술된 것은?\",\"choices\":[\"구문 능력이 전반적으로 향상된다\",\"복문을 이해하고 사용한다\",\"치료사가 연결어미 '-고'를 시범 보인다\",\"그림카드 10장을 보고 연결어미 '-고'가 포함된 문장을 8회 이상 정확하게 말할 수 있다\",\"연결어미를 잘 사용할 수 있다\"],\"answer\":4,\"explain\":\"단기목표는 조건(그림카드 10장), 아동의 행동(연결어미 '-고' 문장 말하기), 준거(8회 이상)가 측정 가능하게 기술되어야 한다. ①·②·④는 준거가 없거나 장기목표 수준의 포괄적 진술이고, ③은 아동이 아닌 치료사의 행동을 기술한 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"언어 이전기·초기 언어기 아동의 목표 어휘 선정 원칙으로 옳은 것은?\",\"choices\":[\"아동이 이미 자발적으로 산출하는 낱말을 중심으로 선정한다\",\"추상적인 개념어를 우선 선정한다\",\"아동의 일상에서 자주 쓰이고 즉각적인 기능을 갖는 낱말을 우선한다\",\"발음이 어려운 낱말을 우선하여 조음 연습을 겸한다\",\"아동이 관심 없는 사물의 이름을 선정하여 새로운 흥미를 유도한다\"],\"answer\":3,\"explain\":\"초기 어휘는 아동의 관심과 일상에서 자주 접하고 요구·거부 등 의사소통 기능을 바로 수행할 수 있는 기능적 낱말이어야 습득과 일반화가 빠르다. 이미 산출하는 낱말은 목표가 아니며, 추상어·발음이 어려운 낱말·관심 없는 사물은 초기 목표로 부적절하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"보완대체의사소통(AAC) 상징체계에 관한 설명으로 옳은 것은?\",\"choices\":[\"블리스 상징은 도상성이 높아 학습이 쉽다\",\"수어는 도구적(보조) 상징체계이다\",\"도상성이 낮은 상징일수록 초기 학습이 쉽다\",\"실물 사진은 선화보다 도상성이 높아 초기 학습에 유리하다\",\"스캐닝은 상징의 도상성을 높이는 기법이다\"],\"answer\":4,\"explain\":\"도상성(iconicity)은 상징이 지시 대상과 닮은 정도로, 실물 사진 > 컬러 선화 > 흑백 선화 > 블리스·문자 순으로 낮아지며 도상성이 높을수록 초기 학습이 쉽다. 수어·몸짓은 도구가 필요 없는 비도구적 상징이고, 스캐닝은 상징을 선택하는 기법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"stem\":\"• 아동이 어려워하는 특정 사회적 상황(예: 줄 서기)을 짧고 구체적인 문장으로 서술한다.\\n• 그 상황에서 다른 사람이 어떻게 느끼고 무엇을 기대하는지, 아동이 할 수 있는 적절한 행동이 무엇인지를 아동의 관점에서 설명한다.\\n• 아동에게 맞게 개별화된 글이며 그림을 함께 제시하기도 한다.\",\"q\":\"이 설명에 해당하는 중재 기법은?\",\"choices\":[\"비디오 모델링\",\"사회적 상황 이야기(social story)\",\"사회적 기술 훈련 집단\",\"또래 매개 중재\",\"상호적 모방 훈련\"],\"answer\":2,\"explain\":\"사회적 상황 이야기는 자폐스펙트럼장애 아동이 사회적 상황의 단서와 타인의 관점, 기대되는 행동을 이해하도록 개별화된 짧은 이야기로 설명하는 기법이다. 비디오 모델링은 영상 속 모델을 관찰·모방하게 하는 것이고, 또래 매개 중재는 훈련된 또래가 상호작용을 이끄는 것이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"언어발달장애\",\"session\":2,\"q\":\"부모 교육 프로그램(예: 해넌 프로그램)에서 부모에게 강조하는 반응적 상호작용 전략으로 옳은 것은?\",\"choices\":[\"아동에게 질문을 많이 하여 발화를 유도한다\",\"아동의 발화 오류를 즉시 교정한다\",\"성인이 대화 주제를 정하고 이끌어 간다\",\"아동의 주도를 따르며 관찰하고 기다리고 들어준다\",\"아동에게 더 긴 문장으로 말하도록 요구한다\"],\"answer\":4,\"explain\":\"반응적 상호작용 접근은 아동의 관심과 주도를 따르고(관찰하기-기다리기-듣기), 아동의 신호에 즉각적이고 따뜻하게 반응하며 자연스러운 시범을 제공하는 것을 핵심으로 한다. 잦은 질문·즉각 교정·성인 주도·발화 요구는 아동의 의사소통 시도를 줄이는 지시적 상호작용이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 연골에 대한 설명으로 옳은 것은?\",\"choices\":[\"갑상연골은 좌우 한 쌍으로 이루어진 연골이다\",\"피열연골은 갑상연골의 앞쪽 내면과 관절을 이룬다\",\"윤상연골은 후두 연골 중 유일하게 완전한 고리 모양을 이룬다\",\"후두개는 유리연골로 성인기에 빠르게 골화된다\",\"설골은 후두 연골 중 가장 위에 위치한 연골이다\"],\"answer\":3,\"explain\":\"윤상연골은 뒤쪽이 넓은 반지 모양으로, 후두 연골 중 유일하게 기도를 완전히 둘러싸는 고리 형태이다. 갑상연골은 두 판이 앞에서 융합된 단일 연골이고, 피열연골은 윤상연골 위판(후방)에 얹혀 관절하며, 후두개는 탄력연골이라 골화가 잘 일어나지 않는다. 설골은 연골이 아닌 뼈로 후두를 매다는 구조이며 후두 연골에 포함되지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두 내근과 그 작용이 옳게 연결된 것은?\",\"choices\":[\"윤상갑상근 – 성대의 신장과 긴장 증가(음도 상승)\",\"측윤상피열근 – 성대 외전\",\"후윤상피열근 – 성대 내전\",\"갑상피열근 – 성문 개방\",\"횡피열근 – 성대의 신장\"],\"answer\":1,\"explain\":\"윤상갑상근은 갑상연골을 앞으로 기울여 성대를 길게 늘이고 긴장시켜 음도를 높이는 근육이다. 후윤상피열근은 유일한 외전근(성문 개방), 측윤상피열근과 횡·사피열근은 내전근이며, 갑상피열근(성대근)은 성대를 짧고 두껍게 하여 긴장을 조절한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두의 신경 지배에 대한 설명으로 옳은 것은?\",\"choices\":[\"상후두신경 외지는 후윤상피열근을 지배한다\",\"왼쪽 되돌이후두신경은 오른쪽보다 주행 경로가 짧다\",\"되돌이후두신경은 윤상갑상근만 지배한다\",\"상후두신경 내지는 성문 상부의 감각을 담당한다\",\"되돌이후두신경은 설인신경(9번)의 가지이다\"],\"answer\":4,\"explain\":\"상후두신경(미주신경 가지)의 내지는 감각 신경으로 성문 상부 점막의 감각을 담당하고, 외지는 운동 신경으로 윤상갑상근을 지배한다. 되돌이후두신경은 미주신경(10번)의 가지로 윤상갑상근을 제외한 모든 후두 내근을 지배하며, 왼쪽은 대동맥궁을 돌아 올라오므로 오른쪽보다 주행이 길어 손상에 더 취약하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대의 층 구조(몸체-덮개 모형)에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동은 몸체(body)인 성대근에서 주로 발생한다\",\"갑상피열근(성대근)은 덮개(cover)에 해당한다\",\"성대인대는 고유층 표층으로 이루어진다\",\"라인케 공간은 고유층 심층에 위치한다\",\"상피와 고유층 표층(라인케 공간)은 덮개(cover)에 해당한다\"],\"answer\":5,\"explain\":\"몸체-덮개 모형에서 덮개는 상피와 느슨한 고유층 표층(라인케 공간)으로 구성되어 점막파동이 일어나는 부위이며, 몸체는 성대근(갑상피열근)이다. 성대인대는 고유층 중간층과 심층으로 이루어진 이행부이다. 라인케 공간은 고유층 표층이며, 점막파동은 덮개에서 발생한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음성 강도를 높일 때 나타나는 생리적 변화로 옳은 것은?\",\"choices\":[\"성문하압이 감소한다\",\"진동 주기에서 성문 개방기가 길어지고 폐쇄기가 짧아진다\",\"성문하압이 증가하고 성대 폐쇄기가 길어진다\",\"성대 진동의 진폭이 작아진다\",\"성대 접촉이 느슨해져 성문을 통과하는 기류가 줄어든다\"],\"answer\":3,\"explain\":\"강도를 높이려면 성문하압을 높이고 성대를 더 단단히 접촉시켜 진동 주기 중 폐쇄기가 길어지도록 해야 한다. 이때 성대가 더 크게 열렸다 빠르게 닫히므로 진동 진폭도 커진다. 성문하압 감소, 개방기 연장, 진폭 감소는 오히려 강도를 낮추는 변화이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"45세 여성의 청지각적 평가(GRBAS) 결과\\nG2 R1 B2 A0 S0\",\"q\":\"결과 해석으로 옳은 것은?\",\"choices\":[\"전반적 중증도는 경도이다\",\"거친소리가 바람새는소리보다 더 두드러진다\",\"쥐어짜는소리가 중등도로 지각된다\",\"바람새는소리가 중등도로 지각된다\",\"무력성이 경도로 관찰된다\"],\"answer\":4,\"explain\":\"GRBAS는 각 항목을 0(정상)~3(심도)의 4점 척도로 평정한다. B2는 바람새는소리가 중등도라는 의미이며, G2이므로 전반적 중증도도 중등도이다. R1(경도)은 B2보다 덜 두드러지고, A0·S0은 무력성과 쥐어짜는소리가 관찰되지 않음을 뜻한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"CAPE-V(Consensus Auditory-Perceptual Evaluation of Voice)에 대한 설명으로 옳은 것은?\",\"choices\":[\"각 항목을 0~3점의 4점 등간척도로 평정한다\",\"전반적 중증도·거친소리·바람새는소리·쥐어짜는소리·음도·강도를 100mm 시각아날로그척도로 평정한다\",\"지속 모음 과제만으로 평가한다\",\"환자가 스스로 음성 문제의 심각도를 보고하는 도구이다\",\"각 항목의 점수는 음향 분석 소프트웨어가 자동으로 산출한다\"],\"answer\":2,\"explain\":\"CAPE-V는 평가자가 지속 모음, 표준 문장, 자발화를 듣고 6개 핵심 항목(전반적 중증도, 거친소리, 바람새는소리, 쥐어짜는소리, 음도, 강도)을 100mm 시각아날로그척도(VAS)로 표시하고, 각 특성이 지속적(C)인지 간헐적(I)인지도 기록하는 청지각적 평가이다. 4점 척도는 GRBAS의 방식이고, 자기보고 도구(VHI 등)나 음향 분석과는 다르다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"6세 남아\\n• 6개월 전부터 지속되는 쉰 목소리\\n• 음성 문제가 아동의 일상생활과 학교생활에 미치는 영향을 보호자 보고로 파악하려 함\",\"q\":\"가장 적절한 도구는?\",\"choices\":[\"음성장애지수(VHI-30)\",\"소아 음성장애지수(pVHI)\",\"음성피로도 검사(VFI)\",\"음성과 관련된 삶의 질(V-RQOL)\",\"GRBAS 척도\"],\"answer\":2,\"explain\":\"pVHI는 성인용 VHI를 아동에게 맞게 수정하여 부모(보호자)가 아동의 음성 문제가 기능·신체·정서 영역에 미치는 영향을 보고하는 도구이다. VHI-30, V-RQOL, VFI는 성인 환자 본인이 작성하는 자기보고 도구이고, GRBAS는 평가자의 청지각적 평정 척도이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"음향학적 변수에 대한 설명으로 옳게 연결된 것은?\",\"choices\":[\"주파수변동률(jitter) – 인접 주기 간 진폭의 변동\",\"진폭변동률(shimmer) – 인접 주기 간 기본주파수의 변동\",\"배음대소음비(HNR) – 값이 클수록 잡음 성분이 많음\",\"발화기본주파수(SFF) – 지속 모음에서 측정한 최고 음도\",\"기본주파수(F0) – 성대가 1초 동안 진동하는 횟수\"],\"answer\":5,\"explain\":\"기본주파수는 1초당 성대 진동 횟수(Hz)이다. jitter는 주기(주파수)의 단기 변동, shimmer는 진폭의 단기 변동으로 서로 바뀌어 있고, HNR은 값이 클수록 배음 성분이 많고 잡음이 적어 음질이 좋음을 뜻한다. 발화기본주파수는 연결발화에서의 평균 F0이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"38세 남성 교사\\n• 최근 3개월간 쉰 목소리\\n• 최대발성지속시간: /s/ 22초, /z/ 11초\",\"q\":\"s/z 비율 결과에 대한 해석으로 가장 적절한 것은?\",\"choices\":[\"s/z 비율이 2.0으로, 호흡 지지 부족이 주된 원인으로 추정된다\",\"s/z 비율이 2.0이므로 공명 문제를 우선 평가해야 한다\",\"s/z 비율이 0.5로 정상 범위이다\",\"s/z 비율이 2.0으로, 성대 병변에 의한 성문 폐쇄부전이 의심된다\",\"/s/와 /z/ 모두 정상보다 짧아 폐활량 저하가 의심된다\"],\"answer\":4,\"explain\":\"s/z 비율은 /s/ 지속시간을 /z/ 지속시간으로 나눈 값(22/11=2.0)이다. 무성음 /s/는 정상인데 유성음 /z/만 짧다면 호흡 능력은 보존되었으나 성대 진동 시 공기가 새는 것이므로 성대 병변(결절·폴립 등)에 의한 성문 폐쇄부전을 시사한다. 일반적으로 1.4 이상이면 성대 병리를 의심한다. 호흡 지지 부족이면 /s/와 /z/가 모두 짧아진다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"후두스트로보스코피 검사에 대한 설명으로 옳은 것은?\",\"choices\":[\"점막파동·진폭·성문폐쇄 양상·대칭성·주기성 등을 관찰한다\",\"기본주파수를 알 필요 없이 임의의 빛 주기로 촬영한다\",\"성대 진동의 실제 주기 하나하나를 그대로 보여준다\",\"심한 비주기적 음성일수록 정확한 영상을 얻을 수 있다\",\"성대 접촉 면적의 변화를 전기 신호로 기록한다\"],\"answer\":1,\"explain\":\"스트로보스코피는 성대 진동 주파수와 약간 다른 주기로 빛을 비추어 여러 주기의 조각을 합성한 느린 가상 영상을 만드는 검사로, 점막파동·진동 진폭·성문폐쇄 양상·좌우 대칭성·주기성·비진동 부위 등을 관찰한다. 기본주파수에 동기화해야 하므로 심하게 비주기적인 음성에서는 신뢰도가 떨어진다. 성대 접촉 면적을 전기 신호로 기록하는 것은 전기성문파형검사(EGG)이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"후두스트로보스코피 소견\\n• 양측 성대의 앞쪽 1/3과 중간 1/3 경계 부위에 좌우 대칭적인 작은 융기\\n• 융기 부위 앞뒤로 성문이 닫히지 않는 모래시계형 폐쇄 양상\",\"q\":\"가장 가능성이 높은 병변은?\",\"choices\":[\"편측 성대폴립\",\"양측 성대결절\",\"성대낭종\",\"라인케부종\",\"후두횡격막\"],\"answer\":2,\"explain\":\"성대결절은 음성 남용·오용으로 성대 진동 시 충격이 가장 큰 막성 성대 앞쪽 1/3~중간 1/3 경계에 양측 대칭으로 생기는 병변이며, 두 결절이 맞닿아 그 앞뒤가 열리는 모래시계형 폐쇄부전이 특징이다. 폴립은 대개 편측이고, 낭종은 편측 점막 내 병변이며, 라인케부종은 성대 전체가 붓고, 후두횡격막은 성대 전방이 막으로 붙은 상태이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"56세 여성\\n• 30년 이상 흡연\\n• 낮고 거칠고 굵은 목소리, 전화 통화 시 남성으로 오인됨\\n• 후두내시경: 양측 성대 전체가 물주머니처럼 부어 있음\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"성대결절\",\"접촉성 육아종\",\"후두유두종\",\"성대구증\",\"라인케부종\"],\"answer\":5,\"explain\":\"라인케부종은 장기 흡연이 주요 원인으로, 고유층 표층(라인케 공간)에 액체가 차서 양측 성대 전체가 미만성으로 부어 성대 질량이 늘고 음도가 현저히 낮아진다. 중년 여성에서 남성 목소리로 오인되는 것이 전형적이다. 성대결절은 국소적 양측 융기, 접촉성 육아종은 피열연골 성대돌기 부위 병변, 유두종은 사마귀 모양 종양, 성대구증은 성대 가장자리의 홈이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"재발성 호흡기 유두종증(후두유두종)에 대한 설명으로 옳은 것은?\",\"choices\":[\"음성치료만으로 병변을 소실시킬 수 있다\",\"주로 장기 흡연 성인 남성에게만 발생한다\",\"인유두종바이러스(HPV) 감염과 관련되며 제거 후에도 재발이 잦다\",\"양성 병변이므로 기도 폐쇄의 위험은 없다\",\"편측 성대 전방에만 국한되어 발생한다\"],\"answer\":3,\"explain\":\"후두유두종은 HPV(주로 6·11형) 감염으로 생기는 사마귀 모양의 양성 종양으로, 소아에서 흔하며 수술로 제거해도 재발이 잦다. 기도 여러 부위에 다발성으로 자랄 수 있어 특히 소아에서 기도 폐쇄 위험이 있다. 음성치료는 수술 후 음성 기능 회복을 돕는 보조적 역할이며 병변 자체를 없애지는 못한다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"내전형 경련성 발성장애의 특징으로 옳은 것은?\",\"choices\":[\"무성 자음에서 기식성 음성 끊김이 나타난다\",\"음성위생 교육이 일차적 치료법이다\",\"속삭이거나 웃을 때 증상이 더 심해진다\",\"심리적 갈등에서 비롯된 기능적 음성장애로 분류된다\",\"모음 산출 시 갑작스럽게 쥐어짜는 듯한 음성 끊김이 나타난다\"],\"answer\":5,\"explain\":\"내전형 경련성 발성장애는 국소 근긴장이상증으로, 발성 중 성대가 불수의적으로 과도하게 내전되어 모음에서 쥐어짜는 듯한 긴장성 음성 끊김이 나타난다. 무성 자음에서 성대가 벌어져 기식성 끊김이 생기는 것은 외전형이다. 속삭임·웃음·노래 등에서는 오히려 증상이 줄어드는 경우가 많고, 신경학적 음성장애로 분류되며 일차 치료는 보툴리눔 독소 주입이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"17세 남학생\\n• 변성기가 지났으나 여전히 높고 가는 목소리\\n• 기침을 하거나 웃을 때는 순간적으로 낮은 음성이 나옴\\n• 후두내시경: 후두 구조와 성대 운동 정상\",\"q\":\"가장 적절한 진단은?\",\"choices\":[\"편측 성대마비\",\"기능적 실성증\",\"내전형 경련성 발성장애\",\"성대구증\",\"변성발성장애(puberphonia)\"],\"answer\":5,\"explain\":\"변성발성장애는 후두가 정상적으로 성장했음에도 사춘기 이후에도 소년기의 높은 음도를 유지하는 기능적 음성장애이다. 기침·웃음 시 낮은 음성이 나오는 것은 생리적으로 저음 산출이 가능함을 뜻하며, 후두 하강·손가락 조작·기침 유도 등으로 비교적 빠르게 개선된다. 기능적 실성증은 음성이 전혀 나오지 않고, 성대구증과 성대마비는 내시경에서 이상 소견이 보인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"48세 남성\\n• 아침에 심한 쉰 목소리, 잦은 헛기침, 목 이물감, 가슴쓰림\\n• 후두내시경: 피열연골 부위 점막 발적·부종, 피열간 점막 비후\",\"q\":\"가장 가능성이 높은 진단은?\",\"choices\":[\"인후두역류질환(LPR)\",\"후두유두종\",\"변성발성장애\",\"급성 바이러스성 후두염\",\"성대낭종\"],\"answer\":1,\"explain\":\"위 내용물이 후두까지 올라오는 인후두역류는 아침 쉰 목소리, 헛기침, 목 이물감, 가슴쓰림을 흔히 동반하며 후두 후방(피열연골·피열간 부위)의 발적·부종·점막 비후가 특징적 소견이다. 급성 후두염은 감기 등에 뒤따르는 단기 증상이고, 유두종·낭종은 종괴성 병변, 변성발성장애는 후두 소견이 정상이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 소리가 비강이나 인두 뒤쪽에 갇혀 밖으로 잘 나오지 못하는 듯 답답하고 먹먹하게 들림\\n• 비강 앞쪽 폐쇄나 후방 인두 협착 시 나타날 수 있음\",\"q\":\"해당하는 공명 유형은?\",\"choices\":[\"과다비성\",\"과소비성\",\"맹관공명\",\"혼합 공명\",\"비강 난류\"],\"answer\":3,\"explain\":\"맹관공명(cul-de-sac resonance)은 소리가 막힌 공간에 갇혀 흡수되는 듯 답답하게 들리는 공명으로, 앞쪽 비강 폐쇄나 인두 협착, 혀의 후방 위치 등에서 나타난다. 과다비성은 모음에서 비강 공명이 과도한 것, 과소비성은 비음 /m, n/에서 비강 공명이 부족한 것, 비강 난류는 압력자음 산출 시 코로 공기가 새면서 들리는 소음이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"편측 성대마비로 성문 폐쇄가 불완전한 환자에게 성대 내전을 촉진하기 위해 적용하는 음성치료 기법은?\",\"choices\":[\"하품-한숨법\",\"저작하기\",\"속삭이기\",\"밀기 기법(pushing)\",\"후두 마사지\"],\"answer\":4,\"explain\":\"밀기 기법은 발성하면서 팔로 벽·의자를 밀거나 손을 맞잡아 당기는 등 힘을 주어 성대 내전을 반사적으로 강화하는 기법으로, 성대마비·성대 활 모양 등 저기능성(성문 폐쇄부전) 음성장애에 사용한다. 하품-한숨법, 저작하기, 후두 마사지는 과기능성 음성장애의 긴장을 낮추는 이완 기법이고, 속삭이기는 성대 접촉을 오히려 줄인다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"40세 여성 콜센터 상담원\\n• 근긴장성 발성장애(1형)로 진단됨\\n• 발성 시 목 앞쪽 근육이 단단하게 만져지고 후두가 높게 위치함\",\"q\":\"우선적으로 적용할 치료로 적절한 것은?\",\"choices\":[\"밀기 기법으로 성대 접촉을 강화한다\",\"리실버만 음성치료로 큰 소리 산출을 훈련한다\",\"후두 마사지와 하품-한숨법으로 후두 주변 긴장을 이완한다\",\"강한 성문파열음 시작으로 발성을 유도한다\",\"보툴리눔 독소를 갑상피열근에 주입한다\"],\"answer\":3,\"explain\":\"근긴장성 발성장애는 후두 외근·내근의 과도한 긴장으로 생기는 과기능성 음성장애이므로, 후두 마사지(후두 하강), 하품-한숨법, 저작하기 등 이완 중심 기법이 우선이다. 밀기 기법·강한 성문파열음·큰 소리 훈련은 성대 접촉과 긴장을 더 높여 부적절하고, 보툴리눔 독소 주입은 경련성 발성장애의 치료이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• /m/ 허밍으로 입술·안면 앞쪽의 진동감을 느끼게 함\\n• 성대가 살짝 벌어진 상태에서 최소한의 노력으로 최대의 공명을 얻도록 함\\n• 성대 충격 스트레스를 줄이는 것이 목표\",\"q\":\"해당하는 음성치료는?\",\"choices\":[\"리실버만 음성치료(LSVT LOUD)\",\"액센트 기법\",\"성대기능훈련(VFE)\",\"공명음성치료\",\"빨대발성\"],\"answer\":4,\"explain\":\"공명음성치료(Lessac-Madsen Resonant Voice Therapy)는 성대가 살짝 벌어진 상태에서 앞쪽 안면·입술의 진동감을 단서로 편안하고 울림 있는 음성을 산출하게 하여 성대 충격을 줄이면서도 강도를 확보하는 방법이다. LSVT는 큰 소리 산출 훈련, 액센트 기법은 복식호흡과 리듬 강세 훈련, 성대기능훈련은 4단계 성대 근육 운동, 빨대발성은 반폐쇄성도 기법이다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"성대기능훈련(Vocal Function Exercises)에 대한 설명으로 옳은 것은?\",\"choices\":[\"준비·신장·수축·내전력 강화의 4가지 훈련을 하루 2회, 각 2번씩 반복한다\",\"최대한 큰 소리로 밀어내며 발성하도록 한다\",\"속삭임으로 성대를 쉬게 하는 훈련이다\",\"음도 변화 없이 습관적 음도에서만 모음을 연장한다\",\"후두 마사지로 근육의 긴장을 낮추는 이완 기법이다\"],\"answer\":1,\"explain\":\"Stemple의 성대기능훈련은 ①준비운동(/i/ 연장), ②신장(저음→고음 활주), ③수축(고음→저음 활주), ④내전력 강화(여러 음도에서 /ol/ 연장)의 4가지를 부드럽고 작은 소리로 하루 2회, 각 2번씩 수행하는 생리적 접근이다. 큰 소리·속삭임·이완 마사지는 해당하지 않으며, 음도 활주가 핵심이므로 습관적 음도에서만 연장하는 것도 틀리다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"68세 남성, 파킨슨병\\n• 목소리가 작고 단조로우며 기식적임\\n• 본인은 자신의 목소리가 충분히 크다고 느낌\",\"q\":\"가장 적절한 음성치료는?\",\"choices\":[\"하품-한숨법\",\"리실버만 음성치료(LSVT LOUD)\",\"속삭이기\",\"공명음성치료\",\"흡기발성\"],\"answer\":2,\"explain\":\"LSVT LOUD는 파킨슨병 환자의 낮은 강도·단조로운 음성을 위해 개발된 집중 치료(주 4회, 4주)로, '크게 생각하기'를 통해 발성 노력을 높이고 자기 음성 크기에 대한 지각을 재조정한다. 하품-한숨법·공명음성치료는 과기능성 음성의 긴장을 낮추는 방법이며, 흡기발성은 가성대 발성·기능적 실성증에, 속삭이기는 강도를 더 낮추므로 부적절하다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"stem\":\"• 발성 시 진성대 대신 가성대(false vocal folds)가 진동함\\n• 낮고 거친 음질\",\"q\":\"진성대 발성을 유도하기 위해 사용할 수 있는 기법은?\",\"choices\":[\"흡기발성\",\"밀기 기법\",\"강한 성문파열음 시작\",\"큰 소리로 소리 지르기\",\"저음 유지 훈련\"],\"answer\":1,\"explain\":\"흡기발성은 숨을 들이마시면서 소리를 내는 방법으로, 흡기 시에는 가성대가 벌어지고 진성대만 진동하므로 가성대 발성이나 기능적 실성증 환자에게 진성대 발성을 되찾게 하는 데 유용하다. 밀기 기법·강한 성문파열음·소리 지르기는 성문 상부의 압축과 긴장을 더 높이고, 가성대 발성은 이미 낮은 음도이므로 저음 훈련은 목표와 맞지 않는다.\"},{\"grade\":2,\"set\":1,\"subject\":\"음성장애\",\"session\":1,\"q\":\"기관식도발성(TEP)에 대한 설명으로 옳은 것은?\",\"choices\":[\"전기후두처럼 외부 진동원을 목에 대어 소리를 낸다\",\"폐의 공기를 기관식도 천공 보철을 통해 식도로 보내 인두식도분절을 진동시킨다\",\"식도로 삼킨 공기를 역류시켜 발성하므로 발화 길이가 짧다\",\"후두 적출 없이 시행하는 성대 재건술이다\",\"발성을 위해 호흡과 무관하게 단어 단위로만 말한다\"],\"answer\":2,\"explain\":\"기관식도발성은 후두전적출 후 기관과 식도 사이에 만든 천공에 일방향 밸브 보철을 삽입하여, 기공을 막고 내쉰 폐의 공기를 식도로 보내 인두식도분절을 진동시키는 방법이다. 폐의 공기를 사용하므로 식도발성보다 발화 길이가 길고 강도가 크다. 외부 진동원을 쓰는 것은 전기후두, 삼킨 공기를 쓰는 것은 식도발성이다.\"}];\n</script>\n<script>\n// ═════════ 상태 ═════════\nlet Q = [];                  // 이번 시험 문항\nlet answers = [], checks = [], memos = [], strikes = [];\nlet page = 0, perPage = 1, filter = 'all', fontScale = 1;\nlet limitSec = 0, remainSec = 0, timerId = null, warned = false;\nlet memoTarget = -1, submitted = false, startedAt = null;\nlet hlStore = {}, penMode = 'off';   // 형광펜: 하이라이트 저장소 + 모드(off/on)\n\nconst $ = id => document.getElementById(id);\nconst show = id => $(id).classList.remove('hidden');\nconst hide = id => $(id).classList.add('hidden');\nconst circled = i => ['①','②','③','④','⑤'][i];\n\n// ═════════ 시작 화면 ═════════\n// 급수(1급/2급)별 시험 구조. 급수 → 회차(set) → 교시(session) 순으로 선택한다.\n// 문항 데이터에 존재하는 급수·회차만 버튼으로 노출하고, 1개뿐이면 그 선택 UI는 숨긴다.\n// 2급 실제 구조: 1교시 신경언어30·유창성25·음성25(80) / 2교시 언어발달35·조음음운35(70) = 150문항(현장실무 없음).\nconst GRADE_META = {\n  1: { title: '1급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·언어발달·유창성)', min: 75 },\n               2: { label: '2교시 (음성·조음음운·현장실무)', min: 70 } } },\n  2: { title: '2급 언어재활사 모의 CBT',\n       sess: { 1: { label: '1교시 (신경언어·유창성·음성)', min: 75 },\n               2: { label: '2교시 (언어발달·조음음운)', min: 70 } } },\n};\nlet chosenGrade = 1, chosenSet = 1, chosenSess = 1;\n\nconst qGrade = q => q.grade || 1;\nconst qSet   = q => q.set   || 1;\n// HIDDEN_SETS(questions.js)에 적힌 급수/회차는 앱에서 보이지 않게 한다(비공개 세트).\nconst isHidden = q => (window.HIDDEN_SETS || []).some(h => h.grade === qGrade(q) && h.set === qSet(q));\nconst VIS = () => QUESTIONS.filter(q => !isHidden(q));\nfunction availableGrades(){ return Array.from(new Set(VIS().map(qGrade))).sort((a,b)=>a-b); }\nfunction availableSets(g){ return Array.from(new Set(VIS().filter(q=>qGrade(q)===g).map(qSet))).sort((a,b)=>a-b); }\nfunction availableSessions(){ return [1,2].filter(s => VIS().some(q=>qGrade(q)===chosenGrade && qSet(q)===chosenSet && q.session===s)); }\nfunction gradeMeta(){ return GRADE_META[chosenGrade] || GRADE_META[1]; }\nfunction sessMeta(s){ return gradeMeta().sess[s] || { label: s+'교시', min: 70 }; }\n\nfunction poolFor(s){ return VIS().filter(q => q.session===s && qGrade(q)===chosenGrade && qSet(q)===chosenSet); }\nfunction minutesFor(s){ return sessMeta(s).min; }\n// 선택한 교시부터 진행, 끝나면 나머지 교시 이어풀기 — 존재하는 교시 기준으로 큐 구성.\nfunction sessionQueueFrom(s){ const av = availableSessions(); return s===av[0] ? av.slice() : av.slice().reverse(); }\nfunction setLabel(){ return availableSets(chosenGrade).length > 1 ? ` ${chosenSet}회차` : ''; }\nfunction examTitle(){ return gradeMeta().title; }\n\n// 급수·회차·교시 버튼을 데이터에 맞춰 다시 그린다.\nfunction renderStartSelectors(){\n  const grades = availableGrades();\n  if(!grades.includes(chosenGrade)) chosenGrade = grades[0] || 1;\n  const gRow=$('gradeRow'), gBox=$('gradeBtns');\n  if(grades.length <= 1){ if(gRow) gRow.style.display='none'; }\n  else if(gRow && gBox){\n    gRow.style.display='';\n    gBox.innerHTML = grades.map(g=>`<button class=\"sess-btn${g===chosenGrade?' active':''}\" data-grade=\"${g}\">${g}급</button>`).join(' ');\n    gBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{\n      chosenGrade=+b.dataset.grade; chosenSet=availableSets(chosenGrade)[0]||1; renderStartSelectors();\n    });\n  }\n  const sets = availableSets(chosenGrade);\n  if(!sets.includes(chosenSet)) chosenSet = sets[0] || 1;\n  const sRow=$('setRow'), sBox=$('setBtns');\n  if(sets.length <= 1){ if(sRow) sRow.style.display='none'; }\n  else if(sRow && sBox){\n    sRow.style.display='';\n    sBox.innerHTML = sets.map(s=>`<button class=\"sess-btn${s===chosenSet?' active':''}\" data-set=\"${s}\">${s}회차</button>`).join(' ');\n    sBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSet=+b.dataset.set; renderStartSelectors(); });\n  }\n  const av = availableSessions();\n  if(!av.includes(chosenSess)) chosenSess = av[0] || 1;\n  const seBox=$('sessBtns');\n  if(seBox){\n    seBox.innerHTML = av.map(s=>`<button class=\"sess-btn${s===chosenSess?' active':''}\" data-sess=\"${s}\">${sessMeta(s).label}</button>`).join(' ');\n    seBox.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chosenSess=+b.dataset.sess; renderStartSelectors(); });\n  }\n  updateStartInfo();\n}\nfunction updateStartInfo(){\n  const other = availableSessions().find(x=>x!==chosenSess);\n  $('stTitle').textContent = examTitle() + setLabel() + ` ${chosenSess}교시`;\n  const tail = other ? ` · 제출 후 ${other}교시 이어풀기 선택` : '';\n  $('stTime').textContent = `${poolFor(chosenSess).length}문항 / ${minutesFor(chosenSess)}분${tail}`;\n}\nfunction tickClock(){\n  const d = new Date();\n  const nd = $('nowDate'), nt = $('nowTime');\n  if(nd) nd.textContent = d.toLocaleDateString('ko-KR');\n  if(nt) nt.textContent = d.toLocaleTimeString('ko-KR', {hour12:false});\n}\nsetInterval(tickClock, 1000); tickClock();\n$('stDate').textContent = new Date().toLocaleDateString('ko-KR');\nrenderStartSelectors();\n\n// ═════════ 로그인 · 기기 바인딩 (베타) ═════════\n// 각 계정(slp01~)은 최초 로그인한 기기 1대에서만 사용 가능.\n// deviceId: 이 브라우저에 저장되는 임의 식별자. Firestore users/{uid}.device 와 일치해야 입장.\nconst EMAIL_DOMAIN = '@kcbt.test';           // slp01 → slp01@kcbt.test (실제로 발송되지 않는 가짜 도메인)\nlet fbAuth = null, fbDb = null, CURRENT_ID = null, loginInProgress = false;\n\nfunction getDeviceId(){\n  let d = localStorage.getItem('kcbt_device_id');\n  if(!d){\n    d = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()\n        : 'dev-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);\n    localStorage.setItem('kcbt_device_id', d);\n  }\n  return d;\n}\nfunction agShowErr(msg){ $('agErr').textContent = msg || ''; }\nfunction enterApp(id, extendedUntil){\n  CURRENT_ID = id;\n  hide('authGate'); show('startScreen');\n  // 설문 참여로 연장된 계정 → 접속 시 안내 팝업(브라우저 세션당 1회)\n  if(extendedUntil && !sessionStorage.getItem('kcbt_extend_notice_shown')){\n    const el = $('extendUntilText');\n    if(el) el.textContent = formatExtendDate(extendedUntil);\n    show('extendOverlay');\n    try{ sessionStorage.setItem('kcbt_extend_notice_shown', '1'); }catch(e){}\n  }\n}\nfunction formatExtendDate(s){\n  // '2026-09-30' → '2026년 9월 30일'\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s).trim());\n  return m ? `${m[1]}년 ${parseInt(m[2],10)}월 ${parseInt(m[3],10)}일` : String(s);\n}\nfunction showGate(){\n  hide('startScreen');\n  const g = $('authGate'); g.classList.remove('hidden');\n}\n\n// 설정이 비어있으면(로컬 개발) 로그인 건너뛰고 바로 시작화면\nconst _cfg = window.FIREBASE_CONFIG;\nif(!_cfg || !_cfg.apiKey || String(_cfg.apiKey).indexOf('PASTE') === 0){\n  console.warn('[kcbt] Firebase 설정 없음 — 로그인 없이 실행(로컬 개발 모드).');\n  enterApp('local');\n} else {\n  firebase.initializeApp(_cfg);\n  fbAuth = firebase.auth();\n  fbDb = firebase.firestore();\n\n  // 새로고침해도 로그인 유지 — 단, 기기 일치 재확인 후 입장\n  fbAuth.onAuthStateChanged(async (user) => {\n    if(loginInProgress) return;   // 대화형 로그인 진행 중엔 doLogin이 처리하므로 개입 안 함(레이스 방지)\n    if(!user){ showGate(); return; }\n    try{\n      const snap = await fbDb.collection('users').doc(user.uid).get();\n      const data = snap.exists ? snap.data() : null;\n      if(data && data.device && data.device === getDeviceId()){\n        enterApp(data.name || (user.email || '').split('@')[0], data.extendedUntil);\n      } else {\n        await fbAuth.signOut();   // 기기 불일치/미등록 → 로그아웃 후 게이트\n        showGate();\n      }\n    }catch(e){ console.error(e); await fbAuth.signOut(); showGate(); }\n  });\n}\n\nasync function doLogin(){\n  if(!fbAuth){ enterApp('local'); return; }         // 로컬 개발 모드\n  const id = ($('agId').value || '').trim().toLowerCase();\n  const pw = $('agPw').value || '';\n  if(!id || !pw){ agShowErr('아이디와 비밀번호를 입력해 주세요.'); return; }\n  const btn = $('agBtn'); btn.disabled = true; agShowErr('');\n  loginInProgress = true;   // onAuthStateChanged가 로그인 중 개입해 로그아웃시키는 레이스 방지\n  try{\n    const cred = await fbAuth.signInWithEmailAndPassword(id + EMAIL_DOMAIN, pw);\n    const uid = cred.user.uid;\n    const dev = getDeviceId();\n    const ref = fbDb.collection('users').doc(uid);\n    const snap = await ref.get();\n    if(!snap.exists){\n      await fbAuth.signOut();\n      agShowErr('등록되지 않은 계정입니다. 관리자에게 문의해 주세요.');\n      return;\n    }\n    const data = snap.data();\n    if(!data.device){\n      // 최초 로그인 → 이 기기를 등록(바인딩)\n      await ref.update({ device: dev, boundAt: firebase.firestore.FieldValue.serverTimestamp() });\n    } else if(data.device !== dev){\n      // 다른 기기에서 로그인 시도 → 차단\n      await fbAuth.signOut();\n      agShowErr('이미 다른 기기에 등록된 계정입니다.\\n기기 변경은 관리자에게 문의해 주세요.');\n      return;\n    }\n    enterApp(data.name || id, data.extendedUntil);\n  }catch(e){\n    console.error(e);\n    const code = e && e.code || '';\n    if(code === 'permission-denied'){\n      agShowErr('기기 등록에 실패했습니다. 관리자에게 문의해 주세요.');\n    } else if(code.indexOf('auth/user-disabled') >= 0){\n      agShowErr('베타 이용 기간이 종료되었습니다.\\n이용해 주셔서 감사합니다. 🌿');\n    } else if(code.indexOf('auth/too-many-requests') >= 0){\n      agShowErr('로그인 시도가 많습니다. 잠시 후 다시 시도해 주세요.');\n    } else {\n      agShowErr('아이디 또는 비밀번호가 올바르지 않습니다.');\n    }\n  }finally{\n    btn.disabled = false;\n    loginInProgress = false;\n  }\n}\n\nasync function doLogout(){\n  try{ if(fbAuth) await fbAuth.signOut(); }catch(e){}\n  $('agId').value = ''; $('agPw').value = ''; agShowErr('');\n  showGate();\n}\n\n// ═════════ 시험 시작 ═════════\n// 실제 시험 실행부(샘플·커스텀 공용). qArr: 문항배열, minutes: 제한시간, title: 헤더 표기\nfunction _launch(qArr, minutes, title){\n  Q = qArr;\n  if(!Q.length){ alert('시작할 문항이 없습니다.'); return false; }\n  answers = Array(Q.length).fill(0);\n  checks  = Array(Q.length).fill(false);\n  memos   = Array(Q.length).fill('');\n  strikes = Q.map(() => [false,false,false,false,false]);\n  page = 0; filter = 'all'; warned = false; submitted = false;\n  hlStore = {}; penMode = 'off'; $('paper').classList.remove('pen-on');\n  limitSec = remainSec = Math.max(1, minutes) * 60;\n  startedAt = new Date();\n  $('exName').textContent = $('inName').value || '이루다쌤';\n  $('exTitle').textContent = title;\n  $('limitMin').textContent = Math.round(limitSec/60);\n  hide('startScreen'); show('examScreen');\n  buildOMR(); render();\n  clearInterval(timerId);\n  timerId = setInterval(tickTimer, 1000); tickTimer();\n  return true;\n}\nlet sessQueue = [1], sessPos = 0, accQ = [], accAns = [], accUsedSec = 0, accLimitSec = 0;\nfunction startExam(){\n  sessQueue = sessionQueueFrom(chosenSess);\n  sessPos = 0; accQ = []; accAns = []; accUsedSec = 0; accLimitSec = 0;\n  launchCurrentSession();\n}\nfunction launchCurrentSession(){\n  const s = sessQueue[sessPos];\n  const p = poolFor(s);\n  if(!p.length){ alert('선택한 교시에 문항이 없습니다.'); return; }\n  _launch(p, minutesFor(s), examTitle() + setLabel() + ` ${s}교시`);\n}\nfunction startNextSession(){ hide('nextSessOverlay'); sessPos++; launchCurrentSession(); }   // 다음 교시로 진행\nfunction resultNow(){ hide('nextSessOverlay'); finishAll(); }                                 // 여기서 멈추고 결과\nfunction finishAll(){\n  Q = accQ; answers = accAns;\n  limitSec = accLimitSec; remainSec = accLimitSec - accUsedSec;   // 지금까지 합산 풀이시간\n  showResult();\n}\n// 한 교시 제출/종료 → 누적 후, 다음 교시가 있으면 [다음 교시 시작 / 결과 보기] 선택\nfunction finishSession(){\n  clearInterval(timerId);\n  accQ = accQ.concat(Q);\n  accAns = accAns.concat(answers);\n  accUsedSec += (limitSec - Math.max(0, remainSec));\n  accLimitSec += limitSec;\n  if(sessPos < sessQueue.length - 1){\n    const done = sessQueue[sessPos], next = sessQueue[sessPos+1];\n    $('nextSessMsg').innerHTML = `<b>${done}교시</b>가 종료되었습니다.<br>이어서 <b>${next}교시</b>(${minutesFor(next)}분)를 풀거나,<br>여기서 <b>${done}교시 결과</b>만 볼 수 있어요.`;\n    show('nextSessOverlay');\n  } else {\n    finishAll();\n  }\n}\nfunction tickTimer(){\n  remainSec--;\n  if(remainSec < 0){ clearInterval(timerId); autoSubmit(); return; }\n  const m = Math.floor(remainSec/60), s = remainSec%60;\n  $('remainTxt').textContent = `${m}분 ${String(s).padStart(2,'0')}초`;\n  if(!warned && remainSec <= 300 && limitSec > 300){ warned = true; show('warnOverlay'); }\n}\n\n// ═════════ 페이지 (시험지는 항상 전체 문제) ═════════\nfunction totalPages(){ return Math.max(1, Math.ceil(Q.length / perPage)); }\nfunction movePage(d){\n  const t = totalPages();\n  page = Math.min(t-1, Math.max(0, page+d));\n  render();\n}\nfunction jumpTo(qi){\n  page = Math.floor(qi / perPage);\n  render();\n}\n\n// ═════════ 렌더링 ═════════\nfunction render(){\n  const t = totalPages();\n  if(page >= t) page = t-1;\n  if(page < 0) page = 0;\n  const start = page*perPage;\n  const slice = Q.map((_,i)=>i).slice(start, start + perPage);\n  const grid = $('paperGrid');\n  grid.className = 'paper-grid' + (perPage===1 ? ' one' : '');\n  grid.style.fontSize = fontScale + 'em';\n  grid.innerHTML = slice.map(i => qcardHTML(i)).join('');\n  $('pageInfo').textContent = `${page+1}/${t}`;\n  updateCounts(); updateOMR(slice);\n  $('paper').scrollTop = 0;\n}\n\n// ═════════ 문제 보기 모달 (전체/체크/안푼) ═════════\nlet viewerMode = 'all';\nfunction viewerIdx(mode){\n  if(mode==='chk') return Q.map((_,i)=>i).filter(i=>checks[i]);\n  if(mode==='un')  return Q.map((_,i)=>i).filter(i=>!answers[i]);\n  return Q.map((_,i)=>i);\n}\nfunction openProblemViewer(mode){\n  viewerMode = mode;\n  renderViewer();\n  show('viewerOverlay');\n}\nfunction switchViewerTab(mode){ viewerMode = mode; renderViewer(); }\nfunction renderViewer(){\n  $('vtAll').textContent = `전체문제 (${Q.length})`;\n  $('vtChk').textContent = `체크문제 (${checks.filter(Boolean).length})`;\n  $('vtUn').textContent  = `안푼문제 (${answers.filter(a=>!a).length})`;\n  ['vtAll','vtChk','vtUn'].forEach(id=>$(id).classList.remove('active'));\n  $(viewerMode==='all'?'vtAll':viewerMode==='chk'?'vtChk':'vtUn').classList.add('active');\n  const idxs = viewerIdx(viewerMode);\n  const body = $('viewerBody');\n  body.innerHTML = idxs.length\n    ? idxs.map(i => viewerCard(i)).join('')\n    : '<div style=\"padding:60px;text-align:center;color:#68738a;grid-column:1/-1;\">해당하는 문제가 없습니다.</div>';\n  body.scrollTop = 0;\n}\nfunction viewerCard(i){\n  const q = Q[i];\n  return `<div class=\"v-card\" ondblclick=\"viewerJump(${i})\" title=\"더블클릭하면 이 문제로 이동합니다\">\n    <div class=\"v-head\"><span class=\"v-no\">${i+1}</span><span style=\"flex:1\">${esc(q.q)}</span></div>\n    ${q.stem ? `<div class=\"v-stem\">${esc(q.stem)}</div>` : ''}\n    <ul class=\"v-choices\">\n      ${q.choices.map((c,ci)=>`<li class=\"${answers[i]===ci+1?'sel':''}\">${circled(ci)} ${esc(c)}</li>`).join('')}\n    </ul>\n  </div>`;\n}\nfunction viewerJump(i){ hide('viewerOverlay'); jumpTo(i); }\nfunction esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nfunction qcardHTML(i){\n  const q = Q[i];\n  return `<div class=\"qcol\"><div class=\"qcard\" data-qi=\"${i}\">\n    <div class=\"qtools\">\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${checks[i]?'on':''}\" onclick=\"toggleCheck(${i})\">&#10003; 체크문제</button>\n        <button class=\"tool-btn ${memos[i]?'memo-on':''}\" onclick=\"openMemo(${i})\">&#9998; 메모</button>\n      </div>\n      <div class=\"qtools-row\">\n        <button class=\"tool-btn ${penMode==='on'?'pen-on':''}\" onclick=\"togglePen()\">&#128396; 형광펜 ${penMode==='on'?'켜짐':'꺼짐'}</button>\n        <button class=\"tool-btn\" onclick=\"clearHighlights(${i})\">&#9003; 형광펜 지우기</button>\n      </div>\n    </div>\n    <div class=\"qhead\"><span>${i+1}.</span><span style=\"flex:1\" data-hl=\"${i}-q\">${hlHTML(i,'q',q.q)}</span><span class=\"subj\">${esc(q.subject)}</span></div>\n    ${q.stem ? `<div class=\"stem\" data-hl=\"${i}-s\">${hlHTML(i,'s',q.stem)}</div>` : ''}\n    ${q.image ? `<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\"></div>` : ''}\n    <ul class=\"choices\">\n      ${q.choices.map((c,ci)=>`\n        <li class=\"${answers[i]===ci+1?'sel':''} ${strikes[i][ci]?'strike':''}\">\n          <span class=\"num\">${ci+1}</span>\n          <span class=\"ctext\" data-hl=\"${i}-c${ci}\">${hlHTML(i,'c'+ci,c)}</span>\n          <button class=\"strike-btn ${strikes[i][ci]?'on':''}\" onclick=\"toggleStrike(${i},${ci})\">오답</button>\n        </li>`).join('')}\n    </ul>\n  </div></div>`;\n}\nfunction updateCounts(){\n  $('cntAll').textContent = Q.length;\n  $('cntChk').textContent = checks.filter(Boolean).length;\n  $('cntUn').textContent = answers.filter(a=>!a).length;\n}\n\n// ═════════ OMR ═════════\nfunction buildOMR(){\n  // OMR 패널 제거됨 — 남아있는 경우에만 렌더(호환용)\n  const list = $('omrList'); if(!list) return;\n  list.innerHTML = Q.map((_,i)=>`\n    <div class=\"omr-row ${(i+1)%5===0?'sep':''}\" id=\"omr${i}\">\n      <span class=\"flags\" id=\"flag${i}\"></span>\n      <span class=\"no\" onclick=\"jumpTo(${i})\">${String(i+1).padStart(2,'0')}</span>\n      <span class=\"bubbles\">${[1,2,3,4,5].map(n=>`<button class=\"bub\" onclick=\"pick(${i},${n})\">${circled(n-1)}</button>`).join('')}</span>\n    </div>`).join('');\n}\nfunction updateOMR(visible){\n  // 진행바 갱신(푼 문항 수 기준)\n  const total = Q.length, done = answers.filter(a=>a>0).length;\n  const pb = $('progBar'), pt = $('progText');\n  if(pb) pb.style.width = (total ? done/total*100 : 0) + '%';\n  if(pt) pt.textContent = `${done} / ${total} 문항 풀이`;\n  // OMR 패널이 남아있으면 함께 갱신(호환용)\n  if(!$('omrList')) return;\n  Q.forEach((_,i)=>{\n    const row = $('omr'+i); if(!row) return;\n    row.classList.toggle('cur', visible.includes(i));\n    row.querySelectorAll('.bub').forEach((b,bi)=>b.classList.toggle('mark', answers[i]===bi+1));\n    $('flag'+i).innerHTML = (checks[i]?'<span class=\"chk\">&#10003;</span>':'') + (memos[i]?'<span>&#9998;</span>':'');\n  });\n}\nfunction goHome(){\n  if(!confirm('처음(입장) 화면으로 돌아갈까요?\\n지금까지 푼 답안은 저장되지 않습니다.')) return;\n  clearInterval(timerId);\n  hide('examScreen'); hide('resultScreen'); show('startScreen');\n}\n\n// ═════════ 상호작용 ═════════\nfunction pick(i,n){\n  answers[i] = (answers[i]===n) ? 0 : n;\n  render();\n}\nfunction toggleStrike(i,ci){ strikes[i][ci] = !strikes[i][ci]; render(); }\nfunction toggleCheck(i){ checks[i] = !checks[i]; render(); }\n\n// 글자 크기 / 화면 배치\ndocument.querySelectorAll('.fbtn').forEach(b=>b.onclick=()=>{\n  document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('active'));\n  b.classList.add('active'); fontScale = +b.dataset.fs; render();\n});\n$('lay1').onclick = ()=>{ perPage=1; $('lay1').classList.add('active'); $('lay2').classList.remove('active'); page=0; render(); };\n$('lay2').onclick = ()=>{ perPage=2; $('lay2').classList.add('active'); $('lay1').classList.remove('active'); page=0; render(); };\n\n// ═════════ 형광펜 ═════════\n// 하이라이트는 문항별(data-hl 키)로 innerHTML을 저장해 페이지 이동·재렌더 후에도 유지된다.\nfunction hlHTML(i, part, text){\n  const k = i + '-' + part;\n  return hlStore[k] !== undefined ? hlStore[k] : esc(text);\n}\nfunction togglePen(){\n  penMode = penMode==='on' ? 'off' : 'on';\n  $('paper').classList.toggle('pen-on', penMode==='on');\n  const sel = window.getSelection && window.getSelection();\n  if(sel) sel.removeAllRanges();\n  render();   // 문제 카드의 형광펜 버튼 상태(켜짐/꺼짐) 갱신\n}\nfunction hlContainerOf(node){\n  while(node){\n    if(node.nodeType===1 && node.dataset && node.dataset.hl!==undefined) return node;\n    node = node.parentNode;\n  }\n  return null;\n}\nfunction saveHl(c){ if(c) hlStore[c.dataset.hl] = c.innerHTML; }\nfunction clearHighlights(i){   // 해당 문항의 모든 형광펜 하이라이트 제거\n  ['q','s','c0','c1','c2','c3','c4'].forEach(p => delete hlStore[i+'-'+p]);\n  render();\n}\nfunction onPaperMouseUp(){\n  if(penMode!=='on') return;\n  const sel = window.getSelection();\n  if(!sel || sel.isCollapsed || !String(sel).trim()) return;\n  const range = sel.getRangeAt(0);\n  const startC = hlContainerOf(range.startContainer);\n  const endC = hlContainerOf(range.endContainer);\n  if(!startC || startC !== endC){ sel.removeAllRanges(); return; }   // 한 영역 안에서만 허용\n  const mark = document.createElement('mark');\n  mark.className = 'hl';\n  try{ range.surroundContents(mark); }\n  catch(_){ try{ mark.appendChild(range.extractContents()); range.insertNode(mark); }\n            catch(e){ sel.removeAllRanges(); return; } }\n  saveHl(startC);\n  sel.removeAllRanges();\n}\nfunction onPaperClick(e){\n  const mark = e.target.closest ? e.target.closest('mark.hl') : null;\n  if(penMode==='on' && mark){                       // 형광펜 모드에서 하이라이트 클릭 → 지우기\n    const cont = hlContainerOf(mark), parent = mark.parentNode;\n    while(mark.firstChild) parent.insertBefore(mark.firstChild, mark);\n    parent.removeChild(mark); parent.normalize();\n    saveHl(cont);\n    return;\n  }\n  if(window.getSelection && String(window.getSelection()).trim()) return;  // 드래그 선택 중이면 클릭 무시\n  const ct = e.target.closest ? e.target.closest('.ctext') : null;         // 보기 텍스트 클릭 → 답 선택\n  if(ct){\n    const li = ct.closest('li');\n    const ci = [...li.parentNode.children].indexOf(li);\n    const qi = +li.closest('.qcard').dataset.qi;\n    pick(qi, ci+1);\n  }\n}\n$('paper').addEventListener('mouseup', onPaperMouseUp);\n$('paper').addEventListener('click', onPaperClick);\n\n// ═════════ 메모 ═════════\nfunction openMemo(i){\n  memoTarget = i;\n  $('memoTitle').textContent = `${i+1}번 문제 메모`;\n  $('memoText').value = memos[i];\n  show('memoWin'); $('memoText').focus();\n}\nfunction closeMemo(){\n  if(memoTarget>=0) memos[memoTarget] = $('memoText').value.trim();\n  memoTarget = -1; hide('memoWin'); render();\n}\n\n// ═════════ 계산기 ═════════\nfunction toggleCalc(){ $('calcWin').classList.toggle('hidden'); }\nfunction calcIn(v){ const d=$('calcDisp'); d.value = d.value==='0'&&!'+-*/.'.includes(v) ? v : d.value+v; }\nfunction calcClear(){ $('calcDisp').value='0'; }\nfunction calcBack(){ const d=$('calcDisp'); d.value=d.value.slice(0,-1)||'0'; }\nfunction calcEq(){\n  const d=$('calcDisp');\n  if(!/^[\\d+\\-*/.() ]+$/.test(d.value)) return;\n  try{ d.value = String(Function('\"use strict\";return ('+d.value+')')()); }catch(e){ d.value='오류'; }\n}\n\n// ═════════ 그림판 ═════════\nconst pc = $('padCanvas'), pctx = pc.getContext('2d');\nlet padMode='pen', drawing=false;\nfunction togglePad(){ $('padWin').classList.toggle('hidden'); }\nfunction setPadMode(m){ padMode=m; $('penBtn').classList.toggle('on',m==='pen'); $('eraserBtn').classList.toggle('on',m==='eraser'); }\nfunction clearPad(){ pctx.clearRect(0,0,pc.width,pc.height); }\npc.addEventListener('mousedown',e=>{ drawing=true; pctx.beginPath(); pctx.moveTo(e.offsetX,e.offsetY); });\npc.addEventListener('mousemove',e=>{\n  if(!drawing) return;\n  pctx.lineWidth = padMode==='pen'?2:18;\n  pctx.strokeStyle='#1f3358';\n  pctx.globalCompositeOperation = padMode==='pen'?'source-over':'destination-out';\n  pctx.lineTo(e.offsetX,e.offsetY); pctx.stroke();\n});\n['mouseup','mouseleave'].forEach(ev=>pc.addEventListener(ev,()=>drawing=false));\n\n// 플로팅 창 드래그\ndocument.querySelectorAll('[data-drag]').forEach(h=>{\n  h.addEventListener('mousedown',e=>{\n    if(e.target.tagName==='BUTTON') return;\n    const win=$(h.dataset.drag), r=win.getBoundingClientRect();\n    const ox=e.clientX-r.left, oy=e.clientY-r.top;\n    win.style.left=r.left+'px'; win.style.top=r.top+'px'; win.style.right='auto'; win.style.bottom='auto';\n    const mv=ev=>{ win.style.left=(ev.clientX-ox)+'px'; win.style.top=(ev.clientY-oy)+'px'; };\n    const up=()=>{ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); };\n    document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);\n  });\n});\n\n// ═════════ 제출 ═════════\nfunction askSubmit(){\n  const un = answers.filter(a=>!a).length;\n  const isLast = sessPos >= sessQueue.length - 1;\n  const tail = isLast ? '답안을 제출하시겠습니까?'\n                      : `${sessQueue[sessPos]}교시 답안을 제출할까요?`;\n  $('submitMsg').innerHTML = un\n    ? `안 푼 문제가 <b style=\"color:var(--red)\">${un}개</b> 있습니다.<br>${tail}<br><small style=\"color:#68738a\">제출 후에는 수정할 수 없습니다.</small>`\n    : `모든 문제에 답하였습니다.<br>${tail}`;\n  show('submitOverlay');\n}\nfunction autoSubmit(){\n  if(submitted) return; submitted=true; clearInterval(timerId); hide('warnOverlay');\n  const isLast = sessPos >= sessQueue.length - 1;\n  const btn = $('timeoverBtn'); if(btn) btn.textContent = isLast ? '결과 확인' : '확인';\n  const msg = $('timeoverMsg'); if(msg) msg.innerHTML = isLast\n    ? '시험 시간이 종료되어<br>답안이 자동 제출되었습니다.'\n    : `${sessQueue[sessPos]}교시 시간이 종료되어<br>답안이 자동 제출되었습니다.`;\n  show('timeoverOverlay');\n}\nfunction doSubmit(){ submitted=true; clearInterval(timerId); hide('submitOverlay'); finishSession(); }\n\n// ═════════ 결과 ═════════\nfunction showResult(){\n  clearInterval(timerId);\n  hide('examScreen'); closeMemo(); hide('calcWin'); hide('padWin'); show('resultScreen');\n  const graded = q => q.answer>=1 && q.answer<=5;   // 정답이 지정된 채점 가능 문항\n  const bySub = {};\n  Q.forEach((q,i)=>{\n    if(!graded(q)) return;                            // 정답 미설정 → 채점 제외\n    if(!bySub[q.subject]) bySub[q.subject]={n:0,ok:0};\n    bySub[q.subject].n++;\n    if(answers[i]===q.answer) bySub[q.subject].ok++;\n  });\n  const totalN = Q.filter(graded).length;\n  const totalOk = Q.reduce((s,q,i)=>s+((graded(q)&&answers[i]===q.answer)?1:0),0);\n  const usedSec = limitSec - Math.max(0, remainSec);\n  const timeLine = `풀이 시간: ${Math.floor(usedSec/60)}분 ${usedSec%60}초 / 제한 ${Math.round(limitSec/60)}분`;\n\n  if(totalN === 0){   // 방어용: 채점 가능한 문항이 없을 때\n    $('scoreTable').innerHTML =\n      `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>\n       <tr class=\"total\"><td>총계</td><td>${Q.length}</td><td>-</td><td>채점 제외</td></tr>`;\n    $('verdict').textContent = '풀이를 마쳤어요 ✅';\n    $('verdict').className = 'verdict pass';\n    document.querySelector('.verdict-sub').innerHTML =\n      `이 세트는 정답이 지정된 문항이 없어 채점을 생략했어요. 아래에서 내가 고른 답을 확인해 보세요.<br>${timeLine}`;\n    setReviewFilter('all');\n    return;\n  }\n\n  let anyFail = false;\n  let rows = Object.entries(bySub).map(([s,v])=>{\n    const pct = Math.round(v.ok/v.n*100);\n    const bad = pct < 40; if(bad) anyFail = true;\n    return `<tr><td>${s}</td><td>${v.n}</td><td>${v.ok}</td><td class=\"${bad?'bad':''}\">${pct}%${bad?' (과락)':''}</td></tr>`;\n  }).join('');\n  const totalPct = Math.round(totalOk/totalN*100);\n  const pass = totalPct >= 60 && !anyFail;\n  $('scoreTable').innerHTML =\n    `<tr><th>과목</th><th>문항 수</th><th>정답 수</th><th>정답률</th></tr>${rows}\n     <tr class=\"total\"><td>총계</td><td>${totalN}</td><td>${totalOk}</td><td class=\"${totalPct<60?'bad':''}\">${totalPct}%</td></tr>`;\n  $('verdict').textContent = pass ? '합격권입니다! 🎉' : '아쉽지만 불합격권입니다';\n  $('verdict').className = 'verdict ' + (pass?'pass':'fail');\n  document.querySelector('.verdict-sub').innerHTML =\n    `합격 기준: 전 과목 총점의 60% 이상 &amp; 매 과목 40% 이상 (실제 필기시험 기준)<br>${timeLine}`;\n  setReviewFilter('wrong');\n}\nfunction savePDF(mode){\n  // mode: 'wrong'(틀린 문제 해설) | 'all'(전체 문항 해설). 인쇄 시 오답풀이 영역만 출력됨\n  mode = (mode === 'all') ? 'all' : 'wrong';\n  setReviewFilter(mode);\n  const name = ($('exName') && $('exName').textContent) || '이루다쌤';\n  const title = ($('exTitle') && $('exTitle').textContent) || (typeof EXAM_TITLE !== 'undefined' ? EXAM_TITLE : '언어재활사 CBT 연습');\n  const label = (mode === 'all') ? '전체 해설' : '오답풀이';\n  document.querySelector('#printHeader h1').textContent = `${title} — ${label}`;\n  $('printMeta').textContent = `${name} · ${new Date().toLocaleDateString('ko-KR')}`;\n  setTimeout(() => window.print(), 100);\n}\nfunction setReviewFilter(mode){\n  const area = $('reviewArea');\n  const graded = q => q.answer>=1 && q.answer<=5;\n  const items = Q.map((q,i)=>({q,i})).filter(({q,i}) => mode==='all' || (graded(q) && answers[i]!==q.answer));\n  if(!items.length){\n    area.innerHTML = '<div class=\"rv-card\" style=\"text-align:center;color:#1a7f37;font-weight:700;\">틀린 문제가 없습니다! 완벽해요 👏</div>';\n    return;\n  }\n  area.innerHTML = `<div style=\"text-align:center;color:#68738a;margin-bottom:12px;font-size:14px;\">${mode==='all'?'전체':'틀린'} 문제 해설 (${items.length}문항)</div>` +\n    items.map(({q,i})=>{\n      const my = answers[i], g = graded(q);\n      const badge = !g ? '<span class=\"rv-badge skip\">정답 미설정</span>'\n                  : !my ? '<span class=\"rv-badge skip\">안 품</span>'\n                  : my===q.answer ? '<span class=\"rv-badge ok\">정답</span>'\n                  : '<span class=\"rv-badge no\">오답</span>';\n      return `<div class=\"rv-card\">\n        <div class=\"rv-head\">${badge}<b>${i+1}.</b> ${esc(q.q)} <span class=\"subj\" style=\"font-size:12px;color:#33518e;\">[${esc(q.subject)}]</span></div>\n        ${q.stem?`<div class=\"rv-stem\">${esc(q.stem)}</div>`:''}\n        ${q.image?`<div class=\"qimg-wrap\"><img class=\"qimg\" src=\"${esc(q.image)}\" alt=\"문항 자료 이미지\"></div>`:''}\n        <ul class=\"rv-choices\">\n          ${q.choices.map((c,ci)=>{\n            const cls = [g&&ci+1===q.answer?'correct':'', my===ci+1?('mine'+(g&&my!==q.answer?' wrong':'')):''].join(' ');\n            return `<li class=\"${cls}\">${circled(ci)} ${esc(c)}${g&&ci+1===q.answer?' ✔':''}${g&&my===ci+1&&my!==q.answer?' ← 내 답':''}${!g&&my===ci+1?' ← 내 답':''}</li>`;\n          }).join('')}\n        </ul>\n        ${q.explain?`<div class=\"rv-explain\"><b>해설</b> · ${esc(q.explain)}</div>`:''}\n      </div>`;\n    }).join('');\n  window.scrollTo(0,0);\n}\n\n</script>\n</body>\n</html>\n"